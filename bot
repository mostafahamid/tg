    chat_id: chatId,
    text: `⭐️ <b>مدیریت سیستم VIP</b>\n\n📊 وضعیت: ${vipEnabled ? "✅ فعال" : "❌ غیرفعال"}\n🎁 دعوت لازم برای VIP: ${threshold} نفر\n📦 کانفیگ‌های VIP: ${vipConfigs.length} عدد`,
    parse_mode: "HTML",
    reply_markup: {
      inline_keyboard: [
        [{ text: vipEnabled ? "❌ غیرفعال کردن VIP" : "✅ فعال کردن VIP", callback_data: "toggle_vip_system" }],
        [{ text: "🔢 تغییر تعداد دعوت لازم", callback_data: "change_vip_threshold" }],
        [{ text: "👤 مدیریت VIP کاربر", callback_data: "vip_manage_user" }],
        [{ text: "➕ افزودن کانفیگ VIP", callback_data: "add_vip_config" }],
        [{ text: "🗑 پاکسازی کانفیگ‌های VIP", callback_data: "clear_vip_configs" }],
        [{ text: "🔙 بازگشت به پنل", callback_data: "back_to_admin_panel" }]
      ]
    }
  });
}


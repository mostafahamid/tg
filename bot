async function sendMessagesPage(env, BOT_TOKEN, chatId, page, perPage) {
  const messages = JSON.parse(await env.DATA_KV.get("admin_messages") || "[]");
  if (messages.length === 0) {
    await sendTelegram(BOT_TOKEN, "sendMessage", { chat_id: chatId, text: "📭 هیچ پیامی وجود ندارد." });
    return;
  }
  if (page === 0) {
    const updated = messages.map(m => ({ ...m, read: true }));
    await env.DATA_KV.put("admin_messages", JSON.stringify(updated));
  }
  const totalPages = Math.ceil(messages.length / perPage);
  const start = page * perPage;
  const pageMessages = messages.slice(start, start + perPage);
  for (let i = 0; i < pageMessages.length; i++) {
    const msgItem = pageMessages[i];
    let msgText = `📩 <b>پیام ${start + i + 1} از ${messages.length}</b>\n\n`;
    msgText += `👤 کاربر: <code>${msgItem.userId}</code>\n`;
    if (msgItem.username) msgText += `🆔 @${msgItem.username}\n`;
    if (msgItem.text) msgText += `📝 ${msgItem.text}\n`;
    if (msgItem.hasMedia) msgText += `📎 دارای فایل/تصویر\n`;
    msgText += `📅 ${msgItem.datePersian || new Date(msgItem.date).toLocaleString('fa-IR')}`;
    await sendTelegram(BOT_TOKEN, "sendMessage", {
      chat_id: chatId, text: msgText, parse_mode: "HTML",
      reply_markup: { inline_keyboard: [[{ text: "↩️ پاسخ به این کاربر", callback_data: `reply_msg_${msgItem.userId}` }]] }
    });
  }
  if (totalPages > 1) {
    const navButtons = [];
    if (page > 0) navButtons.push({ text: "⬅️ قبلی", callback_data: `msgs_page_${page - 1}` });
    navButtons.push({ text: `${page + 1} / ${totalPages}`, callback_data: "noop" });
    if (page < totalPages - 1) navButtons.push({ text: "بعدی ➡️", callback_data: `msgs_page_${page + 1}` });
    await sendTelegram(BOT_TOKEN, "sendMessage", {
      chat_id: chatId, text: `📄 صفحه ${page + 1} از ${totalPages}`,
      reply_markup: { inline_keyboard: [navButtons] }
    });
  }
}

async function clearAdminState(env, ADMIN_ID) {
  await env.DATA_KV.delete(`admin_state_${ADMIN_ID}`);
  await env.DATA_KV.delete(`reply_target_${ADMIN_ID}`);
}


var v=faDigits(value).trim().replace(/[.\-]/g,'/'),m=v.match(/^(\d{4})\/(\d{1,2})\/(\d{1,2})$/);
if(!v)return '';
if(!m)throw Error('تاریخ را به شکل ۱۴۰۵/۰۸/۱۳ وارد کن.');
var jy=+m[1],jm=+m[2],jd=+m[3];
if(jy<1300||jy>1500||jm<1||jm>12||jd<1||jd>(jm<=6?31:(jm<=11?30:30)))throw Error('تاریخ شمسی معتبر نیست.');
var g=jalaliToGregorianClient(jy,jm,jd),back=gregorianToJalali(g[0],g[1],g[2]);

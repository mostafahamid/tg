async function showForceJoinMenu(env, BOT_TOKEN, chatId) {
  const currentChannels = JSON.parse(await env.DATA_KV.get("required_channels") || "[]");
  const isEnabled = await env.DATA_KV.get("force_join_enabled") !== "false";
  const channelsText = currentChannels.length === 0
    ? "❌ هیچ کانالی تنظیم نشده"
    : currentChannels.map((ch, idx) => `${idx + 1}. ${ch}`).join('\n');
  await sendTelegram(BOT_TOKEN, "sendMessage", {
    chat_id: chatId,
    text: `🔘 <b>تنظیمات عضویت اجباری</b>\n\n📊 وضعیت: ${isEnabled ? "✅ فعال" : "❌ غیرفعال"}\n\n📢 <b>کانال‌های فعال:</b>\n${channelsText}\n\n⚠️ ربات باید در کانال‌ها ادمین باشد!`,
    parse_mode: "HTML",
    reply_markup: {
      inline_keyboard: [
        [{ text: "➕ افزودن کانال جدید", callback_data: "add_channel" }],
        [{ text: "❌ حذف کانال", callback_data: "remove_channel" }],
        [{ text: isEnabled ? "❌ غیرفعال کردن عضویت اجباری" : "✅ فعال کردن عضویت اجباری", callback_data: "toggle_force_join" }],
        [{ text: "🔙 بازگشت به پنل", callback_data: "back_to_admin_panel" }]
      ]
    }
  });
}

async function addUser(env, userId) {
  let users = JSON.parse(await env.DATA_KV.get("users") || "[]");
  if (!users.includes(userId)) {
    users.push(userId);
    await env.DATA_KV.put("users", JSON.stringify(users));
    return true;
  }
  return false;
}

function isValidConfigFormat(configStr) {
  const trimmed = configStr.trim();
  if (trimmed.startsWith("vmess://")) {
    try { Buffer.from(trimmed.replace("vmess://", ""), 'base64').toString('utf-8'); return true; }
    catch { return false; }
  }
  if (trimmed.startsWith("vless://")) return trimmed.length > 50;
  if (trimmed.startsWith("trojan://")) return trimmed.length > 50;
  if (trimmed.startsWith("ss://")) return trimmed.length > 30;
  return false;
}

async function sendTelegram(token, method, body) {
  return fetch(`https://api.telegram.org/bot${token}/${method}`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body)
  });
}

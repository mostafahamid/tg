function fmt(k){
 var t=$('#f-body');if(!t)return;
 var s=t.selectionStart,e=t.selectionEnd,v=t.value,sel=v.slice(s,e),out,cs,ce;
 if(k==='bold'||k==='italic'){
  var m=k==='bold'?'**':'*',inner=sel||'متن';
  out=m+inner+m;cs=s+m.length;ce=cs+inner.length;
  t.value=v.slice(0,s)+out+v.slice(e);
 }else if(k==='link'){
  var u=prompt('آدرس لینک (با https:// شروع شود)');if(!u)return;
  if(!/^https?:\/\/[^\s)*]+$/.test(u)){toast('آدرس لینک معتبر نیست',true);return}
  var li=sel||'متن لینک';
  out='['+li+']('+u+')';cs=s+1;ce=cs+li.length;
  t.value=v.slice(0,s)+out+v.slice(e);
 }else if(k==='video'){
  var vu=prompt('لینک ویدیوی آپارات یا یوتیوب');if(!vu)return;vu=vu.trim();
  var okv=false;try{var uu=new URL(vu);var hh=uu.hostname.replace(/^(www|m)\./,'');okv=/^https?:$/.test(uu.protocol)&&(hh==='youtu.be'||hh==='youtube.com'||hh==='aparat.com')}catch(x){}
  if(!okv){toast('فقط لینک آپارات یا یوتیوب مجاز است',true);return}
  var pv0=s===0?'':(v.slice(Math.max(0,s-2),s)==='\n\n'?'':(v.charAt(s-1)==='\n'?'\n':'\n\n'));
  out=pv0+vu+'\n\n';cs=ce=s+out.length;
  t.value=v.slice(0,s)+out+v.slice(e);
 }else if(k==='hr'){
  var pre0=(s>0&&v.charAt(s-1)!=='\n')?'\n\n':'';
  out=pre0+'---\n\n';cs=ce=s+out.length;
  t.value=v.slice(0,s)+out+v.slice(e);
 }else{
  var pre={h2:'## ',h3:'### ',quote:'> ',list:'- '}[k];
  var ls=v.lastIndexOf('\n',s-1)+1,le=v.indexOf('\n',e);if(le<0)le=v.length;
  var block=v.slice(ls,le)||'متن';
  out=block.split('\n').map(function(l){return pre+l}).join('\n');
  cs=ls;ce=ls+out.length;
  t.value=v.slice(0,ls)+out+v.slice(le);
 }
 t.focus();t.setSelectionRange(cs,ce);
 S.ed.body=t.value;
 updPv();
}

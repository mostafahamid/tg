// خبرهای RSS که متن کامل ندارند (با دکمه‌ی مستقیم به صفحه‌ی منبع برای کپی دستی)
async function sendNeedList(env, chatId) {
  const r = await env.DB.prepare(
    "SELECT id,title,source_url,status,LENGTH(COALESCE(body,'')) AS blen FROM news " +
    "WHERE COALESCE(source_url,'')!='' AND LENGTH(COALESCE(body,''))<? ORDER BY created_at DESC LIMIT 6"
  ).bind(THIN_BODY).all();
  const items = r.results || [];
  if (!items.length) {
    await sendMessage(env, chatId, "✅ همه‌ی خبرهای RSS متن کامل دارند.", {
      inline_keyboard: [[{ text: "🔙 منابع", callback_data: "rssmenu" }]]
    });
    return;
  }
  const site = (env.SITE_URL || "").replace(/\/+$/, "");
  const kb = items.map(n => {
    const t = String(n.title || "");
    return [
      { text: "✏️ " + (t.length > 24 ? t.slice(0, 23) + "…" : t), callback_data: "manage:" + n.id },
      { text: "🔗 منبع", url: n.source_url }
    ];
  });
  kb.push([{ text: "🔄 بروزرسانی", callback_data: "needlist" }]);
  kb.push([{ text: "🔙 منابع", callback_data: "rssmenu" }]);
  await sendMessage(env, chatId,
    `📄 ${items.length} خبر متن کامل ندارد.\n\n` +
    "روی «✏️ تیتر» بزن تا همینجا ویرایشش کنی (همه‌ی کارها در تلگرام انجام میشود).\n" +
    "برای دیدن متن اصلی، «🔗 منبع» را بزن؛ متن را کپی کن و با «✏️ ویرایش متن کامل» همینجا بچسبان.",
    { inline_keyboard: kb });
}

// پیام نتیجه‌ی اجرای فید (هم برای اجرای دستی و هم برای اجرای خودکار Cron)
async function notifyFeedResult(env, chatId, f, r) {
  if (!chatId) return;
  let t = `📡 ${f.name || "منبع RSS"}\n\n${r.status}`;
  const kb = [];
  if (r.thin) kb.push([{ text: "📄 خبرهای بدون متن کامل", callback_data: "needlist" }]);
  kb.push([{ text: "🔙 منابع", callback_data: "rssmenu" }]);
  try { await sendMessage(env, chatId, t, { inline_keyboard: kb }); } catch (e) { console.error("notify feed failed", e); }
}


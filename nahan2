 else if(a==='savesettings'){var b={logo_key:S.logo||''};['breaking_text','footer_text','instagram','telegram','contact_text','contact_email','contact_phone','contact_address'].forEach(function(k){b[k]=$('#s-'+k).value});api('/settings',{method:'PUT',json:b}).then(function(){toast('تنظیمات ذخیره شد')}).catch(fail)}}

app.addEventListener('click',function(e){var el=e.target.closest('[data-go],[data-act]');if(!el)return;e.preventDefault();if(el.dataset.go)go(el.dataset.go,el.dataset.id);else act(el.dataset.act,el.dataset.id,el)});

app.addEventListener('input',function(e){
 var i=e.target.id;
 if(!S.ed)return;
 if(i==='f-title')S.ed.title=e.target.value;
 else if(i==='f-summary')S.ed.summary=e.target.value;
 else if(i==='f-body')S.ed.body=e.target.value;
 if(i==='f-title'||i==='f-summary'||i==='f-body')updPv();
});

app.addEventListener('change',function(e){
 if(!S.ed&&e.target.id!=='s-logo'&&e.target.id!=='g-img')return;
 if(e.target.classList&&e.target.classList.contains('rowchk')){if(e.target.checked)S.sel[e.target.dataset.id]=1;else delete S.sel[e.target.dataset.id];updSel();return}
 if(e.target.id==='chkall'){document.querySelectorAll('.rowchk').forEach(function(c){c.checked=e.target.checked;if(c.checked)S.sel[c.dataset.id]=1;else delete S.sel[c.dataset.id]});updSel();return}
 if(e.target.classList&&e.target.classList.contains('f-catc')){var cc=S.ed.cats||[],cv=e.target.value,ci=cc.indexOf(cv);if(e.target.checked&&ci<0)cc.push(cv);else if(!e.target.checked&&ci>-1)cc.splice(ci,1);S.ed.cats=cc;$('#catlist').innerHTML=catsHtml();updPv();return}
 if(e.target.id==='f-imgpos'){updPv();return}
 if(e.target.id==='f-date'){var dv=e.target.value?new Date(e.target.value):null;S.ed.published_at=(dv&&!isNaN(dv))?dv.toISOString():'';return}
 if(e.target.id==='f-img'&&e.target.files[0]){
  toast('در حال آمادهسازی و بارگذاری عکس…');
  resizeUpload(e.target.files[0],1600,function(d){S.ed.image_key=d.key;$('#imgbox').innerHTML=imgHtml();updPv();toast('عکس بارگذاری شد')});
 }
 if(e.target.id==='f-mimg'&&e.target.files[0]){
  toast('در حال آپلود عکس میانی…');
  resizeUpload(e.target.files[0],1600,function(d){if(!S.ed.body_images)S.ed.body_images=[];S.ed.body_images.push({image_key:d.key,caption:''});$('#bimglist').innerHTML=bodyImagesHtml();updPv();toast('عکس میانی اضافه شد')});
 }
 if(e.target.id==='s-logo'&&e.target.files[0]){
  toast('در حال بارگذاری لوگو…');
  prepLogo(e.target.files[0]).then(function(b){return api('/upload',{method:'POST',raw:b,type:'image/png'})}).then(function(d){S.logo=d.key;$('#logobox').innerHTML=logoHtml();toast('لوگو بارگذاری شد؛ ذخیره را بزن')}).catch(fail);
 }
 if(e.target.id==='g-img'&&e.target.files[0]){
  toast('در حال آپلود عکس گالری…');
  resizeUpload(e.target.files[0],1600,function(d){window.tmpGalKey=d.key;$('#gsave').style.display='inline-block';toast('عکس آپلود شد. عنوان را وارد کرده و ذخیره کنید.')});
 }
 if(e.target.id==='v-poster'&&e.target.files[0]){
  toast('در حال آپلود پوستر…');
  resizeUpload(e.target.files[0],1280,function(d){window.tmpPosterKey=d.key;toast('پوستر آپلود شد')});
 }
 if(e.target.classList&&e.target.classList.contains('vposter')&&e.target.files[0]){
  var vid=e.target.dataset.id;
  toast('در حال آپلود پوستر…');
  resizeUpload(e.target.files[0],1280,function(d){api('/videos/'+vid,{method:'PATCH',json:{poster_key:d.key}}).then(function(){toast('پوستر عوض شد');videos()}).catch(fail)});
 }
});
function save(btn){
 var e=S.ed;
 if(!e.cats||!e.cats.length){toast('حداقل یک دستهبندی انتخاب کن',true);return}
 var dateVal=$('#f-date').value,dISO='';
 if(dateVal){var dd=new Date(dateVal);if(!isNaN(dd))dISO=dd.toISOString()}
 var b={title:$('#f-title').value,summary:$('#f-summary').value,body:$('#f-body').value,category:e.cats[0],categories:e.cats,status:$('#f-status').value,author:$('#f-author').value,featured:$('#f-feat').checked?1:0,image_key:e.image_key||'',image_position:$('#f-imgpos').value,published_at:dISO,body_images:e.body_images||[],notify:($('#f-notify')&&$('#f-notify').checked)?1:0,tags:($('#f-tags')?$('#f-tags').value:'')};
 btn.disabled=true;
 (e.id?api('/news/'+e.id,{method:'PUT',json:b}):api('/news',{method:'POST',json:b})).then(function(){toast('خبر ذخیره شد');go('list')}).catch(function(x){btn.disabled=false;fail(x)})}

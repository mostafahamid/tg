// =====================================================================
// خوزخبر — Cloudflare Worker (نسخه‌ی کامل با کش عکس، بخش RSS، متن کامل منابع،
// ارسال خودکار به کانال تلگرام، ویرایشگر غنی، پوستر ویدیو، عکس خودکار خبر ویدیویی،
// تکثیر خبر، پیش‌نمایش زنده، ویجت آب‌وهوا، حذف گروهی پیش‌نویس‌ها، جداسازی خبرهای RSS،
// «باز کردن صفحه‌ی منبع برای کپی دستی متن کامل» و «بخش RSS در سایت عمومی»
//
// ───────────────────────────── آنچه در این نسخه اضافه شده ─────────────────────────────
//   ۱) /rss            صفحه‌ی «فید اخبار» به سبک isna.ir/rss-help: دو جدول
//      «نوع فید | آدرس فید» (فیدهای اصلی + فید سرویس تکتک دستهها، با کپی لینک)،
//      فید برچسب، راهنمای کوتاه، آخرین خبرها و لینک خبرهای منابع RSS.
//      در تمام متنها و لینکها فقط از واژه‌ی «فید» استفاده شده است.
//   ۲) /rss/news       فهرست خبرهای منتشرشده‌ای که از منابع RSS وارد شده‌اند.
//   ۳) /rss.xml        علاوه بر فید اصلی، ?category=… ، ?tag=… و ?featured=1 (خبرهای ویژه صفحه اصلی) را پشتیبانی میکند.
//   ۴) لینک RSS در نوار بالا، منوی دستهها، فوتر، سایتماپ، بنر صفحه‌ی اصلی،
//      لینک «فید این دسته» بالای صفحات دسته و <link rel="alternate"> مخصوص هر دسته.
//   ۵) بلوک «📡 از منابع خبری» در صفحه‌ی اصلی: آخرین ۶ خبر منتشرشده‌ی RSS،
//      با لینک «همه‌ی خبرها» به /rss/news.
//   ۶) تنها تغییر مربوط به بازدید: شمارنده‌ی «چند بازدید» در صفحه‌ی خبر فقط
//      برای ادمین نمایش داده میشود و مخاطبان عادی آن را نمیبینند. شمارش بازدید،
//      آمار داشبورد، ستون بازدید فهرست پنل، «پربازدیدترینها» (همه‌ی صفحات)،
//      «مجموع بازدید» و خط «بازدید:» در ربات همگی دقیقاً سر جای خود ماندهاند.
//   ۷) «گرفتن متن کامل خبر از صفحه‌ی منبع» دوباره اضافه شد، ولی فقط اختیاری و
//      فقط برای منابعی که خودت روشنشان میکنی (feeds.fetch_full). محافظها:
//      همخوانی دامنه با فید، مسدودکردن IP/دامنههای خصوصی، ریدایرکت دستی و
//      اعتبارسنجی هر پرش، تایماوت، سقف حجم، بررسی Content-Type، تشخیص صفحهی
//      «در حال انتقال / ۴۰۳ / کپچا»، استخراج پاراگرافها و اعتبارسنجی طول و
//      فارسیبودن متن. اگر هر مرحله شکست بخورد، متن خالی میماند و روش دستی
//      (دکمه‌ی «صفحه‌ی منبع» + «چسباندن متن») همچنان کار میکند.
//      دکمه‌ها: «📥 متن از منبع» در ویرایش خبر، «بازپردازش» در ابزارهای تعمیر،
//      «📄 متن کامل» در تنظیمات هر منبع (پنل و ربات) و «📥 گرفتن متن کامل»
//      در منوی مدیریت هر خبر در ربات.
//
// قبل از دیپلوی، این دستورها را یک‌بار (هرکدام جداگانه) در Console دیتابیس D1 اجرا کن:
//   ALTER TABLE videos ADD COLUMN poster_key TEXT DEFAULT '';
//   ALTER TABLE news ADD COLUMN thumb TEXT DEFAULT '';
//   ALTER TABLE news ADD COLUMN tags TEXT DEFAULT '';
//   ALTER TABLE news ADD COLUMN categories TEXT DEFAULT '';
//   ALTER TABLE news ADD COLUMN source_url TEXT DEFAULT '';
//   ALTER TABLE news ADD COLUMN source_name TEXT DEFAULT '';
//   CREATE INDEX IF NOT EXISTS idx_news_source ON news(source_url);
//   CREATE TABLE IF NOT EXISTS feeds (id TEXT PRIMARY KEY, name TEXT NOT NULL, url TEXT NOT NULL, categories TEXT DEFAULT '', auto_publish INTEGER DEFAULT 0, import_images INTEGER DEFAULT 0, max_items INTEGER DEFAULT 5, enabled INTEGER DEFAULT 1, last_run TEXT DEFAULT '', last_status TEXT DEFAULT '', created_at TEXT);
//   CREATE TABLE IF NOT EXISTS feed_skip (url TEXT PRIMARY KEY);
//
// جدول feed_skip لینک خبرهای RSS حذف‌شده را نگه میدارد تا دوباره وارد سایت نشوند.
//
// برای پاک کردن نام منبع از خبرهای RSS که قبلاً وارد شدهاند (اختیاری):
//   UPDATE news SET author='', source_name='' WHERE source_url!='';
//
// خبرهای RSS قدیمی که خلاصهشان داخل متن هم کپی شده بود، با اولین بار باز کردن
// ویرایش خودکار پاک میشوند. برای پاکسازی یکجای همه (اختیاری):
//   UPDATE news SET body='' WHERE COALESCE(source_url,'')!='' AND TRIM(body)=TRIM(summary);
//
// برای دریافت خودکار خبر از RSS، یک Cron Trigger (مثلاً هر ۱۰ دقیقه: */10 * * * *) به Worker اضافه کن.
//
// ───────────────────── متن کامل خبر: پیشفرض دستی + استخراج اختیاری ─────────────────────
// استخراج خودکارِ همگانی حذف شد، چون سایتهای منبع درخواست Worker را با صفحه‌ی
// «در حال انتقال» (کد ۲۰۰) یا ۴۰۳ میبستند. حالا دو حالت داری:
//
//   ۱) لینک RSS را در «منابع خودکار» اضافه میکنی؛ تیتر و خلاصه از فید ذخیره
//      میشود و خبر «پیشنویس» میآید. خلاصه فقط در فیلد «خلاصه» میماند و
//      هیچوقت داخل «متن کامل خبر» کپی نمیشود. متن فقط وقتی پر میشود که خود
//      فید واقعاً متن کامل جدا داشته باشد (content:encoded بلندتر از خلاصه).
//   ۲) (اختیاری) تیک «گرفتن متن کامل خبر از صفحه‌ی منبع» را فقط برای منابع
//      مجاز روشن میکنی. آنوقت Worker صفحه‌ی همان منبع را با محدودیت دامنه،
//      ریدایرکت دستی، تایماوت و تشخیص صفحه‌ی محافظ میخواند؛ فقط پاراگرافهای
//      ناحیه‌ی مقاله را برمیدارد و بعد از اعتبارسنجی طول ذخیره میکند.
//      هر جا شکست بخورد، متن خالی میماند و هیچ خلاصهای کپی نمیشود.
//   ۳) در فهرست خبر، خبرهایی که متن کامل ندارند نشان «متن کامل ندارد» میگیرند.
//   ۴) در ویرایش خبر سه دکمه هست: «صفحه‌ی منبع»، «📥 متن از منبع» (همان
//      استخراج، روی یک خبر خاص) و «چسباندن متن» (کلیپبورد / Ctrl+V).
//   ۵) ذخیره → خبر با متن کامل خودت (یا متن استخراجشده) منتشر میشود.
//
// همین کارها از ربات تلگرام هم انجام میشود:
//   /rss   فهرست منابع؛ اجرا، فعال/غیرفعال، انتشار خودکار، «ارسال به کانال تلگرام»، حذف و افزودن منبع
//   /need  خبرهای RSS که متن کامل ندارند؛ با زدن «✏️» منوی همان خبر در تلگرام باز میشود:
//          ویرایش تیتر/خلاصه/متن، انتشار، ویژه کردن و حذف — همه داخل ربات انجام میشود
//          (متن بلند را در چند پیام بفرست و آخرش /done بزن؛ دکمه‌ی «🔗 صفحه‌ی منبع» هم
//          برای کپی متن اصلی همانجاست). انتشار از ربات، خبر را به کانال هم میفرستد.
//   بعد از هر اجرای خودکار (Cron)، اگر خبر تازهای آمده باشد، نتیجه به آیدی مدیر در تلگرام میرود.
//
// ته هر پست کانال تلگرام، یک خط پایینتر از همه‌ی متنها، نام کانال نوشته میشود
// (@khouz_khabar). اگر TELEGRAM_CHANNEL_ID نام کاربری باشد همان نوشته میشود؛ برای تغییر
// ثابت TG_CHANNEL_HANDLE را عوض کن.
//
// هیچ متغیر محیطی و هیچ پروکسی/رلهای لازم نیست. فقط لینک RSS و Cron Trigger.
// ستونهای feeds.to_channel و feeds.fetch_full خودکار و بدون دستور دستی ساخته میشوند.
// fetch_full یعنی «گرفتن متن کامل خبر از صفحه‌ی همان منبع»؛ فقط منابعی که روشنشان کنی.
//
// عیبیابی: در فهرست خبر، تب «خبرهای RSS» تعداد خبرهای «بدون متن کامل» را هم
// نشان میدهد؛ همانها کارهای باقیمانده‌ی تو هستند. هر سطر خبر فید یک دکمه‌ی
// «منبع» هم دارد و در ویرایش خبر، دکمه‌ی «صفحه‌ی منبع» بالای فرم است.
//
// نکته‌ی حقوقی: متنی که از صفحه‌ی منبع کپی و منتشر میکنی باید با شرایط استفاده
// و حقوق نشر همان منبع بخواند؛ ذکر نام و لینک منبع در متن خبر توصیه میشود.
// =====================================================================

const SITE_NAME = "خوزخبر";
const FA_LOC = "fa-IR-u-ca-persian-nu-arabext"; // تقویم شمسی و ارقام فارسی
const CATEGORIES = ["اهواز", "آبادان", "خرمشهر", "دزفول", "ماهشهر", "شوشتر", "استانی", "سیاسی", "اجتماعی", "کشوری", "بینالمللی"];
const MAX_IMAGE_BYTES = 1024 * 1024;
const PAGE_SIZE = 12;
const SESSION_DAYS = 7;
const LIST_CACHE_TTL = 60; // ثانیه: مدت کش صفحه اصلی و صفحات دستهبندی
const SETTINGS_TTL = 30000; // میلیثانیه: مدت کش حافظهای تنظیمات
const VIEW_FLUSH_COUNT = 10; // بعد از این تعداد بازدید در حافظه، یکجا در D1 نوشته میشود
const VIEW_FLUSH_MS = 30000; // یا بعد از این مدت از آخرین نوشتن
const PUB = "status='published' AND published_at<=?";
const COLS = "id,title,summary,category,image_key,thumb,published_at";
const KEY_RE = /^[a-f0-9-]{36}\.(jpg|png|webp)$/;
const SETTING_KEYS = ["breaking_text", "footer_text", "instagram", "telegram", "logo_key", "contact_text", "contact_email", "contact_phone", "contact_address"];

export default {
  // اجرای زمانبندیشده (Cron Trigger): دریافت خودکار خبر از منابع RSS
  async scheduled(event, env, ctx) {
    ctx.waitUntil(runDueFeed(env));
  },
  async fetch(request, env, ctx) {
    const url = new URL(request.url);
    const path = url.pathname;
    try {
      if (path === "/telegram/webhook" && request.method === "POST") {
        if (!env.TELEGRAM_WEBHOOK_SECRET ||
            request.headers.get("X-Telegram-Bot-Api-Secret-Token") !== env.TELEGRAM_WEBHOOK_SECRET) {
          return new Response("Forbidden", { status: 403 });
        }
        const update = await request.json();
        ctx.waitUntil(handleTelegramUpdate(update, env).catch(e => console.error("Telegram update failed", e)));
        return new Response("ok");
      }
      if (path === "/admin" || path.startsWith("/admin/")) return await handleAdmin(request, env, url, ctx);
      return await handlePublic(request, env, url, ctx);
    } catch (err) {
      console.error("Request failed", err);
      if (path.startsWith("/api/") || path.startsWith("/admin/api/")) return json({ error: "خطای داخلی سرور" }, 500);
      return new Response("خطای داخلی سرور. بعداً دوباره تلاش کنید.", { status: 500, headers: { "Content-Type": "text/plain; charset=utf-8" } });
    }
  }
};

// ------------------------------ ابزارهای عمومی ------------------------------
function json(data, status = 200, extra = {}) {
  return new Response(JSON.stringify(data), {
    status, headers: { "Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store", ...extra }
  });
}
function htmlResponse(body, status = 200, extra = {}) {
  return new Response(body, {
    status,
    headers: {
      "Content-Type": "text/html; charset=utf-8",
      "X-Content-Type-Options": "nosniff",
      "Referrer-Policy": "strict-origin-when-cross-origin",
      "Content-Security-Policy": "default-src 'none'; img-src 'self' data: blob:; style-src 'unsafe-inline'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'",
      ...extra
    }
  });
}
function esc(s = "") {
  return String(s ?? "").replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
}
function fmtDate(s) {
  try { return new Date(s).toLocaleString(FA_LOC, { dateStyle: "medium", timeStyle: "short", timeZone: "Asia/Tehran" }); }
  catch { return ""; }
}
// تاریخ کامل شمسی با ترتیب درست: «شنبه، ۹ آبان ۱۴۰۵»
function fmtFullDate(d) {
  const p = {};
  for (const x of new Intl.DateTimeFormat(FA_LOC, { weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "Asia/Tehran" }).formatToParts(d)) p[x.type] = x.value;
  return `${p.weekday}، ${p.day} ${p.month} ${p.year}`;
}
const nowIso = () => new Date().toISOString();
const newId = () => crypto.randomUUID().slice(0, 8) + "-" + Date.now().toString(36);
function safeDecode(s) { try { return decodeURIComponent(s); } catch { return ""; } }
function sniffImage(buf) {
  const b = new Uint8Array(buf.slice(0, 12));
  if (b[0] === 0xFF && b[1] === 0xD8 && b[2] === 0xFF) return { ext: "jpg", mime: "image/jpeg" };
  if (b[0] === 0x89 && b[1] === 0x50 && b[2] === 0x4E && b[3] === 0x47) return { ext: "png", mime: "image/png" };
  if (b[0] === 0x52 && b[1] === 0x49 && b[2] === 0x46 && b[3] === 0x46 && b[8] === 0x57 && b[9] === 0x45 && b[10] === 0x42 && b[11] === 0x50) return { ext: "webp", mime: "image/webp" };
  return null;
}
function toBase64(buf) {
  const b = new Uint8Array(buf); let s = "";
  for (let i = 0; i < b.length; i += 0x8000) s += String.fromCharCode.apply(null, b.subarray(i, i + 0x8000));
  return btoa(s);
}
function fromBase64(str) {
  const s = atob(str), b = new Uint8Array(s.length);
  for (let i = 0; i < s.length; i++) b[i] = s.charCodeAt(i);
  return b;
}
async function putImage(env, key, buf, mime) {
  await env.DB.prepare("INSERT INTO media (key,mime,data,size,created_at) VALUES (?,?,?,?,?)")
    .bind(key, mime, toBase64(buf), buf.byteLength, nowIso()).run();
}
async function imageExists(env, key) {
  return !!(await env.DB.prepare("SELECT 1 AS x FROM media WHERE key=?").bind(key).first());
}
async function cleanupImage(env, key) {
  if (!key) return;
  const used = await env.DB.prepare(
    "SELECT 1 AS x FROM news WHERE image_key=? UNION SELECT 1 FROM gallery WHERE image_key=? UNION SELECT 1 FROM settings WHERE value=? AND key='logo_key' " +
    "UNION SELECT 1 FROM news WHERE body_images LIKE ? UNION SELECT 1 FROM videos WHERE poster_key=? UNION SELECT 1 FROM news WHERE thumb=? LIMIT 1"
  ).bind(key, key, key, '%' + key + '%', key, "/media/" + key).first();
  if (!used) { try { await env.DB.prepare("DELETE FROM media WHERE key=?").bind(key).run(); } catch (e) { console.error("media delete failed", e); } }
}
// پاککردن گروهی عکسهای بیمصرف (همه در یک batch تا فشار روی D1 کم باشد)
async function cleanupImages(env, keys) {
  keys = [...new Set((keys || []).filter(k => KEY_RE.test(k)))];
  for (let i = 0; i < keys.length; i += 90) {
    const stmts = keys.slice(i, i + 90).map(k => env.DB.prepare(
      "DELETE FROM media WHERE key=? " +
      "AND NOT EXISTS (SELECT 1 FROM news WHERE image_key=? OR thumb=? OR body_images LIKE ?) " +
      "AND NOT EXISTS (SELECT 1 FROM gallery WHERE image_key=?) " +
      "AND NOT EXISTS (SELECT 1 FROM settings WHERE key='logo_key' AND value=?) " +
      "AND NOT EXISTS (SELECT 1 FROM videos WHERE poster_key=?)"
    ).bind(k, k, "/media/" + k, "%" + k + "%", k, k, k));
    try { await env.DB.batch(stmts); } catch (e) { console.error("bulk media cleanup failed", e); }
  }
}
// اگر thumb به یک عکس داخل /media اشاره میکرد، کلید آن را برمیگرداند
const thumbKey = t => (typeof t === "string" && t.startsWith("/media/")) ? t.slice(7) : "";

// ------------------------------ برچسبها ------------------------------
// در دیتابیس به شکل ",a,b," ذخیره میشوند تا جستجوی دقیق با LIKE ممکن باشد
function normTags(raw) {
  const list = String(raw || "").split(/[,،\n]/)
    .map(t => t.replace(/[%_\\<>"'`]/g, "").replace(/\s+/g, " ").trim().slice(0, 30))
    .filter(Boolean);
  const uniq = [...new Set(list)].slice(0, 8);
  return uniq.length ? "," + uniq.join(",") + "," : "";
}
const tagList = s => String(s || "").split(",").map(t => t.trim()).filter(Boolean);
// دستهبندیهای یک خبر (دسته‌ی اصلی اول است). خبرهای قدیمی فقط ستون category دارند.
const catsOf = a => { const l = tagList(a.categories).filter(x => CATEGORIES.includes(x)); return l.length ? l : [a.category]; };

// ------------------------------ لینک پیشنمایش خبر منتشرنشده ------------------------------
const PREVIEW_DAYS = 7;
async function previewToken(env, id) {
  const exp = Date.now() + PREVIEW_DAYS * 86400000;
  return exp + "." + await hmac(env.SESSION_SECRET, "pv|" + id + "|" + exp);
}
async function previewOk(env, id, tok) {
  if (!env.SESSION_SECRET || !tok) return false;
  const [exp, sig] = String(tok).split(".");
  if (!exp || !sig || !(Number(exp) > Date.now())) return false;
  return safeEqual(sig, await hmac(env.SESSION_SECRET, "pv|" + id + "|" + exp));
}
// پاک کردن کش لبه‌ی صفحه اصلی، دستهبندیها و صفحه‌های RSS
async function purgeListCaches(origin) {
  if (typeof caches === "undefined" || !caches.default) return;
  const paths = ["/", "/rss", "/rss/news", ...CATEGORIES.map(c => "/category/" + encodeURIComponent(c))];
  for (const p of paths) { try { await caches.default.delete(new Request(origin + p, { method: "GET" })); } catch (e) { } }
}

// تنظیمات سایت: برای کم کردن فشار روی D1 چند ثانیه در حافظه‌ی همان isolate نگه داشته میشود
const SETTINGS_DEFAULT = { breaking_text: "پوشش تازهترین رویدادهای استان خوزستان", footer_text: "رسانه خبری استان خوزستان", instagram: "", telegram: "", logo_key: "", contact_text: "", contact_email: "", contact_phone: "", contact_address: "", urgent_text: "", urgent_link: "", urgent_on: "" };
let SETTINGS_MEM = { t: 0, v: null };
async function getSettings(env, fresh = false) {
  if (!fresh && SETTINGS_MEM.v && Date.now() - SETTINGS_MEM.t < SETTINGS_TTL) return SETTINGS_MEM.v;
  const s = { ...SETTINGS_DEFAULT };
  try {
    const r = await env.DB.prepare("SELECT key,value FROM settings").all();
    for (const x of r.results || []) if (x.key in s) s[x.key] = x.value;
    SETTINGS_MEM = { t: Date.now(), v: s };
  } catch { }
  return s;
}

// ------------------------------ شمارش بازدید (کمفشار برای D1) ------------------------------
// ۱) رباتها و کراولرها شمرده نمیشوند. ۲) بازدیدها در حافظه جمع میشوند و برای هر خبر
// فقط یک UPDATE زده میشود. اگر ترافیک کم باشد، هر بازدید تقریباً بلافاصله نوشته میشود.
const BOT_RE = /bot|crawl|spider|slurp|facebookexternalhit|telegram|whatsapp|preview|fetch|curl|wget|python|httpclient|headless|lighthouse|monitor|uptime|pingdom|axios|go-http/i;
const VIEW_BUF = new Map();
let VIEW_LAST = Date.now();
function countView(env, ctx, request, id) {
  if (request.method !== "GET") return;
  const ua = request.headers.get("User-Agent") || "";
  if (!ua || BOT_RE.test(ua)) return;
  VIEW_BUF.set(id, (VIEW_BUF.get(id) || 0) + 1);
  let total = 0; for (const n of VIEW_BUF.values()) total += n;
  if (total >= VIEW_FLUSH_COUNT || Date.now() - VIEW_LAST > VIEW_FLUSH_MS) {
    const entries = [...VIEW_BUF]; VIEW_BUF.clear(); VIEW_LAST = Date.now();
    ctx.waitUntil(
      env.DB.batch(entries.map(([i, n]) => env.DB.prepare("UPDATE news SET views=views+? WHERE id=?").bind(n, i)))
        .catch(e => console.error("views flush failed", e))
    );
  }
}

// ------------------------------ احراز هویت ادمین ------------------------------
const enc = new TextEncoder();
function b64u(bytes) {
  let s = ""; for (const b of bytes) s += String.fromCharCode(b);
  return btoa(s).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
}
async function hmac(secret, data) {
  const key = await crypto.subtle.importKey("raw", enc.encode(secret), { name: "HMAC", hash: "SHA-256" }, false, ["sign"]);
  return b64u(new Uint8Array(await crypto.subtle.sign("HMAC", key, enc.encode(data))));
}
async function safeEqual(a, b) {
  const [x, y] = await Promise.all([crypto.subtle.digest("SHA-256", enc.encode(String(a))), crypto.subtle.digest("SHA-256", enc.encode(String(b)))]);
  const A = new Uint8Array(x), B = new Uint8Array(y);
  let d = 0; for (let i = 0; i < A.length; i++) d |= A[i] ^ B[i];
  return d === 0;
}
async function isAdmin(request, env) {
  if (!env.SESSION_SECRET) return false;
  const m = (request.headers.get("Cookie") || "").match(/(?:^|;\s*)kk_session=([^;]+)/);
  if (!m) return false;
  const [exp, sig] = m[1].split(".");
  if (!exp || !sig || !(Number(exp) > Date.now())) return false;
  return safeEqual(sig, await hmac(env.SESSION_SECRET, "kk|" + exp));
}
async function loginAllowed(env, ip) {
  const r = await env.DB.prepare("SELECT fails,first_at FROM login_attempts WHERE ip=?").bind(ip).first();
  if (!r || Date.now() - r.first_at > 900000) return true;
  return r.fails < 5;
}
async function loginFailed(env, ip) {
  const n = Date.now();
  await env.DB.prepare(
    "INSERT INTO login_attempts (ip,fails,first_at) VALUES (?,1,?) ON CONFLICT(ip) DO UPDATE SET " +
    "fails=CASE WHEN ?-first_at>900000 THEN 1 ELSE fails+1 END, first_at=CASE WHEN ?-first_at>900000 THEN ? ELSE first_at END"
  ).bind(ip, n, n, n, n).run();
}
function sameOrigin(request, url) {
  const o = request.headers.get("Origin");
  if (!o) return false;
  try { return new URL(o).host === url.host; } catch { return false; }
}

// ------------------------------ عکس خودکار برای خبر ویدیویی ------------------------------
// اگر خبر عکس شاخص ندارد ولی اولین ویدیوی داخل متن دارد، پوستر آن ویدیو
// (برای لیست خبرها، اسلایدر و og:image) در ستون news.thumb ذخیره میشود.
function firstVideoOf(body) {
  for (const p of String(body || "").split(/\n{2,}/)) {
    const t = p.trim();
    if (/^https?:\/\/\S+$/.test(t)) { const pv = parseVideoUrl(t); if (pv) return pv; }
  }
  return null;
}
async function storeRemoteThumb(env, provider, videoId) {
  const img = await fetchVideoThumb(provider, videoId);
  if (!img) return "";
  const t = sniffImage(img.buf);
  if (!t) return "";
  const key = `${crypto.randomUUID()}.${t.ext}`;
  await putImage(env, key, img.buf, t.mime);
  return key;
}
async function computeThumb(env, body, prev) {
  const pv = firstVideoOf(body);
  if (!pv) return "";
  if (prev && prev.thumb) {
    const pp = firstVideoOf(prev.body);
    if (pp && pp.provider === pv.provider && pp.video_id === pv.video_id) return prev.thumb;
  }
  try {
    const v = await env.DB.prepare("SELECT poster_key FROM videos WHERE provider=? AND video_id=? AND poster_key!='' LIMIT 1").bind(pv.provider, pv.video_id).first();
    if (v && v.poster_key) return "/media/" + v.poster_key;
  } catch (e) { }
  try {
    const key = await storeRemoteThumb(env, pv.provider, pv.video_id);
    if (key) return "/media/" + key;
  } catch (e) { console.error("auto thumb failed", e); }
  return "";
}


// اگر پوستر ذخیرهشده در دیتابیس باشد از آن استفاده میشود، وگرنه از /vthumb
function videoFacadeHtml(v, title) {
  const t = esc(title || "ویدیو");
  const bg = v.poster_key ? imgSrc(v.poster_key) : `/vthumb/${v.provider}/${encodeURIComponent(v.video_id)}`;

  const latestRows = latest.results || [];
  const feedRows = fromFeeds.results || [];
  const latestHtml = latestRows.length
    ? `<ol class="rss-list">${latestRows.map(n => `<li><a href="/news/${esc(n.id)}">${esc(n.title)}</a><time>${esc(fmtDate(n.published_at))}</time></li>`).join("")}</ol>`
    : `<p class="muted">هنوز خبری منتشر نشده است.</p>`;

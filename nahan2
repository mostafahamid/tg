async function sitemap(env, origin) {
  const r = await env.DB.prepare(`SELECT id,published_at,updated_at FROM news WHERE ${PUB} ORDER BY published_at DESC LIMIT 1000`).bind(nowIso()).all();
  const urls = [`<url><loc>${origin}/</loc></url>`,
    `<url><loc>${origin}/contact</loc></url>`,
    `<url><loc>${origin}/gallery</loc></url>`,
    `<url><loc>${origin}/videos</loc></url>`,
    `<url><loc>${origin}/rss</loc></url>`,
    `<url><loc>${origin}/rss/news</loc></url>`,
    ...CATEGORIES.map(x => `<url><loc>${origin}/category/${encodeURIComponent(x)}</loc></url>`),
    ...(r.results || []).map(n => `<url><loc>${origin}/news/${esc(n.id)}</loc><lastmod>${(n.updated_at || n.published_at).slice(0, 10)}</lastmod></url>`)].join("");
  return new Response(`<?xml version="1.0" encoding="UTF-8"?><urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">${urls}</urlset>`,
    { headers: { "Content-Type": "application/xml; charset=utf-8", "Cache-Control": "public, max-age=3600" } });
}

const CLOCK_JS = `
(function(){
  document.addEventListener('click',function(e){
    var b=e.target.closest&&e.target.closest('.video-play');
    if(!b)return;
    var src=b.getAttribute('data-src')||'';
    if(src.indexOf('youtube-nocookie.com')>-1)src+='?autoplay=1';
    var f=document.createElement('iframe');
    f.src=src;f.title=b.getAttribute('data-title')||'';
    f.setAttribute('allowfullscreen','');
    f.setAttribute('allow','autoplay; fullscreen; picture-in-picture');
    f.setAttribute('referrerpolicy','strict-origin-when-cross-origin');
    b.parentNode.replaceChild(f,b);
  });
  var tb=document.getElementById('kk-theme');
  if(tb)tb.addEventListener('click',function(){
    var dark=document.documentElement.getAttribute('data-theme')==='dark';
    if(dark){document.documentElement.removeAttribute('data-theme')}else{document.documentElement.setAttribute('data-theme','dark')}
    try{localStorage.setItem('kk_theme',dark?'light':'dark')}catch(e){}
  });
  var bt=document.getElementById('kk-top'),pg=null,art=document.querySelector('.article .body');
  if(art&&document.querySelector('.article h1')){pg=document.createElement('div');pg.className='progress';pg.innerHTML='<i></i>';document.body.appendChild(pg)}
  function onScroll(){
    var y=window.pageYOffset||document.documentElement.scrollTop;
    if(bt){if(y>600)bt.classList.add('show');else bt.classList.remove('show')}
    if(pg){var r=art.getBoundingClientRect(),h=r.height-window.innerHeight*0.6,p=h>0?Math.min(1,Math.max(0,(window.innerHeight*0.2-r.top)/h)):1;pg.firstChild.style.width=(p*100)+'%'}
  }
  window.addEventListener('scroll',onScroll,{passive:true});onScroll();
  if(bt)bt.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'})});
  var d=document.getElementById('kk-date'),t=document.getElementById('kk-time');
  if(d&&t){
    var fd=new Intl.DateTimeFormat('fa-IR-u-ca-persian-nu-arabext',{weekday:'long',day:'numeric',month:'long',year:'numeric',timeZone:'Asia/Tehran'}),
        ft=new Intl.DateTimeFormat('fa-IR-u-ca-persian-nu-arabext',{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false,timeZone:'Asia/Tehran'});
    var fdate=function(n){var p={};fd.formatToParts(n).forEach(function(x){p[x.type]=x.value});return p.weekday+'، '+p.day+' '+p.month+' '+p.year};
    var u=function(){var n=new Date();d.textContent=fdate(n);t.textContent=ft.format(n)};
    u();setInterval(u,1000);
  }
  var sl=document.getElementById('kk-slider');
  if(sl){
    var ss=sl.querySelectorAll('.slide'), ds=sl.querySelectorAll('.dot'), cur=0, timer=null, swiped=false, sx=0, sy=0;
    function show(i){
      if(!ss.length)return;
      cur=(i+ss.length)%ss.length;
      for(var k=0;k<ss.length;k++){
        if(k===cur){ss[k].classList.add('on')}else{ss[k].classList.remove('on')}
        if(ds[k]){if(k===cur){ds[k].classList.add('on')}else{ds[k].classList.remove('on')}}
      }
    }
    function start(){stop();if(ss.length>1)timer=setInterval(function(){show(cur+1)},6000)}
    function stop(){if(timer){clearInterval(timer);timer=null}}
    for(var j=0;j<ds.length;j++){
      (function(idx){ds[idx].addEventListener('click',function(e){e.preventDefault();show(idx);start()})})(j);
    }
    var pv=sl.querySelector('.nav-prev'), nx=sl.querySelector('.nav-next');
    if(pv)pv.addEventListener('click',function(e){e.preventDefault();show(cur-1);start()});
    if(nx)nx.addEventListener('click',function(e){e.preventDefault();show(cur+1);start()});
    sl.addEventListener('touchstart',function(e){
      var p=e.touches[0];sx=p.clientX;sy=p.clientY;swiped=false;stop();
    },{passive:true});
    sl.addEventListener('touchend',function(e){
      var p=e.changedTouches[0],dx=p.clientX-sx,dy=p.clientY-sy;
      if(Math.abs(dx)>40&&Math.abs(dx)>Math.abs(dy)){
        swiped=true;
        show(dx<0?cur+1:cur-1);
      }
      start();
    },{passive:true});
    sl.addEventListener('touchcancel',function(){start()},{passive:true});
    sl.addEventListener('click',function(e){
      if(swiped){e.preventDefault();e.stopPropagation();swiped=false}
    },true);
    sl.addEventListener('mouseenter',stop);
    sl.addEventListener('mouseleave',start);
    document.addEventListener('visibilitychange',function(){document.hidden?stop():start()});
    show(0);
    start();
  }
})();
`;


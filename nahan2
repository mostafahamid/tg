.themebtn{background:#ffffff14;border:1px solid #ffffff26;color:#fff;border-radius:999px;width:28px;height:28px;cursor:pointer;font-size:14px;line-height:1;padding:0}
.themebtn:hover{background:#ffffff26}
.urgent{background:linear-gradient(90deg,#b3131d,#e11d2e);color:#fff;font-size:15px}
.urgent .wrap{display:flex;gap:12px;align-items:center;padding-top:9px;padding-bottom:9px;font-weight:bold}
.urgent b{background:#fff;color:#b3131d;border-radius:6px;padding:1px 12px;font-size:13px;white-space:nowrap}
.urgent b:before{content:"";display:inline-block;width:8px;height:8px;border-radius:50%;background:#e11d2e;margin-left:6px;animation:kkpulse 1.4s infinite}
@keyframes kkpulse{0%{box-shadow:0 0 0 0 rgba(225,29,46,.6)}70%{box-shadow:0 0 0 8px rgba(225,29,46,0)}100%{box-shadow:0 0 0 0 rgba(225,29,46,0)}}
.urgent a:hover{text-decoration:underline}
.top{background:linear-gradient(135deg,var(--navy) 0%,var(--navy2) 100%);color:#fff;position:relative;overflow:hidden}
.top:before{content:"";position:absolute;inset:0;background:radial-gradient(520px 230px at 90% 0,rgba(225,29,46,.38),transparent 70%),radial-gradient(420px 200px at 5% 100%,rgba(255,255,255,.09),transparent 70%);pointer-events:none}
.top .wrap{position:relative}
.head{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:20px 0}
.brand{display:flex;align-items:center;gap:14px}
.logo{background:linear-gradient(135deg,var(--red),var(--red2));font-size:26px;font-weight:bold;width:50px;height:50px;display:grid;place-items:center;border-radius:14px;box-shadow:0 6px 18px rgba(225,29,46,.45);color:#fff}
.brand .name{display:block;font-size:28px;line-height:1.25}
.brand small{color:#c9d6e6;font-size:12.5px}
.logoimg{height:52px;width:auto;max-width:220px;object-fit:contain;display:block}
.search{display:flex;background:#ffffff1c;border:1px solid #ffffff2e;border-radius:999px;padding:3px}
.search:focus-within{border-color:#fff;background:#ffffff26}
.search input{border:0;background:transparent;color:#fff;padding:8px 16px;width:230px;font:inherit;font-size:13.5px;outline:0}
.search input::placeholder{color:#c4d2e3}
.search button{border:0;background:var(--red);color:#fff;padding:8px 20px;border-radius:999px;cursor:pointer;font:inherit;font-size:13px}
.search button:hover{background:var(--red2)}
.navbar{position:sticky;top:0;z-index:40;background:var(--card);border-bottom:1px solid var(--line);box-shadow:0 4px 14px rgba(15,42,71,.07)}
.nav{display:flex;gap:4px;overflow-x:auto;padding:8px 0;scrollbar-width:none}
.nav::-webkit-scrollbar{display:none}
.nav a{white-space:nowrap;padding:6px 16px;border-radius:999px;font-size:14px;color:var(--ink);font-weight:600;transition:background .2s,color .2s}
.nav a:hover{background:var(--paper)}
.nav a.active{background:var(--red);color:#fff;box-shadow:0 4px 12px rgba(225,29,46,.35)}
.breaking{background:var(--card);border-bottom:1px solid var(--line)}
.breaking .wrap{display:flex;align-items:center;gap:12px;padding-top:10px;padding-bottom:10px;font-size:14px;color:var(--muted)}
.breaking b{background:var(--navy);color:#fff;border-radius:6px;padding:2px 10px;font-size:12px}
.main{padding:28px 18px 54px}
.cols{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:28px;align-items:start}
.cols.one{grid-template-columns:1fr}
.main-col{min-width:0}
.sidecol{display:grid;gap:20px}
.sectionhead{margin:0 0 18px;display:flex;align-items:center;gap:12px}
.sectionhead:before{content:"";width:6px;height:26px;border-radius:4px;background:linear-gradient(var(--red),var(--red2))}
.sectionhead h1,.sectionhead h2{margin:0;font-size:21px}
.side{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:18px;box-shadow:var(--shadow)}
.side h2{font-size:16px;margin:0 0 10px;display:flex;align-items:center;gap:8px}
.side h2:before{content:"";width:5px;height:18px;background:var(--red);border-radius:3px}
.side ol{margin:0;padding-right:22px}
.side li{padding:9px 0;border-bottom:1px dashed var(--line);font-size:14px;line-height:1.75}
.side li:last-child{border:0}
.side a:hover{color:var(--red)}
.rank{list-style:none;padding:0!important;counter-reset:r}
.rank li{counter-increment:r;display:flex;gap:12px;align-items:flex-start}
.rank li:before{content:counter(r,persian);flex:none;width:28px;height:28px;border-radius:9px;background:var(--paper);color:var(--red);font-weight:bold;display:grid;place-items:center;font-size:13px}
.rank li:first-child:before{background:var(--red);color:#fff}
.tl ol{list-style:none;padding:0}
.tl li{display:grid;grid-template-columns:62px 1fr;gap:10px}
.tl time{color:var(--red);font-weight:bold;font-size:12px;line-height:2;white-space:nowrap}
.tl small{display:block;color:var(--muted);font-weight:normal;font-size:10px;line-height:1.3}
.muted{color:var(--muted);font-size:13px}
.wx ul{list-style:none;margin:0;padding:0}
.wx li{display:grid;grid-template-columns:64px 1fr auto;gap:8px;align-items:center;padding:8px 0;border-bottom:1px dashed var(--line);font-size:14px}
.wx li:last-child{border:0}
.wx-desc{color:var(--muted);font-size:12.5px}
.wx-temp{font-size:17px;color:var(--red)}
.wx small{display:block;margin-top:8px;font-size:11px}
.top-grid{display:grid;grid-template-columns:2fr 1fr;gap:22px;margin-bottom:36px;align-items:stretch}
.top-grid.no-slider{grid-template-columns:1fr}
.top-slider,.top-latest{min-width:0}
.top-latest .side{height:470px;overflow-y:auto;margin:0;scrollbar-width:thin}
.hero-slider{position:relative;width:100%;border-radius:20px;overflow:hidden;background:var(--navy);height:470px;touch-action:pan-y;box-shadow:0 18px 40px rgba(15,42,71,.25)}
.slide{display:none;position:absolute;inset:0;width:100%;height:100%}
.slide.on{display:block;animation:kkfade .6s ease}
@keyframes kkfade{from{opacity:.4;transform:scale(1.02)}to{opacity:1;transform:scale(1)}}
.slide-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.slide-txt{position:absolute;inset:auto 0 0 0;padding:90px 28px 46px;background:linear-gradient(transparent,rgba(5,12,24,.55) 35%,rgba(5,12,24,.92));color:#fff;z-index:2}
.slide-txt .tag{background:var(--red);color:#fff;margin-bottom:10px}
.slide-txt h2{margin:0;font-size:27px;line-height:1.65;text-shadow:0 2px 8px rgba(0,0,0,.5)}
.hero-slider .dots{position:absolute;bottom:16px;left:22px;display:flex;gap:8px;z-index:3}
.hero-slider .dot{width:10px;height:10px;border-radius:999px;border:0;background:rgba(255,255,255,.5);cursor:pointer;padding:0;transition:all .3s}
.hero-slider .dot.on{background:#fff;width:28px}
.hero-slider .arrow{position:absolute;top:50%;transform:translateY(-50%);width:44px;height:44px;border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.16);color:#fff;font-size:26px;line-height:1;cursor:pointer;z-index:3;display:flex;align-items:center;justify-content:center;padding:0 0 3px;transition:background .2s}
.hero-slider .arrow:hover{background:var(--red);border-color:var(--red)}
.hero-slider .nav-prev{right:14px}
.hero-slider .nav-next{left:14px}
.tag{display:inline-block;background:rgba(225,29,46,.1);color:var(--red);font-weight:bold;font-size:12.5px;padding:2px 13px;border-radius:999px;line-height:1.9}
.grid-news{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
.news-row{display:flex;flex-direction:column;background:var(--card);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;box-shadow:var(--shadow);transition:transform .25s,box-shadow .25s}
.news-row:hover{transform:translateY(-4px);box-shadow:0 14px 34px rgba(15,42,71,.16)}
.news-row-img{position:relative;aspect-ratio:16/9;overflow:hidden;background:var(--paper)}
.news-row-img img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.news-row:hover .news-row-img img{transform:scale(1.06)}
.chip{position:absolute;top:12px;right:12px;background:rgba(15,42,71,.85);color:#fff;font-size:11.5px;padding:1px 12px;border-radius:999px}
.ph{width:100%;height:100%;background:linear-gradient(135deg,#d8e1ee,#eef2f9);display:grid;place-items:center}
.ph:after{content:"خ";font-size:42px;font-weight:bold;color:#b2c0d6}
[data-theme="dark"] .ph{background:linear-gradient(135deg,#1c2a40,#223350)}
.news-row-txt{padding:14px 16px 16px;flex:1;display:flex;flex-direction:column;min-width:0}
.news-row-txt h3{margin:0 0 8px;font-size:17px;line-height:1.7;color:var(--ink);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.news-row:hover h3{color:var(--red)}
.news-row-txt p{margin:0 0 10px;font-size:13.5px;color:var(--muted);display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.news-row-txt .date{font-size:11.5px;color:var(--muted);margin-top:auto}
.grid-news .news-row:first-child{grid-column:1/-1;flex-direction:row}
.grid-news .news-row:first-child .news-row-img{width:46%;aspect-ratio:auto;min-height:270px;flex:none}
.grid-news .news-row:first-child .news-row-txt{padding:22px}
.grid-news .news-row:first-child h3{font-size:22px;-webkit-line-clamp:3}
.grid-news .news-row:first-child p{-webkit-line-clamp:4;font-size:14.5px}
.pager{display:flex;justify-content:space-between;align-items:center;margin-top:26px;font-size:14px;color:var(--muted)}
.pager a{background:var(--navy);color:#fff;padding:9px 22px;border-radius:999px;transition:background .2s}
.pager a:hover{background:var(--red)}
.empty{background:var(--card);border:1px dashed var(--line);border-radius:var(--r);padding:34px;text-align:center;color:var(--muted)}
.cats{margin-top:42px}
.cat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:20px}
.cat-block{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:16px;box-shadow:var(--shadow)}
.cat-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;padding-bottom:10px;border-bottom:2px solid var(--red)}
.cat-head h2{margin:0;font-size:17px}
.cat-head .more{font-size:12.5px;color:var(--muted)}
.cat-head .more:hover{color:var(--red)}
.cat-lead{display:block;position:relative;border-radius:10px;overflow:hidden;margin-bottom:10px;aspect-ratio:16/10;background:var(--paper)}
.cat-lead img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.cat-lead:hover img{transform:scale(1.06)}
.cat-lead .ph{position:absolute;inset:0}
.cat-lead h3{position:absolute;inset:auto 0 0 0;margin:0;padding:38px 12px 10px;font-size:14.5px;line-height:1.7;color:#fff;background:linear-gradient(transparent,rgba(5,12,24,.9))}
.cat-block ul{list-style:none;margin:0;padding:0}
.cat-block li{padding:7px 0;border-bottom:1px dashed var(--line);font-size:13.5px;line-height:1.75}
.cat-block li:last-child{border:0}
.cat-block li a:hover{color:var(--red)}
.article{background:var(--card);padding:34px;border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);min-width:0}
.article h1{font-size:30px;line-height:1.75;margin:10px 0 6px}
.lead{font-size:18px;color:var(--muted);margin:0 0 12px;border-right:4px solid var(--red);padding-right:14px;line-height:2}
.meta{display:flex;gap:16px;flex-wrap:wrap;font-size:12.5px;color:var(--muted);margin-bottom:18px;padding-bottom:14px;border-bottom:1px solid var(--line)}
.cover{width:100%;max-height:540px;object-fit:cover;border-radius:14px;margin-bottom:20px}
.inline-img{max-width:100%;border-radius:12px;margin:18px 0 8px;display:block}
.inline-cap{font-size:12.5px;color:var(--muted);text-align:center;margin-bottom:18px}
.body{font-size:18px;line-height:2.25}
.body p{margin:0 0 18px}
.body h2{font-size:23px;margin:30px 0 10px}
.body h3{font-size:19px;margin:22px 0 8px}
.body blockquote{margin:20px 0;padding:12px 20px;border-right:4px solid var(--red);background:var(--paper);color:var(--muted);border-radius:10px}
.body ul{margin:0 0 18px;padding-right:26px}
.body li{margin-bottom:4px}
.body a{color:var(--red);text-decoration:underline}
.body hr{border:0;border-top:1px solid var(--line);margin:26px 0}
.back{display:inline-block;color:var(--muted);margin:0 0 8px 10px;font-size:13.5px}
.back:hover{color:var(--red)}
.tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:20px}
.tags a{background:var(--paper);border:1px solid var(--line);padding:2px 14px;border-radius:999px;font-size:13px}
.tags a:hover{background:var(--navy);color:#fff;border-color:var(--navy)}
.article .tag{margin:0 0 0 6px}
.source{margin-top:22px;padding:12px 16px;background:var(--paper);border:1px solid var(--line);border-right:4px solid var(--navy);border-radius:10px;font-size:14px}
.source a{color:var(--red);font-weight:bold}
.share{margin-top:24px;padding-top:16px;border-top:1px solid var(--line);display:flex;gap:10px;align-items:center;flex-wrap:wrap;font-size:14px}
.share a{border:1px solid var(--line);padding:4px 16px;border-radius:999px;background:var(--paper)}
.share a:hover{background:var(--navy);color:#fff;border-color:var(--navy)}
.notice{background:#fff4d6;color:#4a3a00;border:1px solid #f0d58c;padding:12px 16px;border-radius:12px;margin-bottom:18px;font-size:14px}
.progress{position:fixed;top:0;left:0;right:0;height:3px;z-index:60}
.progress i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--red),#ff7885)}
.backtop{position:fixed;bottom:22px;left:22px;width:44px;height:44px;border-radius:50%;border:0;background:var(--red);color:#fff;font-size:20px;cursor:pointer;box-shadow:0 8px 20px rgba(225,29,46,.45);opacity:0;pointer-events:none;transform:translateY(10px);transition:all .25s;z-index:45}
.backtop.show{opacity:1;pointer-events:auto;transform:none}
.contact{list-style:none;padding:0;margin:20px 0 0}
.contact li{padding:9px 0;border-top:1px solid var(--line)}
.contact a{color:var(--red)}
.gallery-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;margin-top:20px}
.gallery-item{background:var(--card);border-radius:var(--r);overflow:hidden;border:1px solid var(--line);box-shadow:var(--shadow);transition:transform .25s}
.gallery-item:hover{transform:translateY(-3px)}
.gallery-item img{width:100%;height:160px;object-fit:cover;display:block}
.g-cap{padding:10px;font-size:13px;text-align:center}
.video-embed{margin:20px 0}
.video-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px}
.video-card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:10px;box-shadow:var(--shadow)}
.video-frame{position:relative;aspect-ratio:16/9;border-radius:10px;overflow:hidden;background:#000}
.video-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.video-play{position:absolute;inset:0;width:100%;height:100%;border:0;padding:0;cursor:pointer;background-color:#0b1a2b;background-size:cover;background-position:center}
.play-ico{position:absolute;left:50%;top:50%;width:64px;height:64px;margin:-32px 0 0 -32px;border-radius:50%;background:rgba(225,29,46,.94);box-shadow:0 4px 16px rgba(0,0,0,.45);transition:transform .2s}
.play-ico:after{content:"";position:absolute;left:25px;top:19px;border-style:solid;border-width:13px 0 13px 21px;border-color:transparent transparent transparent #fff}
.video-play:hover .play-ico{transform:scale(1.1)}
.video-card h3{margin:10px 4px 2px;font-size:15px;line-height:1.7}
.video-card .date{font-size:11px;color:var(--muted);margin:0 4px}
.footer{background:linear-gradient(160deg,#0a1d33,#0f2a47);color:#c3d0e0;padding:46px 0 0;font-size:13.5px}
.foot-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:34px;padding-bottom:32px}
.foot-brand p{margin:12px 0 0;max-width:380px;line-height:2}
.footer h4{color:#fff;font-size:15px;margin:0 0 12px}
.footer ul{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.footer a:hover{color:#fff}
.foot-social{display:flex;gap:10px;margin-top:14px;flex-wrap:wrap}
.foot-social a{border:1px solid #ffffff30;padding:3px 14px;border-radius:999px}
.foot-social a:hover{background:var(--red);border-color:var(--red)}
.foot-copy{border-top:1px solid #ffffff1a;padding:16px 0;font-size:12px;color:#8fa3bb;text-align:center}
@media(max-width:980px){.cols{grid-template-columns:1fr}.top-grid{grid-template-columns:1fr}.hero-slider{height:340px}.top-latest .side{height:auto;max-height:420px}.foot-grid{grid-template-columns:1fr 1fr}}
@media(max-width:700px){.wrap{padding:0 12px}.main{padding:18px 12px 38px}.head{padding:14px 0}.brand .name{font-size:23px}.search{width:100%}.search input{flex:1;width:auto;min-width:0}.grid-news{grid-template-columns:1fr}.grid-news .news-row:first-child{flex-direction:column}.grid-news .news-row:first-child .news-row-img{width:100%;aspect-ratio:16/9;min-height:0}.grid-news .news-row:first-child .news-row-txt{padding:14px 16px 16px}.grid-news .news-row:first-child h3{font-size:18px}.article{padding:18px}.article h1{font-size:23px}.body{font-size:16.5px}.slide-txt{padding:60px 16px 40px}.slide-txt h2{font-size:19px}.hero-slider{height:300px}.foot-grid{grid-template-columns:1fr}.clock{font-size:11px}.logoimg{height:42px}.hero-slider .arrow{display:none}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}html{scroll-behavior:auto}}
/* ---- بخش RSS ---- */
.rss-intro{max-width:820px;color:var(--muted);margin:-6px 0 20px;line-height:2}
.rss-intro a{color:var(--red);text-decoration:underline}
.rss-box{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:20px;box-shadow:var(--shadow);margin-bottom:20px}
.rss-box h2{font-size:18px;margin:0 0 8px}
.rss-box p{margin:0 0 10px}
.rss-main{display:flex;justify-content:space-between;align-items:center;gap:18px;flex-wrap:wrap;background:linear-gradient(120deg,var(--card),var(--paper))}
.rss-main-txt{display:flex;gap:16px;align-items:center;min-width:0}
.rss-bigico{font-size:38px;background:var(--navy);color:#fff;width:64px;height:64px;border-radius:18px;display:grid;place-items:center;flex:none}
.rss-main code{display:block;background:var(--paper);border:1px solid var(--line);border-radius:8px;padding:6px 10px;font-size:12.5px;overflow-wrap:anywhere;margin-top:8px;color:var(--ink)}
.rss-main-acts{display:flex;gap:10px;flex-wrap:wrap}
.btn-rss{display:inline-block;background:var(--red);color:#fff;border:1px solid var(--red);border-radius:999px;padding:8px 20px;font-size:14px;font-weight:bold;cursor:pointer;font-family:inherit;transition:background .2s,border-color .2s}
.btn-rss:hover{background:var(--red2);border-color:var(--red2);color:#fff}
.btn-rss.ghost{background:transparent;color:var(--red);border-color:var(--red)}
.btn-rss.ghost:hover{background:var(--red);color:#fff}
.rss-cats{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;margin-top:14px}
.rss-cat{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:12px;display:flex;flex-direction:column;gap:8px}
.rss-cat-link{display:flex;flex-direction:column;gap:2px}
.rss-cat-link b{font-size:15px}
.rss-cat-link small{color:var(--muted);font-size:11.5px}
.rss-cat-link:hover b{color:var(--red)}
.rss-cat-ico{font-size:20px}
.rss-copy{align-self:flex-start;background:var(--card);border:1px solid var(--line);border-radius:999px;padding:3px 12px;font-size:12px;cursor:pointer;font-family:inherit;color:var(--muted)}
.rss-copy:hover{border-color:var(--red);color:var(--red)}
.rss-two{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.rss-list{list-style:none;margin:0 0 12px;padding:0}
.rss-list li{padding:9px 0;border-bottom:1px dashed var(--line);font-size:14px;line-height:1.8}
.rss-list li:last-child{border:0}
.rss-list a:hover{color:var(--red)}
.rss-list time{display:block;color:var(--muted);font-size:11.5px}
.rss-how{margin:0 0 12px;padding-right:22px;color:var(--muted);font-size:14px;line-height:2}
.rss-more{color:var(--red);font-size:13px;font-weight:bold}
.rss-more:hover{text-decoration:underline}
.rss-strip{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;background:linear-gradient(120deg,var(--navy),var(--navy2));color:#fff;border-radius:18px;padding:22px 26px;margin-top:34px;box-shadow:0 14px 34px rgba(15,42,71,.2)}
.rss-strip-txt{display:flex;gap:16px;align-items:center;min-width:0}
.rss-strip h2{margin:0 0 4px;font-size:19px;color:#fff}

}

// عکس پوستر ویدیو: از آپارات/یوتیوب گرفته میشود
async function fetchVideoThumb(provider, id) {
  const ua = { "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36", "Accept-Language": "fa,en;q=0.8" };
  let imgUrl = "";
  if (provider === "youtube") imgUrl = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
  else {
    // ۱) چند آدرس API (جدید و قدیمی)
    const apis = [
      `https://www.aparat.com/api/fa/v1/video/video/show/videohash/${id}`,
      `https://www.aparat.com/etc/api/video/videohash/${id}`
    ];
    for (const a of apis) {
      try {
        const r = await fetch(a, { headers: ua });
        if (!r.ok) continue;
        const d = await r.json();
        const at = (d && d.data && d.data.attributes) || (d && d.video) || {};
        imgUrl = at.big_poster || at.small_poster || at.thumbnail_url || "";
        if (imgUrl) break;
      } catch (e) { }
    }
    // ۲) خواندن og:image یا poster از صفحه‌ی ویدیو و صفحه‌ی embed
    if (!imgUrl) {
      const pages = [`https://www.aparat.com/v/${id}`, `https://www.aparat.com/video/video/embed/videohash/${id}/vt/frame`];
      for (const pg of pages) {
        try {
          const r = await fetch(pg, { headers: ua });
          if (!r.ok) continue;
          const t = (await r.text()).slice(0, 400000);
          const m = t.match(/<meta[^>]+property=["']og:image["'][^>]+content=["']([^"']+)["']/i)
            || t.match(/<meta[^>]+content=["']([^"']+)["'][^>]+property=["']og:image["']/i)
            || t.match(/"(?:big_poster|small_poster|poster)"\s*:\s*"([^"]+)"/i);
          if (m) { imgUrl = m[1].replace(/&amp;/g, "&").replace(/\\\//g, "/"); break; }
        } catch (e) { }
      }
    }
  }
  if (!imgUrl) return null;
  let u; try { u = new URL(imgUrl); } catch { return null; }
  const h = u.hostname.toLowerCase();
  const okHost = provider === "youtube" ? h === "i.ytimg.com" : (h === "aparat.com" || h.endsWith(".aparat.com") || h.endsWith(".aparat.cloud"));
  if (u.protocol !== "https:" || !okHost) return null;
  const r = await fetch(u.toString(), { headers: ua });
  if (!r.ok) return null;
  const buf = await r.arrayBuffer();
  if (buf.byteLength > 2 * 1024 * 1024) return null;
  const t = sniffImage(buf);
  return t ? { buf, mime: t.mime } : null;
}
async function serveVideoThumb(url, ctx) {
  const m = url.pathname.match(/^\/vthumb\/(youtube|aparat)\/([A-Za-z0-9_-]{3,20})$/);
  if (!m) return new Response("Not found", { status: 404 });
  const provider = m[1], id = m[2];
  if (provider === "youtube" ? !/^[A-Za-z0-9_-]{11}$/.test(id) : !/^[A-Za-z0-9]{3,20}$/.test(id)) return new Response("Not found", { status: 404 });
  const cache = typeof caches !== "undefined" ? caches.default : null;
  const cacheKey = new Request(url.origin + url.pathname, { method: "GET" });
  if (cache) { try { const hit = await cache.match(cacheKey); if (hit) return hit; } catch (e) { } }
  let res = null;
  try {
    const img = await fetchVideoThumb(provider, id);
    if (img) res = new Response(img.buf, { headers: { "Content-Type": img.mime, "Cache-Control": "public, max-age=604800", "X-Content-Type-Options": "nosniff" } });
  } catch (e) { console.error("video thumb failed", e); }
  if (!res) res = new Response("Not found", { status: 404, headers: { "Cache-Control": "public, max-age=300" } });
  if (cache) ctx.waitUntil(cache.put(cacheKey, res.clone()).catch(() => { }));
  return res;
}

// ------------------------------ فید RSS (XML) ------------------------------
// فید صفحه اصلی: /rss.xml?featured=1
// فید اصلی: /rss.xml
// فید دسته: /rss.xml?category=اهواز   فید برچسب: /rss.xml?tag=ورزش
async function rss(env, origin, url) {
  const catIn = String(url?.searchParams.get("category") || "");
  const cat = CATEGORIES.includes(catIn) ? catIn : "";
  const tag = String(url?.searchParams.get("tag") || "").replace(/[%_\\,]/g, "").trim().slice(0, 30);
  const feat = !cat && !tag && String(url?.searchParams.get("featured") || "") === "1";
  let where = PUB; const binds = [nowIso()];
  if (cat) { where += " AND (category=? OR categories LIKE ?)"; binds.push(cat, "%," + cat + ",%"); }
  if (tag) { where += " AND tags LIKE ?"; binds.push("%," + tag + ",%"); }
  if (feat) { where += " AND featured=1"; }
  const r = await env.DB.prepare(
    `SELECT id,title,summary,category,published_at FROM news WHERE ${where} ORDER BY published_at DESC LIMIT 30`
  ).bind(...binds).all();
  const rows = r.results || [];
  const chanTitle = cat ? `${SITE_NAME} — اخبار ${cat}` : tag ? `${SITE_NAME} — برچسب ${tag}` : feat ? `${SITE_NAME} — صفحه اصلی (خبرهای ویژه)` : SITE_NAME;
  const chanDesc = cat ? `تازهترین خبرهای ${cat} از ${SITE_NAME}` : tag ? `خبرهای برچسب ${tag} از ${SITE_NAME}` : feat ? `خبرهای ویژه و اسلایدر صفحه اصلی ${SITE_NAME}` : "رسانه خبری استان خوزستان";
  const qs = cat ? "?category=" + encodeURIComponent(cat) : tag ? "?tag=" + encodeURIComponent(tag) : feat ? "?featured=1" : "";
  const self = origin + "/rss.xml" + qs;
  const chanLink = cat ? origin + "/category/" + encodeURIComponent(cat) : tag ? origin + "/tag/" + encodeURIComponent(tag) : origin;
  const items = rows.map(n => `<item><title>${esc(n.title)}</title><link>${origin}/news/${esc(n.id)}</link><guid isPermaLink="true">${origin}/news/${esc(n.id)}</guid><pubDate>${new Date(n.published_at).toUTCString()}</pubDate><category>${esc(n.category)}</category><description>${esc(n.summary)}</description></item>`).join("");
  const lastBuild = new Date(rows[0]?.published_at || Date.now()).toUTCString();
  return new Response(`<?xml version="1.0" encoding="UTF-8"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>${esc(chanTitle)}</title><link>${esc(chanLink)}</link><atom:link href="${esc(self)}" rel="self" type="application/rss+xml"/><description>${esc(chanDesc)}</description><language>fa</language><lastBuildDate>${lastBuild}</lastBuildDate>${items}</channel></rss>`,
    { headers: { "Content-Type": "application/rss+xml; charset=utf-8", "Cache-Control": "public, max-age=300", "X-Content-Type-Options": "nosniff" } });
}


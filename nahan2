  const pager = (page > 1 || hasNext) ? `<nav class="pager">${hasNext ? `<a href="${href(page + 1)}">خبرهای قدیمیتر</a>` : "<span></span>"}<span>صفحه ${page.toLocaleString("fa-IR")}</span>${page > 1 ? `<a href="${href(page - 1)}">خبرهای جدیدتر</a>` : "<span></span>"}</nav>` : "";

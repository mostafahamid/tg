const WX_CITIES = [
  { n: "اهواز", lat: 31.3183, lon: 48.6706 },
  { n: "آبادان", lat: 30.3392, lon: 48.3043 },
  { n: "خرمشهر", lat: 30.4256, lon: 48.1916 },
  { n: "دزفول", lat: 32.3830, lon: 48.4058 },
  { n: "ماهشهر", lat: 30.5592, lon: 49.1983 },
  { n: "شوشتر", lat: 32.0451, lon: 48.8564 }
];
const WX_TTL = 15 * 60 * 1000;
let WX_MEM = { t: 0, v: null };

function wxInfo(code) {
  if (code === 0) return { e: "☀️", t: "صاف" };
  if (code <= 2) return { e: "🌤️", t: "نیمهابری" };
  if (code === 3) return { e: "☁️", t: "ابری" };
  if (code === 45 || code === 48) return { e: "🌫️", t: "مهآلود" };
  if (code >= 51 && code <= 57) return { e: "🌦️", t: "نمنم باران" };
  if ((code >= 61 && code <= 67) || (code >= 80 && code <= 82)) return { e: "🌧️", t: "بارانی" };
  if ((code >= 71 && code <= 77) || code === 85 || code === 86) return { e: "❄️", t: "برفی" };
  if (code >= 95) return { e: "⛈️", t: "رعدوبرق" };
  return { e: "🌡️", t: "—" };
}
async function getWeather() {
  if (WX_MEM.v && Date.now() - WX_MEM.t < WX_TTL) return WX_MEM.v;
  try {
    const u = "https://api.open-meteo.com/v1/forecast?latitude=" + WX_CITIES.map(c => c.lat).join(",") +
      "&longitude=" + WX_CITIES.map(c => c.lon).join(",") +
      "&current=temperature_2m,weather_code&timezone=Asia%2FTehran";
    const r = await fetch(u, { signal: AbortSignal.timeout(3000) });
    if (!r.ok) throw new Error("weather status " + r.status);
    const d = await r.json();
    const arr = Array.isArray(d) ? d : [d];
    const v = arr.map((x, i) => (x && x.current && WX_CITIES[i]) ? { n: WX_CITIES[i].n, t: x.current.temperature_2m, code: x.current.weather_code } : null).filter(Boolean);
    if (!v.length) throw new Error("weather empty");
    WX_MEM = { t: Date.now(), v };
    return v;
  } catch (e) {
    console.error("weather failed", e);
    // اگر خطا شد، تا یک دقیقه دوباره تلاش نمیکند تا صفحهها کند نشوند
    WX_MEM = { t: Date.now() - WX_TTL + 60000, v: WX_MEM.v };
    return WX_MEM.v;
  }
}
function weatherBlock(list) {
  if (!list || !list.length) return "";
  const rows = list.map(w => {
    const i = wxInfo(w.code);
    return `<li><span class="wx-city">${esc(w.n)}</span><span class="wx-desc">${i.e} ${esc(i.t)}</span><b class="wx-temp" dir="ltr">${Math.round(w.t).toLocaleString("fa-IR")}°</b></li>`;
  }).join("");
  return `<aside class="side wx"><h2>آبوهوای شهرهای استان</h2><ul>${rows}</ul><small class="muted">دما به سانتیگراد · منبع: Open-Meteo</small></aside>`;
}

// بنر «بخش RSS» که زیر بلوک شهرها در صفحه‌ی اصلی نشان داده میشود
function rssStrip() {
  return `<section class="rss-strip"><div class="rss-strip-txt"><span class="rss-ico" aria-hidden="true">📡</span><div><h2>خبرهای ${SITE_NAME} را دنبال کنید</h2><p>با فید RSS، تازهترین خبرها همان لحظه‌ی انتشار به نرمافزار خبرخوانتان میرسد؛ برای هر شهر و هر دسته هم فید جداگانهای داریم.</p></div></div><div class="rss-strip-acts"><a class="btn-rss" href="/rss">همه‌ی فیدها</a><a class="btn-rss ghost" href="/rss.xml">دریافت فید اصلی</a></div></section>`;
}
// بلوک «از منابع خبری» در صفحه‌ی اصلی: آخرین ۶ خبر منتشرشده‌ای که از RSS آمدهاند
function rssHomeBlock(rows) {
  const list = (rows || []).slice(0, 6);
  if (!list.length) return "";
  const cards = list.map(n => {
    const th = thumbOf(n);
    return `<a class="rss-home-item" href="/news/${esc(n.id)}"><div class="rss-home-img">${th ? `<img loading="lazy" src="${esc(th)}" alt="">` : `<div class="ph" aria-hidden="true"></div>`}<span class="rss-home-badge">${esc(n.category)}</span></div><h3>${esc(n.title)}</h3><span class="date">${esc(fmtDate(n.published_at))}</span></a>`;
  }).join("");
  return `<section class="rss-home"><div class="sectionhead"><h2>📡 از منابع خبری</h2><a class="more" href="/rss/news">همه‌ی خبرها ‹</a></div><div class="rss-home-grid">${cards}</div></section>`;
}

async function listPage(c, { category, q, tag = "" }) {
  const page = Math.max(1, Math.min(1000, parseInt(c.url.searchParams.get("page")) || 1));
  const { items, hasNext } = await listNews(c.env, { category, q, tag, page });
  const now = nowIso();
  const since = new Date(Date.now() - 30 * 86400000).toISOString();
  const home = !category && !q && !tag && page === 1;
  const [feat, pop, lat, rss] = await c.env.DB.batch([
    c.env.DB.prepare(`SELECT ${COLS} FROM news WHERE ${PUB} AND featured=1 ORDER BY published_at DESC LIMIT 6`).bind(now),
    c.env.DB.prepare(`SELECT id,title,views FROM news WHERE ${PUB} AND published_at>=? ORDER BY views DESC LIMIT 5`).bind(now, since),
    c.env.DB.prepare(`SELECT id,title,published_at FROM news WHERE ${PUB} ORDER BY published_at DESC LIMIT 15`).bind(now),
    c.env.DB.prepare(`SELECT ${COLS} FROM news WHERE ${PUB} AND COALESCE(source_url,'')!='' ORDER BY published_at DESC LIMIT 6`).bind(now)
  ]);
  const rssHome = home ? rssHomeBlock(rss.results || []) : "";
  const wxHtml = weatherBlock(await getWeather());
  const featured = home ? (feat.results || []) : [];
  let catRows = [];
  if (home) {
    try {
      catRows = (await c.env.DB.prepare(`SELECT ${COLS} FROM (SELECT ${COLS}, ROW_NUMBER() OVER (PARTITION BY category ORDER BY published_at DESC) AS rn FROM news WHERE ${PUB}) WHERE rn<=4 ORDER BY published_at DESC`).bind(now).all()).results || [];
    } catch (e) { console.error("cat blocks failed", e); }
  }
  const base = category ? "/category/" + encodeURIComponent(category) : tag ? "/tag/" + encodeURIComponent(tag) : q ? "/search" : "/";
  const href = p => { const a = []; if (q) a.push("q=" + encodeURIComponent(q)); if (p > 1) a.push("page=" + p); return base + (a.length ? "?" + a.join("&") : ""); };
  const heading = q ? `نتایج جستجو برای «${q}»` : tag ? `برچسب: ${tag}` : category ? `اخبار ${category}` : "آخرین اخبار خوزستان";

  // لینک فید اختصاصی همین صفحه (دسته / برچسب / اصلی)
  const feedPath = category ? "/rss.xml?category=" + encodeURIComponent(category) : tag ? "/rss.xml?tag=" + encodeURIComponent(tag) : "/rss.xml";
  const feedHint = (category || tag)
    ? `<a class="feedhint" href="${feedPath}">📡 فید RSS ${category ? esc(category) : "این برچسب"}</a>`
    : "";

  const hero = featured.length ? buildSlider(featured) : "";
  const list = items.length ? `<div class="grid-news">${items.map(newsRow).join("")}</div>` : `<div class="empty">${q ? "خبری با این عبارت پیدا نشد." : "هنوز خبری در این بخش منتشر نشده است."}</div>`;
  const pager = (page > 1 || hasNext) ? `<nav class="pager">${hasNext ? `<a href="${href(page + 1)}">خبرهای قدیمیتر</a>` : "<span></span>"}<span>صفحه ${page.toLocaleString("fa-IR")}</span>${page > 1 ? `<a href="${href(page - 1)}">خبرهای جدیدتر</a>` : "<span></span>"}</nav>` : "";
  const popular = (pop.results || []).length ? `<aside class="side"><h2>پربازدیدترینها</h2><ol class="rank">${pop.results.map(n => `<li><a href="/news/${esc(n.id)}">${esc(n.title)}</a></li>`).join("")}</ol></aside>` : "";

  const mainCol = `<div class="main-col"><div class="sectionhead"><h1>${esc(heading)}</h1>${feedHint}</div>${list}${pager}</div>`;
  let body;
  if (home) {
    // بخش بالا: اسلایدر ویژهها (راست، ۲/۳) + آخرین اخبار به ترتیب انتشار (چپ، ۱/۳)
    const topSection = `<section class="top-grid${hero ? "" : " no-slider"}">${hero ? `<div class="top-slider">${hero}</div>` : ""}<div class="top-latest">${latestBlock(lat.results || [])}</div></section>`;
    const side = wxHtml + popular;
    body = `${topSection}<div class="cols${side ? "" : " one"}">${mainCol}${side ? `<div class="sidecol">${side}</div>` : ""}</div>${catSections(catRows)}${rssHome}${rssStrip()}`;
  } else {
    body = `<div class="cols">${mainCol}<div class="sidecol">${latestBlock(lat.results || [])}${wxHtml}${popular}</div></div>`;
  }

  return layout(c, {
    title: home ? `${SITE_NAME} | رسانه خبری خوزستان` : `${heading} | ${SITE_NAME}`,
    desc: "آخرین اخبار خوزستان، اهواز و شهرهای استان", path: href(page), active: category, q, body,
    noindex: !!q, ttl: q ? 30 : LIST_CACHE_TTL, rssUrl: feedPath
  });
}

// ------------------------------ نمایش متن خبر (قالببندی ساده) ------------------------------
// **پررنگ**  *کج*  [متن](https://لینک)  ## زیرتیتر  ### زیرتیتر کوچک  > نقلقول  - لیست  ---
// همهچیز ابتدا escape میشود، پس هیچ HTML خامی از ورودی راه پیدا نمیکند.
function inlineFmt(raw) {
  return esc(raw)
    .replace(/\[([^\]\n]+)\]\((https?:\/\/[^\s)*]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>')
    .replace(/\*\*([^*\n]+)\*\*/g, "<strong>$1</strong>")
    .replace(/(^|[^*])\*([^*\n]+)\*/g, "$1<em>$2</em>");
}
function blockHtml(p, posters) {
  if (p === "---") return "<hr>";
  // پاراگرافی که فقط یک لینک آپارات یا یوتیوب باشد، به پلیر تبدیل میشود
  if (/^https?:\/\/\S+$/.test(p)) {
    const pv = parseVideoUrl(p);
    if (pv) return videoEmbedHtml({ ...pv, poster_key: (posters && posters[pv.provider + ":" + pv.video_id]) || "" });
  }
  if (p.startsWith("### ")) return `<h3>${inlineFmt(p.slice(4))}</h3>`;
  if (p.startsWith("## ")) return `<h2>${inlineFmt(p.slice(3))}</h2>`;
  const lines = p.split("\n");
  if (lines.every(l => /^>\s?/.test(l))) return `<blockquote>${lines.map(l => inlineFmt(l.replace(/^>\s?/, ""))).join("\n")}</blockquote>`;
  if (lines.every(l => /^-\s+/.test(l))) return `<ul>${lines.map(l => `<li>${inlineFmt(l.replace(/^-\s+/, ""))}</li>`).join("")}</ul>`;
  return `<p>${lines.map(inlineFmt).join("\n")}</p>`;
}

async function articlePage(c, id, ctx) {
  const admin = await isAdmin(c.request, c.env);
  const previewer = !admin && await previewOk(c.env, id, c.url.searchParams.get("preview"));
  const a = await c.env.DB.prepare("SELECT * FROM news WHERE id=?").bind(id).first();
  const live = a && a.status === "published" && a.published_at <= nowIso();
  if (!a || (!live && !admin && !previewer)) return notFound(c);
  if (live && !admin && !previewer) countView(c.env, ctx, c.request, id);
  const rel = (await c.env.DB.prepare(`SELECT ${COLS} FROM news WHERE ${PUB} AND category=? AND id!=? ORDER BY published_at DESC LIMIT 4`).bind(nowIso(), a.category, id).all()).results || [];
  const lat = (await c.env.DB.prepare(`SELECT id,title,published_at FROM news WHERE ${PUB} ORDER BY published_at DESC LIMIT 15`).bind(nowIso()).all()).results || [];
  const link = `${c.origin}/news/${a.id}`;
  const t = encodeURIComponent(a.title), u = encodeURIComponent(link);

  let bodyImages = [];
  try { bodyImages = JSON.parse(a.body_images || '[]'); } catch (e) {}
  if (!Array.isArray(bodyImages)) bodyImages = [];
  bodyImages = bodyImages.filter(x => x && typeof x.image_key === "string" && KEY_RE.test(x.image_key));

  const blocks = String(a.body).split(/\n{2,}/).map(p => p.trim()).filter(Boolean);

  // پوستر ذخیرهشده‌ی ویدیوهایی که داخل متن گذاشته شدهاند
  const posters = {};
  const vids = blocks.map(p => /^https?:\/\/\S+$/.test(p) ? parseVideoUrl(p) : null).filter(Boolean);
  if (vids.length) {
    try {
      const ids = [...new Set(vids.map(v => v.video_id))].slice(0, 20);
      const r = await c.env.DB.prepare(`SELECT provider,video_id,poster_key FROM videos WHERE poster_key!='' AND video_id IN (${ids.map(() => "?").join(",")})`).bind(...ids).all();
      for (const x of r.results || []) posters[x.provider + ":" + x.video_id] = x.poster_key;
    } catch (e) { console.error("posters lookup failed", e); }
  }

  let imageIndex = 0;
  let paragraphsHtml = blocks.map((p, index) => {
    let html = blockHtml(p, posters);
    if (imageIndex < bodyImages.length && (index + 1) % 2 === 0) {
      const img = bodyImages[imageIndex];
      html += `<img class="inline-img" loading="lazy" src="${imgSrc(img.image_key)}" alt="${esc(img.caption || "")}">`;
      if (img.caption) html += `<div class="inline-cap">${esc(img.caption)}</div>`;
      imageIndex++;
    }
    return html;
  }).join("");

  while (imageIndex < bodyImages.length) {
    const img = bodyImages[imageIndex];
    paragraphsHtml += `<img class="inline-img" loading="lazy" src="${imgSrc(img.image_key)}" alt="${esc(img.caption || "")}">`;
    if (img.caption) paragraphsHtml += `<div class="inline-cap">${esc(img.caption)}</div>`;
    imageIndex++;
  }

  const hasVideo = paragraphsHtml.includes('class="video-embed"');
  const tags = tagList(a.tags);
  const cover = a.image_key ? c.origin + imgSrc(a.image_key) : (a.thumb ? c.origin + a.thumb : "");
  const ld = JSON.stringify({
    "@context": "https://schema.org", "@type": "NewsArticle", headline: a.title, description: a.summary, keywords: tags.length ? tags.join(", ") : undefined,
    datePublished: a.published_at, dateModified: a.updated_at || a.published_at,
    image: cover ? [cover] : undefined,
    author: { "@type": "Organization", name: SITE_NAME }, publisher: { "@type": "Organization", name: SITE_NAME }, mainEntityOfPage: link
  }).replace(/</g, "\\u003c");

  const mainImage = a.image_key ? `<img class="cover" src="${imgSrc(a.image_key)}" alt="${esc(a.title)}">` : "";
  // برای خبرهای RSS که متن با همان خلاصه شروع میشود، خلاصه جداگانه نمایش داده نمیشود
  const sumCore = String(a.summary || "").replace(/…$/, "").replace(/\s+/g, " ").trim();
  const bodyStart = String(a.body || "").replace(/\s+/g, " ").trim();
  const dupLead = !!(sumCore && bodyStart.startsWith(sumCore.slice(0, Math.min(sumCore.length, 60))));
  // شمارنده‌ی تعداد بازدید فقط برای ادمین است؛ مخاطب عادی (و لینک پیشنمایش) آن را نمیبیند
  let articleContent = `<a class="back" href="/">بازگشت به صفحه اصلی</a>${catsOf(a).map(x => `<a class="tag" href="/category/${encodeURIComponent(x)}">${esc(x)}</a>`).join(" ")}<h1>${esc(a.title)}</h1>${(a.summary && !dupLead) ? `<p class="lead">${esc(a.summary)}</p>` : ""}<div class="meta"><span>${esc(fmtDate(a.published_at))}</span>${a.author ? `<span>${esc(a.author)}</span>` : ""}${admin ? `<span>${Number(a.views || 0).toLocaleString("fa-IR")} بازدید</span>` : ""}</div>`;

  if (a.image_position === "bottom") {
    articleContent += `<div class="body">${paragraphsHtml}</div>${mainImage}`;
  } else {
    articleContent += `${mainImage}<div class="body">${paragraphsHtml}</div>`;
  }

  // نام و لینک منبع RSS عمداً در صفحه نمایش داده نمیشود
  if (tags.length) articleContent += `<div class="tags">${tags.map(t => `<a href="/tag/${encodeURIComponent(t)}">#${esc(t)}</a>`).join("")}</div>`;
  articleContent += `<div class="share"><b>اشتراکگذاری:</b><a target="_blank" rel="noopener noreferrer" href="https://t.me/share/url?url=${u}&text=${t}">تلگرام</a><a target="_blank" rel="noopener noreferrer" href="https://wa.me/?text=${t}%20${u}">واتساپ</a><a target="_blank" rel="noopener noreferrer" href="https://twitter.com/intent/tweet?text=${t}&url=${u}">ایکس</a></div>`;

  const body = `${!live ? `<div class="notice">این خبر هنوز منتشر نشده است؛ فقط مدیر و دارندگان لینک پیشنمایش آن را میبینند.</div>` : ""}
<div class="cols"><article class="article">${articleContent}</article>
<div class="sidecol">${latestBlock(lat)}<aside class="side"><h2>خبرهای مرتبط</h2>${rel.length ? `<ol>${rel.map(n => `<li><a href="/news/${esc(n.id)}">${esc(n.title)}</a></li>`).join("")}</ol>` : "<p class=\"muted\">خبر مرتبطی نیست.</p>"}</aside></div></div>`;
  return layout(c, {
    title: `${a.title} | ${SITE_NAME}`, desc: a.summary || a.title, path: "/news/" + a.id, active: a.category, body,
    image: cover, type: "article", noindex: !live,
    extraHead: `<script type="application/ld+json">${ld}</script>`, nocache: !live || admin || previewer, frames: hasVideo
  });
}

function notFound(c) {
  return layout(c, { title: `پیدا نشد | ${SITE_NAME}`, path: c.url.pathname, noindex: true, status: 404, body: `<div class="empty" style="margin:40px 0">این صفحه پیدا نشد. <a class="back" href="/">بازگشت به صفحه اصلی</a></div>` });
}


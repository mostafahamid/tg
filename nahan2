    views: (by.published?.v || 0) + (by.draft?.v || 0), top: top.results || [], latest: latest.results || []
  });
}

// ------------------------------ سایت عمومی ------------------------------
// صفحه اصلی، دستهبندیها، صفحههای RSS و همه‌ی عکسها در کش لبه‌ی Cloudflare نگه داشته میشوند
async function handlePublic(request, env, url, ctx) {
  const path = url.pathname;

  if (path.startsWith("/media/") && request.method === "GET") return serveMedia(request, env, url, ctx);
  if (path.startsWith("/vthumb/") && request.method === "GET") return serveVideoThumb(url, ctx);

  const cacheable =
    request.method === "GET" &&
    (path === "/" || path.startsWith("/category/") || path.startsWith("/tag/") || path === "/rss" || path === "/rss/" || path === "/rss/news") &&
    [...url.searchParams.keys()].every(k => k === "page");

  if (cacheable && typeof caches !== "undefined" && caches.default) {
    const key = new Request(url.origin + path + url.search, { method: "GET" });
    try {
      const hit = await caches.default.match(key);
      if (hit) {
        const h = new Headers(hit.headers);
        h.set("X-Cache", "HIT");
        return new Response(hit.body, { status: hit.status, headers: h });
      }
    } catch (e) { console.error("cache match failed", e); }
    const res = await renderPublic(request, env, url, ctx);
    if (res.status === 200) {
      ctx.waitUntil(caches.default.put(key, res.clone()).catch(e => console.error("cache put failed", e)));
      res.headers.set("X-Cache", "MISS");
    }
    return res;
  }
  return renderPublic(request, env, url, ctx);
}

// عکسها: اول ETag مرورگر، بعد کش لبه، و فقط در آخر D1
async function serveMedia(request, env, url, ctx) {
  const key = safeDecode(url.pathname.slice(7));
  if (!KEY_RE.test(key)) return new Response("Not found", { status: 404 });
  const etag = `"${key}"`;
  const h = new Headers({ "etag": etag, "Cache-Control": "public, max-age=31536000, immutable", "X-Content-Type-Options": "nosniff" });
  if (request.headers.get("If-None-Match") === etag) return new Response(null, { status: 304, headers: h });

  const cache = typeof caches !== "undefined" ? caches.default : null;
  const cacheKey = new Request(url.origin + "/media/" + encodeURIComponent(key), { method: "GET" });
  if (cache) {
    try {
      const hit = await cache.match(cacheKey);
      if (hit) {
        const hh = new Headers(hit.headers);
        hh.set("X-Cache", "HIT");
        return new Response(hit.body, { status: hit.status, headers: hh });
      }
    } catch (e) { console.error("media cache match failed", e); }
  }

  const row = await env.DB.prepare("SELECT mime,data FROM media WHERE key=?").bind(key).first();
  if (!row) return new Response("Not found", { status: 404 });
  h.set("Content-Type", row.mime);
  h.set("X-Cache", "MISS");
  const res = new Response(fromBase64(row.data), { headers: h });
  if (cache) ctx.waitUntil(cache.put(cacheKey, res.clone()).catch(e => console.error("media cache put failed", e)));
  return res;
}

async function renderPublic(request, env, url, ctx) {
  const path = url.pathname;
  if (path === "/health") return json({ ok: true, service: SITE_NAME });
  if (request.method !== "GET" && request.method !== "HEAD") return new Response("Method not allowed", { status: 405 });
  const origin = (env.SITE_URL || url.origin).replace(/\/+$/, "");

  if (path === "/robots.txt") {
    return new Response(`User-agent: *\nAllow: /\nDisallow: /admin\nSitemap: ${origin}/sitemap.xml\n`, { headers: { "Content-Type": "text/plain; charset=utf-8" } });
  }
  if (path.startsWith("/media/")) return serveMedia(request, env, url, ctx);
  if (path === "/api/news") {
    const page = Math.max(1, Math.min(1000, parseInt(url.searchParams.get("page")) || 1));
    const cat = url.searchParams.get("category");
    const r = await listNews(env, { category: CATEGORIES.includes(cat) ? cat : "", q: "", page });
    return json({ news: r.items, page, hasNext: r.hasNext, categories: CATEGORIES }, 200, { "Cache-Control": "public, max-age=60" });
  }
  let m = path.match(/^\/api\/news\/([a-zA-Z0-9-]+)$/);
  if (m) {
    const a = await env.DB.prepare(`SELECT id,title,summary,body,category,image_key,published_at FROM news WHERE id=? AND ${PUB}`).bind(m[1], nowIso()).first();
    return a ? json({ news: a }, 200, { "Cache-Control": "public, max-age=60" }) : json({ error: "خبر پیدا نشد" }, 404);
  }
  if (path === "/rss.xml") return rss(env, origin, url);
  if (path === "/sitemap.xml") return sitemap(env, origin);

  const c = { env, url, origin, request, settings: await getSettings(env) };
  // ---- بخش RSS سایت ----
  if (path === "/rss" || path === "/rss/") return rssPage(c);
  if (path === "/rss/news") return rssNewsPage(c);
  if (path === "/") return listPage(c, { category: "", q: "" });
  if (path === "/contact") return contactPage(c);
  if (path === "/gallery") return galleryPage(c);
  if (path === "/videos") return videosPage(c);
  m = path.match(/^\/category\/(.+?)\/?$/);
  if (m) {
    const cat = safeDecode(m[1]);
    return CATEGORIES.includes(cat) ? listPage(c, { category: cat, q: "" }) : notFound(c);
  }
  m = path.match(/^\/tag\/(.+?)\/?$/);
  if (m) {
    const tg = safeDecode(m[1]).replace(/[%_\\,]/g, "").trim().slice(0, 30);
    return tg ? listPage(c, { category: "", q: "", tag: tg }) : notFound(c);
  }
  if (path === "/search") return listPage(c, { category: "", q: (url.searchParams.get("q") || "").trim().slice(0, 60) });
  m = path.match(/^\/news\/([a-zA-Z0-9-]+)\/?$/);
  if (m) return articlePage(c, m[1], ctx);
  return notFound(c);
}

async function listNews(env, { category, q, tag = "", page }) {
  let where = PUB; const binds = [nowIso()];
  if (category) { where += " AND (category=? OR categories LIKE ?)"; binds.push(category, "%," + category + ",%"); }
  if (q) {
    where += " AND (title LIKE ? ESCAPE '\\' OR summary LIKE ? ESCAPE '\\')";
    const like = "%" + q.replace(/[\\%_]/g, m => "\\" + m) + "%";
    binds.push(like, like);
  }
  if (tag) { where += " AND tags LIKE ?"; binds.push("%," + tag + ",%"); }
  const r = await env.DB.prepare(`SELECT ${COLS} FROM news WHERE ${where} ORDER BY published_at DESC LIMIT ? OFFSET ?`)
    .bind(...binds, PAGE_SIZE + 1, (page - 1) * PAGE_SIZE).all();
  const list = r.results || [];
  return { items: list.slice(0, PAGE_SIZE), hasNext: list.length > PAGE_SIZE };
}


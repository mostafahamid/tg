  };
  const mainRows = [
    feedRow("فید آخرین اخبار", "همه‌ی خبرهای منتشرشده، به ترتیب انتشار (۳۰ خبر آخر)", "/rss.xml"),
    feedRow("فید صفحه اصلی", "فقط خبرهای ویژه و اسلایدر صفحه اصلی", "/rss.xml?featured=1")
  ].join("");
  const catRows = CATEGORIES.map(x => feedRow("فید " + x, "", "/rss.xml?category=" + encodeURIComponent(x))).join("");
  const tagPath = "/rss.xml?tag=" + encodeURIComponent("انتخابات");

  const [latest, fromFeeds] = await Promise.all([
    c.env.DB.prepare(`SELECT id,title,published_at FROM news WHERE ${PUB} ORDER BY published_at DESC LIMIT 8`).bind(nowIso()).all(),
    c.env.DB.prepare(`SELECT id,title FROM news WHERE ${PUB} AND COALESCE(source_url,'')!='' ORDER BY published_at DESC LIMIT 5`).bind(nowIso()).all()

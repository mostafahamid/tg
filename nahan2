function pInline(raw){
 return esc(raw)
  .replace(/\[([^\]\n]+)\]\((https?:\/\/[^\s)*]+)\)/g,'<a href="$2">$1</a>')
  .replace(/\*\*([^*\n]+)\*\*/g,'<strong>$1</strong>')
  .replace(/(^|[^*])\*([^*\n]+)\*/g,'$1<em>$2</em>');
}
function pVideoKind(p){
 if(!/^https?:\/\/\S+$/.test(p))return '';
 try{var u=new URL(p);var h=u.hostname.replace(/^(www|m)\./,'');
  if(h==='youtu.be'||h==='youtube.com'||h==='youtube-nocookie.com')return 'یوتیوب';
  if(h==='aparat.com')return 'آپارات'}catch(e){}
 return '';
}
function pBlock(p){
 if(p==='---')return '<hr>';
 var vk=pVideoKind(p);if(vk)return '<div class="pvideo">▶ ویدیوی '+vk+' (در سایت پوستر و دکمه‌ی پخش نمایش داده میشود)</div>';
 if(p.indexOf('### ')===0)return '<h3>'+pInline(p.slice(4))+'</h3>';
 if(p.indexOf('## ')===0)return '<h2>'+pInline(p.slice(3))+'</h2>';
 var ls=p.split('\n');
 if(ls.every(function(l){return /^>\s?/.test(l)}))return '<blockquote>'+ls.map(function(l){return pInline(l.replace(/^>\s?/,''))}).join('\n')+'</blockquote>';
 if(ls.every(function(l){return /^-\s+/.test(l)}))return '<ul>'+ls.map(function(l){return '<li>'+pInline(l.replace(/^-\s+/,''))+'</li>'}).join('')+'</ul>';

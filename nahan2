// ------------------------------ ارسال خودکار به کانال تلگرام ------------------------------
// نیاز به متغیر TELEGRAM_CHANNEL_ID (مثلاً @khuzkhabar یا -100123...) و ادمین بودن ربات در کانال
function tgEsc(s) {
  return String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}
// نام کانال که ته هر پست کانال، یک خط پایینتر از همه‌ی متنها نوشته میشود.
// اگر TELEGRAM_CHANNEL_ID نام کاربری باشد (مثل khouz_khabar) همان استفاده میشود؛
// اگر شناسه‌ی عددی باشد (۱۰۰-…)، همین مقدار پایین پست میآید.
const TG_CHANNEL_HANDLE = "@khouz_khabar";
function channelHandle(env) {
  const raw = String(env.TELEGRAM_CHANNEL_ID || "").trim()
    .replace(/^https?:\/\/t\.me\//i, "").replace(/^@/, "").replace(/\/+$/, "");
  return /^[A-Za-z][A-Za-z0-9_]{3,}$/.test(raw) ? "@" + raw : TG_CHANNEL_HANDLE;
}

async function postToChannel(env, n, origin) {
  try {
    if (!env.TELEGRAM_CHANNEL_ID || !env.TELEGRAM_BOT_TOKEN) return;
    // مقدار میتواند khouz_khabar یا @khouz_khabar یا لینک t.me یا شناسه‌ی عددی (-100...) باشد
    let ch = String(env.TELEGRAM_CHANNEL_ID).trim().replace(/^https?:\/\/t\.me\//i, "").replace(/\/+$/, "");
    if (/^[A-Za-z][A-Za-z0-9_]{3,}$/.test(ch)) ch = "@" + ch;
    const site = (env.SITE_URL || origin || "").replace(/\/+$/, "");
    const link = site ? `${site}/news/${n.id}` : "";
    const sum = n.summary ? "\n\n" + tgEsc(String(n.summary).slice(0, 500)) : "";
    // امضای کانال: یک خط خالی بعد از همه‌ی متن، بعد نام کانال
    const sign = channelHandle(env) ? "\n\n" + channelHandle(env) : "";
    const tail = link ? `\n\n🔗 <a href="${link}">ادامه خبر در سایت ${SITE_NAME}</a>` : "";
    let caption = `📰 <b>${tgEsc(n.title)}</b>${sum}${tail}${sign}`;
    // کپشن عکس و ویدیو در تلگرام حداکثر ۱۰۲۴ نویسه است
    if ((n.tg_video || n.image_key || n.thumb) && caption.length > 1000) caption = `📰 <b>${tgEsc(n.title)}</b>${tail}${sign}`;
    // ویدیوی مستقیم (فقط برای کانال تلگرام؛ با file_id ارسال میشود و نیازی به دانلود نیست)
    if (n.tg_video) {
      try {
        await telegramApi(env, "sendVideo", { chat_id: ch, video: n.tg_video, caption, parse_mode: "HTML", supports_streaming: true });
        return;
      } catch (e) { console.error("channel sendVideo failed", e); }
    }
    // عکس شاخص، و اگر نبود پوستر خودکار ویدیو
    const photoPath = n.image_key ? `/media/${encodeURIComponent(n.image_key)}` : (n.thumb || "");
    if (photoPath && site) {
      try {
        await telegramApi(env, "sendPhoto", { chat_id: ch, photo: site + photoPath, caption, parse_mode: "HTML" });
        return;
      } catch (e) { console.error("channel sendPhoto failed", e); }
    }
    await telegramApi(env, "sendMessage", { chat_id: ch, text: caption, parse_mode: "HTML" });
  } catch (e) {
    console.error("channel post failed", e);
  }
}

// ------------------------------ ربات تلگرام ------------------------------
async function handleTelegramUpdate(update, env) {
  const msg = update.message;
  const cb = update.callback_query;

  if (cb) {
    if (String(cb.from?.id) !== String(env.ADMIN_TELEGRAM_ID)) { await answerCallback(env, cb.id, "اجازه دسترسی ندارید."); return; }
    await answerCallback(env, cb.id);
    const action = cb.data || "";
    const uid = cb.from.id;

    // ---- منابع RSS ----
    if (action === "bot:menu") {
      await sendMessage(env, uid,
        "منوی مدیریت خوزخبر:\n\n" +
        "📝 /new — ثبت خبر جدید\n📋 /list — آخرین خبرها\n🔍 /search — جستجو\n" +
        "📡 /rss — منابع خودکار\n📄 /need — خبرهای بدون متن کامل",
        { inline_keyboard: [[{ text: "📡 منابع خودکار", callback_data: "rssmenu" }], [{ text: "📄 خبرهای بدون متن", callback_data: "needlist" }]] });
      return;
    }
    if (action === "rssmenu") { await sendRssMenu(env, uid); return; }
    if (action === "needlist") { await sendNeedList(env, uid); return; }
    if (action === "frss:add") {
      await saveSession(env, uid, { step: "feed_url" });
      await sendMessage(env, uid, "لینک RSS منبع را بفرست (مثلاً https://example.com/rss).\n\nبرای لغو /cancel را بزن.");
      return;
    }
    if (action.startsWith("frss:open:")) { await sendFeedMenu(env, uid, action.slice(10)); return; }
    if (action.startsWith("frss:run:")) {
      const id = action.slice(9);
      const f = await env.DB.prepare("SELECT * FROM feeds WHERE id=?").bind(id).first();
      if (!f) { await sendMessage(env, uid, "منبع پیدا نشد."); return; }
      await sendMessage(env, uid, "⏳ در حال دریافت خبرهای «" + f.name + "»…");
      const r = await runFeed(env, f);
      const kb = [[{ text: "🔁 اجرای دوباره", callback_data: "frss:run:" + id }]];
      if (r.thin) kb.push([{ text: "📄 " + r.thin + " خبر بدون متن کامل", callback_data: "needlist" }]);
      kb.push([{ text: "🔙 منابع", callback_data: "rssmenu" }]);
      await sendMessage(env, uid, "📡 " + f.name + "\n\n" + r.status, { inline_keyboard: kb });
      return;
    }
    if (action.startsWith("frss:tgl:")) {
      const id = action.slice(9);
      const f = await env.DB.prepare("SELECT enabled FROM feeds WHERE id=?").bind(id).first();
      if (!f) { await sendMessage(env, uid, "منبع پیدا نشد."); return; }
      await env.DB.prepare("UPDATE feeds SET enabled=? WHERE id=?").bind(f.enabled ? 0 : 1, id).run();
      await sendFeedMenu(env, uid, id);
      return;
    }
    if (action.startsWith("frss:tg:")) {
      const id = action.slice(8);
      await ensureFeedsSchema(env);
      const f = await env.DB.prepare("SELECT to_channel,auto_publish FROM feeds WHERE id=?").bind(id).first();
      if (!f) { await sendMessage(env, uid, "منبع پیدا نشد."); return; }
      await env.DB.prepare("UPDATE feeds SET to_channel=? WHERE id=?").bind(f.to_channel ? 0 : 1, id).run();
      await sendFeedMenu(env, uid, id);
      return;
    }
    if (action.startsWith("frss:auto:")) {
      const id = action.slice(10);
      const f = await env.DB.prepare("SELECT auto_publish FROM feeds WHERE id=?").bind(id).first();
      if (!f) { await sendMessage(env, uid, "منبع پیدا نشد."); return; }
      await env.DB.prepare("UPDATE feeds SET auto_publish=? WHERE id=?").bind(f.auto_publish ? 0 : 1, id).run();
      await sendFeedMenu(env, uid, id);
      return;
    }
    if (action.startsWith("frss:full:")) {
      const id = action.slice(10);
      await ensureFeedsSchema(env);
      const f = await env.DB.prepare("SELECT fetch_full FROM feeds WHERE id=?").bind(id).first();
      if (!f) { await sendMessage(env, uid, "منبع پیدا نشد."); return; }
      await env.DB.prepare("UPDATE feeds SET fetch_full=? WHERE id=?").bind(f.fetch_full ? 0 : 1, id).run();
      await sendFeedMenu(env, uid, id);
      return;
    }
    if (action.startsWith("frss:del:")) {
      const id = action.slice(9);
      const f = await env.DB.prepare("SELECT name FROM feeds WHERE id=?").bind(id).first();
      if (!f) { await sendMessage(env, uid, "منبع پیدا نشد."); return; }
      await sendMessage(env, uid, `منبع «${f.name}» حذف شود؟ (خبرهای قبلی در سایت میمانند)`, {
        inline_keyboard: [[{ text: "🗑 بله، حذف کن", callback_data: "frss:delok:" + id }, { text: "انصراف", callback_data: "frss:open:" + id }]]
      });
      return;
    }
    if (action.startsWith("frss:delok:")) {
      const id = action.slice(11);
      await env.DB.prepare("DELETE FROM feeds WHERE id=?").bind(id).run();
      await sendMessage(env, uid, "🗑 منبع حذف شد.");
      await sendRssMenu(env, uid);
      return;
    }
    if (action.startsWith("fcat:")) {
      const cat = action.slice(5);
      if (!CATEGORIES.includes(cat)) { await sendMessage(env, uid, "دستهبندی معتبر نیست."); return; }
      const session = await getSession(env, uid);
      if (!session || session.step !== "feed_cat") { await sendMessage(env, uid, "برای افزودن منبع /rss را بزن."); return; }
      session.step = "feed_name"; session.feed_cat = cat;
      await saveSession(env, uid, session);
      await sendMessage(env, uid,
        `دسته: ${cat}\n\nحالا یک نام برای این منبع بفرست (مثل «ایسنا»).\nاگر نمیخواهی، /skip را بزن تا از آدرس سایت ساخته شود.`);
      return;
    }

    if (action === "publish") {
      const session = await getSession(env, uid);
      if (!session || session.step !== "confirm" || !session.title || !session.body) {
        await sendMessage(env, uid, "اطلاعات خبر کامل نیست. دوباره با /new شروع کن."); return;
      }
      const del = await env.DB.prepare("DELETE FROM bot_sessions WHERE chat_id=?").bind(String(uid)).run();
      if (!del.meta?.changes) return;
      const id = newId(), now = nowIso();
      const thumb = session.image_key ? "" : await computeThumb(env, session.body, null);
      try {
        await env.DB.prepare(
          "INSERT INTO news (id,title,summary,body,category,image_key,status,author,featured,views,created_at,updated_at,published_at,thumb,tags,categories) VALUES (?,?,?,?,?,?, 'published','',0,0,?,?,?,?,'',?)"
        ).bind(id, session.title, session.summary || "", session.body, session.category || "استانی", session.image_key || "", now, now, now, thumb, "," + (session.category || "استانی") + ",").run();
      } catch (e) {
        console.error("Publish failed", e);
        await saveSession(env, uid, session);
        await sendMessage(env, uid, "انتشار انجام نشد. دوباره دکمه انتشار را بزن."); return;
      }
      const site = (env.SITE_URL || "").replace(/\/+$/, "");
      await sendMessage(env, uid, `خبر با موفقیت منتشر شد.\n\n${session.title}\n\n${site ? "لینک خبر: " + site + "/news/" + id + "\n\n" : ""}برای ثبت خبر بعدی /new را بفرست.`);
      // انتشار خودکار در کانال (اگر TELEGRAM_CHANNEL_ID تنظیم شده باشد)
      await postToChannel(env, { id, title: session.title, summary: session.summary || "", image_key: session.image_key || "", thumb, tg_video: session.tg_video || "" }, site);
      return;
    }

    if (action === "cancel") {
      await clearSession(env, uid);
      await sendMessage(env, uid, "ثبت خبر لغو شد. برای شروع دوباره /new را بفرست.");
      return;
    }

    if (action.startsWith("cat:")) {
      const category = action.slice(4);
      if (!CATEGORIES.includes(category)) return;
      const session = await getSession(env, uid);
      if (!session || session.step !== "category") { await sendMessage(env, uid, "برای ثبت خبر جدید /new را بفرست."); return; }
      session.category = category; session.step = "confirm";
      await saveSession(env, uid, session);
      await sendMessage(env, uid, `پیشنمایش خبر:\n\n📌 ${session.title}\n\n🏷 دسته: ${category}\n🖼 عکس: ${session.image_key ? "دارد" : "ندارد (پوستر ویدیو خودکار)"}\n🎬 ویدیوی کانال: ${session.tg_video ? "دارد" : "ندارد"}\n\n${session.summary}\n\n${session.body.slice(0, 700)}${session.body.length > 700 ? "…" : ""}`, {
        inline_keyboard: [[{ text: "✅ انتشار خبر", callback_data: "publish" }], [{ text: "❌ لغو", callback_data: "cancel" }]]
      });
      return;
    }

    if (action.startsWith("fulltext:")) {
      const id = action.slice(9);
      const n = await env.DB.prepare("SELECT body,summary,source_url FROM news WHERE id=?").bind(id).first();
      if (!n) { await sendMessage(env, uid, "خبر پیدا نشد."); return; }
      const cur = String(n.body || "");
      if (cur.length >= THIN_BODY && !bodyIsSummary(cur, n.summary)) { await sendMessage(env, uid, "این خبر از قبل متن کامل دارد."); return; }
      const feedUrl = await fullFeedFor(env, n.source_url);
      if (!feedUrl) { await sendMessage(env, uid, "هیچ منبع فعالی با دامنه‌ی این خبر تنظیم نشده است."); return; }
      await sendMessage(env, uid, "⏳ در حال گرفتن متن کامل از صفحه‌ی منبع…");
      let got;
      try { got = await fetchFullArticle(n.source_url, feedUrl, n.summary); } catch (e) { got = { err: "خطای نامشخص" }; }
      if (!got.body) {
        await sendMessage(env, uid, "متن کامل گرفته نشد: " + (got.err || "ناموفق") + "\n\nمتن را از صفحه‌ی منبع کپی کن و با «✏️ ویرایش متن کامل» بفرست.", {
          inline_keyboard: [[{ text: "🔗 صفحه‌ی منبع", url: n.source_url }], [{ text: "🔙 بازگشت", callback_data: "manage:" + id }]]
        });
        return;
      }
      await env.DB.prepare("UPDATE news SET body=?, updated_at=? WHERE id=?").bind(got.body, nowIso(), id).run();
      await sendMessage(env, uid, `✅ متن کامل گرفته شد (${got.body.length.toLocaleString("fa-IR")} نویسه).`);
      await sendManageMenu(env, uid, id);
      return;
    }

    if (action.startsWith("manage:")) { await sendManageMenu(env, uid, action.slice(7)); return; }

    if (action.startsWith("bodysave:")) { await saveBodyFromSession(env, uid, action.slice(9)); return; }

    if (action === "back:list") {
      const rows = await env.DB.prepare("SELECT id,title,status FROM news ORDER BY created_at DESC LIMIT 10").all();
      if (!rows.results?.length) { await sendMessage(env, uid, "هنوز خبری ثبت نشده است."); return; }
      const kb = rows.results.map(n => [{
        text: `${n.status === "draft" ? "📝" : "✅"} ${n.title.slice(0, 50)}`,
        callback_data: "manage:" + n.id
      }]);
      await sendMessage(env, uid, "📋 آخرین ۱۰ خبر:", { inline_keyboard: kb });
      return;
    }

    if (action.startsWith("toggle:")) {
      const id = action.slice(7);
      const n = await env.DB.prepare("SELECT status,LENGTH(COALESCE(body,'')) AS blen,title,summary,image_key,thumb FROM news WHERE id=?").bind(id).first();
      if (!n) { await sendMessage(env, uid, "خبر پیدا نشد."); return; }
      const st = n.status === "draft" ? "published" : "draft";
      if (st === "published" && Number(n.blen || 0) < 10) {
        await sendMessage(env, uid, "این خبر متن کامل ندارد؛ اول با «✏️ ویرایش متن کامل» متن را بفرست، بعد منتشرش کن.", {
          inline_keyboard: [[{ text: "✏️ ویرایش متن کامل", callback_data: "edit:body:" + id }], [{ text: "🔙 بازگشت", callback_data: "manage:" + id }]]
        });
        return;
      }
      const now = nowIso();
      await env.DB.prepare(
        "UPDATE news SET status=?, published_at=CASE WHEN ?='published' AND status!='published' THEN ? ELSE published_at END, updated_at=? WHERE id=?"
      ).bind(st, st, now, now, id).run();
      // انتشار از ربات هم خبر را به کانال تلگرام میفرستد (با امضای نام کانال)
      let chPosted = false;
      if (st === "published" && env.TELEGRAM_CHANNEL_ID) {
        try { await postToChannel(env, { id, title: n.title, summary: n.summary, image_key: n.image_key, thumb: n.thumb }, (env.SITE_URL || "")); chPosted = true; }
        catch (e) { console.error("bot channel post failed", e); }
      }
      await sendMessage(env, uid,
        st === "published" ? ("✅ خبر منتشر شد." + (chPosted ? "\n📣 در کانال تلگرام هم پست شد." : "")) : "📝 خبر به پیشنویس تبدیل شد.",
        { inline_keyboard: [[{ text: "🔙 بازگشت", callback_data: "manage:" + id }]] }
      );
      return;
    }

    if (action.startsWith("feat:")) {
      const id = action.slice(5);
      const n = await env.DB.prepare("SELECT featured FROM news WHERE id=?").bind(id).first();
      if (!n) { await sendMessage(env, uid, "خبر پیدا نشد."); return; }
      if (!n.featured) {
        const cnt = await env.DB.prepare("SELECT COUNT(*) AS n FROM news WHERE featured=1").first();
        if ((cnt?.n || 0) >= 6) { await sendMessage(env, uid, "❗️ حداکثر ۶ خبر میتوانند ویژه باشند."); return; }
      }
      await env.DB.prepare("UPDATE news SET featured=?, updated_at=? WHERE id=?").bind(n.featured ? 0 : 1, nowIso(), id).run();
      await sendMessage(env, uid, n.featured ? "از خبرهای ویژه حذف شد." : "⭐ به خبرهای ویژه اضافه شد.", {
        inline_keyboard: [[{ text: "🔙 بازگشت", callback_data: "manage:" + id }]]
      });
      return;
    }

    if (action.startsWith("del:")) {
      const id = action.slice(4);
      const n = await env.DB.prepare("SELECT title FROM news WHERE id=?").bind(id).first();
      if (!n) { await sendMessage(env, uid, "خبر پیدا نشد."); return; }
      await sendMessage(env, uid, `❗️ آیا از حذف «${n.title}» مطمئنی؟`, {
        inline_keyboard: [[
          { text: "🗑 بله", callback_data: "delok:" + id },
          { text: "🔙 انصراف", callback_data: "manage:" + id }
        ]]
      });
      return;
    }

    if (action.startsWith("delok:")) {
      const id = action.slice(6);
      const n = await env.DB.prepare("SELECT image_key,thumb,source_url FROM news WHERE id=?").bind(id).first();
      if (!n) { await sendMessage(env, uid, "خبر پیدا نشد."); return; }
      if (n.source_url) { try { await env.DB.prepare("INSERT OR IGNORE INTO feed_skip (url) VALUES (?)").bind(n.source_url).run(); } catch (e) { } }
      await env.DB.prepare("DELETE FROM news WHERE id=?").bind(id).run();
      await cleanupImage(env, n.image_key);
      if (n.thumb) await cleanupImage(env, thumbKey(n.thumb));
      await sendMessage(env, uid, "🗑 خبر حذف شد.");
      return;
    }

    if (action.startsWith("edit:")) {
      const parts = action.split(":");
      if (parts.length !== 3) return;
      const [, field, id] = parts;
      if (!["title", "summary", "body"].includes(field)) return;
      if (field === "body") {
        // متن کامل معمولاً بلندتر از یک پیام تلگرام است: چند پیام پشت سر هم گرفته میشود
        const cur = await env.DB.prepare("SELECT LENGTH(COALESCE(body,'')) AS n FROM news WHERE id=?").bind(id).first().catch(() => null);
        await saveSession(env, uid, { step: "edit_body", edit_id: id, buf: [] });
        await sendMessage(env, uid,
          "📝 متن کامل خبر را بفرست.\n\n" +
          "• اگر متن بلند است، در چند پیام پشت سر هم بفرست؛ تکهها با یک خط خالی به هم میچسبند.\n" +
          "• در پایان /done بزن (یا دکمه‌ی «✅ ذخیره» را بزن).\n" +
          "• برای لغو /cancel.\n\n" +
          `متن فعلی: ${cur && cur.n ? Number(cur.n).toLocaleString("fa-IR") + " نویسه" : "خالی"}`,
          { inline_keyboard: [[{ text: "✅ ذخیره", callback_data: "bodysave:" + id }], [{ text: "❌ لغو", callback_data: "cancel" }]] });
        return;
      }
      const n = await env.DB.prepare(`SELECT ${field} AS v FROM news WHERE id=?`).bind(id).first();
      if (!n) { await sendMessage(env, uid, "خبر پیدا نشد."); return; }
      await saveSession(env, uid, { step: "edit_field", edit_id: id, edit_field: field });
      const labels = { title: "تیتر", summary: "خلاصه", body: "متن کامل" };
      await sendMessage(env, uid,
        `مقدار جدید «${labels[field]}» را بفرست:\n\nمقدار فعلی:\n${String(n.v || "").slice(0, 300)}${String(n.v || "").length > 300 ? "…" : ""}\n\nبرای لغو /cancel را بفرست.`);
      return;
    }

    return;
  }

  if (!msg?.chat?.id || String(msg.from?.id) !== String(env.ADMIN_TELEGRAM_ID)) return;
  const chatId = msg.chat.id;
  const text = (msg.text || "").trim();

  if (text === "/start" || text === "/help") {
    await sendMessage(env, chatId,
      "سلام! به پنل مدیریت خوزخبر خوش آمدی.\n\n" +
      "📝 /new — ثبت خبر جدید\n" +
      "📋 /list — آخرین ۱۰ خبر\n" +
      "🔍 /search — جستجوی خبر\n" +
      "📡 /rss — منابع خودکار (اجرا، فعال/غیرفعال، افزودن، حذف، ارسال به کانال)\n" +
      "📄 /need — خبرهای بدون متن کامل (با دکمه‌ی صفحه‌ی منبع)\n" +
      "❌ /cancel — لغو عملیات",
      { inline_keyboard: [[{ text: "📡 منابع خودکار", callback_data: "rssmenu" }], [{ text: "📄 خبرهای بدون متن", callback_data: "needlist" }]] }
    );
    return;
  }
  if (text === "/cancel") { await clearSession(env, chatId); await sendMessage(env, chatId, "عملیات لغو شد."); return; }

  if (text === "/new") {
    await saveSession(env, chatId, { step: "photo" });
    await sendMessage(env, chatId, "عکس خبر را ارسال کن (حداکثر ۱ مگابایت).\n\nاگر خبر ویدیویی است و عکس ندارد /skip بزن؛ پوستر ویدیو خودکار عکس خبر میشود.");
    return;
  }

  if (text === "/list") {
    const rows = await env.DB.prepare(
      "SELECT id,title,status FROM news ORDER BY created_at DESC LIMIT 10"
    ).all();
    if (!rows.results?.length) { await sendMessage(env, chatId, "هنوز خبری ثبت نشده است."); return; }
    const kb = rows.results.map(n => [{
      text: `${n.status === "draft" ? "📝" : "✅"} ${n.title.slice(0, 50)}`,
      callback_data: "manage:" + n.id
    }]);
    await sendMessage(env, chatId, "📋 آخرین ۱۰ خبر:", { inline_keyboard: kb });
    return;
  }

  if (text === "/rss" || text === "/feeds") { await sendRssMenu(env, chatId); return; }
  if (text === "/need") { await sendNeedList(env, chatId); return; }

  if (text === "/search") {
    await saveSession(env, chatId, { step: "search_query" });
    await sendMessage(env, chatId, "عبارت جستجو را بفرست:");
    return;
  }

  const session = await getSession(env, chatId);

  // افزودن منبع RSS: اول لینک، بعد دسته، بعد نام
  if (session && session.step === "feed_url") {
    let fu = null;
    try { fu = new URL(text); } catch (e) { fu = null; }
    if (!fu || (fu.protocol !== "https:" && fu.protocol !== "http:")) {
      await sendMessage(env, chatId, "لینک معتبر نیست. یک آدرس http یا https بفرست (مثلاً https://example.com/rss).");
      return;
    }
    const dup = await env.DB.prepare("SELECT id FROM feeds WHERE url=?").bind(fu.toString()).first().catch(() => null);
    if (dup) { await clearSession(env, chatId); await sendMessage(env, chatId, "این منبع از قبل اضافه شده است."); return; }
    await saveSession(env, chatId, { step: "feed_cat", feed_url: fu.toString() });
    await sendMessage(env, chatId, "دستهبندی خبرهای این منبع:", {
      inline_keyboard: [
        ...[0, 3, 6, 9].map(i => CATEGORIES.slice(i, i + 3).map(c => ({ text: c, callback_data: "fcat:" + c }))).filter(r => r.length),
        [{ text: "لغو", callback_data: "cancel" }]
      ]
    });
    return;
  }
  if (session && session.step === "feed_name") {
    const nameIn = text === "/skip" ? "" : text.slice(0, 60);
    const fu = session.feed_url || "";
    let host = "";
    try { host = new URL(fu).hostname.replace(/^www\./, ""); } catch (e) { host = ""; }
    const name = String(nameIn || host || "منبع RSS").slice(0, 60);
    await ensureFeedsSchema(env);
    const cnt = await env.DB.prepare("SELECT COUNT(*) AS n FROM feeds").first();
    if ((cnt?.n || 0) >= 20) { await clearSession(env, chatId); await sendMessage(env, chatId, "حداکثر ۲۰ منبع مجاز است."); return; }
    const fid = newId();
    await env.DB.prepare("INSERT INTO feeds (id,name,url,categories,auto_publish,import_images,max_items,enabled,last_run,last_status,created_at,to_channel) VALUES (?,?,?,?,0,0,5,1,'','',?,0)")
      .bind(fid, name, fu, "," + (session.feed_cat || "استانی") + ",", nowIso()).run();
    await clearSession(env, chatId);
    await sendMessage(env, chatId,
      `✅ منبع «${name}» اضافه شد.\n\nخبرها پیشنویس ذخیره میشوند؛ متن کامل را خودت از دکمه‌ی صفحه‌ی منبع (در /need) کپی میکنی.`,
      { inline_keyboard: [
        [{ text: "▶️ همین حالا اجرا کن", callback_data: "frss:run:" + fid }],
        [{ text: "📡 منابع", callback_data: "rssmenu" }]
      ] });
    return;
  }

  if (!session) { await sendMessage(env, chatId, "برای شروع /new یا /list یا /search یا /rss را بفرست."); return; }

  // گرفتن متن کامل در چند پیام (چون یک پیام تلگرام حداکثر ۴۰۹۶ نویسه است)
  if (session.step === "edit_body") {
    if (text === "/done") { await saveBodyFromSession(env, chatId, session.edit_id); return; }
    if (!text) { await sendMessage(env, chatId, "متن خبر را بفرست یا /done بزن."); return; }
    session.buf = (session.buf || []).concat(text);
    await saveSession(env, chatId, session);
    const total = session.buf.join("\n\n").length;
    await sendMessage(env, chatId,
      `📥 تکه‌ی ${session.buf.length.toLocaleString("fa-IR")} گرفته شد (روی هم ${total.toLocaleString("fa-IR")} نویسه).\nادامه بده یا /done بزن.`,
      { inline_keyboard: [[{ text: "✅ ذخیره", callback_data: "bodysave:" + session.edit_id }], [{ text: "❌ لغو", callback_data: "cancel" }]] });
    return;
  }

  if (session.step === "edit_field") {
    if (!text) { await sendMessage(env, chatId, "لطفاً متن را بفرست."); return; }
    const field = session.edit_field, id = session.edit_id;
    const limits = { title: [5, 180], summary: [0, 500], body: [10, 50000] };
    const [min, max] = limits[field] || [0, 50000];
    if (text.length < min || text.length > max) {
      await sendMessage(env, chatId, `مقدار باید بین ${min} تا ${max} نویسه باشد.`);
      return;
    }
    await env.DB.prepare(`UPDATE news SET ${field}=?, updated_at=? WHERE id=?`).bind(text, nowIso(), id).run();
    await clearSession(env, chatId);
    await sendMessage(env, chatId, "✅ ویرایش ذخیره شد.", {
      inline_keyboard: [[{ text: "🔙 بازگشت", callback_data: "manage:" + id }]]
    });
    return;
  }

  if (session.step === "search_query") {
    if (!text) { await sendMessage(env, chatId, "عبارت جستجو را بفرست."); return; }
    const q = "%" + text.replace(/[\\%_]/g, m => "\\" + m) + "%";
    const rows = await env.DB.prepare(
      "SELECT id,title,status FROM news WHERE title LIKE ? ESCAPE '\\' OR body LIKE ? ESCAPE '\\' ORDER BY created_at DESC LIMIT 10"
    ).bind(q, q).all();
    await clearSession(env, chatId);
    if (!rows.results?.length) { await sendMessage(env, chatId, "نتیجهای پیدا نشد."); return; }
    const kb = rows.results.map(n => [{
      text: `${n.status === "draft" ? "📝" : "✅"} ${n.title.slice(0, 50)}`,
      callback_data: "manage:" + n.id
    }]);
    await sendMessage(env, chatId, `🔍 ${rows.results.length} نتیجه:`, { inline_keyboard: kb });
    return;
  }

  if (session.step === "photo") {
    if (text === "/skip") {
      session.step = "title"; await saveSession(env, chatId, session);
      await sendMessage(env, chatId, "بدون عکس ادامه میدهیم. تیتر خبر را بفرست.");
      return;
    }
    if (!msg.photo?.length) { await sendMessage(env, chatId, "لطفاً یک عکس ارسال کن یا /skip بزن."); return; }
    const photo = msg.photo[msg.photo.length - 1];
    if (photo.file_size && photo.file_size > MAX_IMAGE_BYTES) { await sendMessage(env, chatId, "حجم عکس زیاد است."); return; }
    try {
      const fileInfo = await telegramApi(env, "getFile", { file_id: photo.file_id });
      const filePath = fileInfo.result?.file_path;
      if (!filePath) throw new Error("Telegram file path missing");
      const download = await fetch(`https://api.telegram.org/file/bot${env.TELEGRAM_BOT_TOKEN}/${filePath}`);
      if (!download.ok) throw new Error("Download failed");
      const buffer = await download.arrayBuffer();
      const type = sniffImage(buffer);
      if (!type) throw new Error("Unsupported image type");
      const key = `${crypto.randomUUID()}.${type.ext}`;
      await putImage(env, key, buffer, type.mime);
      session.image_key = key; session.step = "title";
      await saveSession(env, chatId, session);
      await sendMessage(env, chatId, "عکس ذخیره شد. حالا تیتر خبر را بفرست.");
    } catch (e) {
      await sendMessage(env, chatId, "ذخیره عکس انجام نشد. دوباره بفرست.");
    }
    return;
  }

  if (session.step === "video") {
    const vf = msg.video?.file_id || (msg.document?.mime_type?.startsWith("video/") ? msg.document.file_id : "") || msg.animation?.file_id || "";
    if (vf) {
      session.tg_video = vf;
      await askCategory(env, chatId, session, "ویدیو ثبت شد (فقط در کانال تلگرام نمایش داده میشود).");
      return;
    }
    if (text === "/skip") { await askCategory(env, chatId, session, ""); return; }
    await sendMessage(env, chatId, "ویدیو را بهصورت فایل بفرست یا /skip بزن.");
    return;
  }

  if (!text) { await sendMessage(env, chatId, "پاسخ را به صورت متن بفرست."); return; }

  if (session.step === "title") {
    if (text.length < 5 || text.length > 180) { await sendMessage(env, chatId, "تیتر ۵ تا ۱۸۰ نویسه باشد."); return; }
    session.title = text; session.step = "summary"; await saveSession(env, chatId, session);
    await sendMessage(env, chatId, "خلاصه خبر را بفرست.");
  } else if (session.step === "summary") {
    if (text.length > 500) { await sendMessage(env, chatId, "خلاصه حداکثر ۵۰۰ نویسه باشد."); return; }
    session.summary = text; session.step = "body"; await saveSession(env, chatId, session);
    await sendMessage(env, chatId, "متن کامل خبر را بفرست (حداکثر ۴۰۹۶ نویسه).");
  } else if (session.step === "body") {
    if (text.length < 10 || text.length > 4096) { await sendMessage(env, chatId, "متن باید بین ۱۰ تا ۴۰۹۶ نویسه باشد."); return; }
    session.body = text; session.step = "link"; await saveSession(env, chatId, session);
    await sendMessage(env, chatId, "🔗 اگر ویدیو در آپارات یا یوتیوب دارد، لینک صفحه‌ی آن را بفرست تا در سایت پخش شود (به انتهای متن خبر اضافه میشود). وگرنه /skip بزن.");
  } else if (session.step === "link") {
    if (text !== "/skip") {
      if (!parseVideoUrl(text)) { await sendMessage(env, chatId, "لینک معتبر آپارات یا یوتیوب نیست. دوباره بفرست یا /skip بزن."); return; }
      session.body = session.body + "\n\n" + text.trim();
    }
    session.step = "video"; await saveSession(env, chatId, session);
    await sendMessage(env, chatId, "🎬 اگر میخواهی ویدیوی مستقیم در کانال تلگرام نمایش داده شود، فایل ویدیو را بفرست (این ویدیو در سایت نمایش داده نمیشود). وگرنه /skip بزن.");
  } else {
    await sendMessage(env, chatId, "از دکمههای پیام قبلی استفاده کن.");
  }
}

async function telegramApi(env, method, payload) {
  const r = await fetch(`https://api.telegram.org/bot${env.TELEGRAM_BOT_TOKEN}/${method}`, {
    method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload)
  });
  const data = await r.json();
  if (!r.ok || !data.ok) throw new Error(`Telegram API ${method} failed: ${data.description || r.status}`);
  return data;
}
async function sendMessage(env, chatId, text, replyMarkup) {
  const payload = { chat_id: chatId, text, disable_web_page_preview: true };
  if (replyMarkup) payload.reply_markup = replyMarkup;
  return telegramApi(env, "sendMessage", payload);
}
async function answerCallback(env, id, text) {
  try { await telegramApi(env, "answerCallbackQuery", { callback_query_id: id, ...(text ? { text } : {}) }); } catch {}
}
async function getSession(env, chatId) {
  const row = await env.DB.prepare("SELECT state_json FROM bot_sessions WHERE chat_id=?").bind(String(chatId)).first();
  if (!row) return null;
  try { return JSON.parse(row.state_json); } catch { return null; }
}
async function saveSession(env, chatId, session) {
  await env.DB.prepare("INSERT INTO bot_sessions (chat_id,state_json,updated_at) VALUES (?,?,?) ON CONFLICT(chat_id) DO UPDATE SET state_json=excluded.state_json,updated_at=excluded.updated_at")
    .bind(String(chatId), JSON.stringify(session), nowIso()).run();
}
async function clearSession(env, chatId) {
  await env.DB.prepare("DELETE FROM bot_sessions WHERE chat_id=?").bind(String(chatId)).run();
}

// ذخیره‌ی متن کاملی که کاربر در چند پیام فرستاده
async function saveBodyFromSession(env, chatId, id) {
  const session = await getSession(env, chatId);
  if (!session || session.step !== "edit_body" || String(session.edit_id) !== String(id)) {
    await sendMessage(env, chatId, "متنی در حافظه نیست؛ دوباره «✏️ ویرایش متن کامل» را بزن.");
    return;
  }
  const body = (session.buf || []).map(x => String(x).trim()).filter(Boolean).join("\n\n").trim();
  if (body.length < 10) { await sendMessage(env, chatId, "هنوز متنی نرسیده؛ متن خبر را بفرست یا /cancel بزن."); return; }
  await env.DB.prepare("UPDATE news SET body=?, updated_at=? WHERE id=?").bind(body.slice(0, 50000), nowIso(), id).run();
  await clearSession(env, chatId);
  await sendMessage(env, chatId, `✅ متن کامل ذخیره شد (${body.length.toLocaleString("fa-IR")} نویسه).`);
  await sendManageMenu(env, chatId, id);
}

// ─────────────── منوی مدیریت یک خبر (همهچیز داخل خود تلگرام) ───────────────
// ویرایش تیتر/خلاصه/متن، انتشار یا پیشنویس کردن، ویژه کردن، حذف و مشاهده — بدون رفتن به سایت
async function sendManageMenu(env, chatId, id) {
  const n = await env.DB.prepare(
    "SELECT id,title,status,featured,category,views,source_url,LENGTH(COALESCE(body,'')) AS blen FROM news WHERE id=?"
  ).bind(id).first();
  if (!n) { await sendMessage(env, chatId, "خبر پیدا نشد."); return; }
  const thin = Number(n.blen || 0) < THIN_BODY;
  const site = (env.SITE_URL || "").replace(/\/+$/, "");
  const kb = [
    [{ text: "✏️ ویرایش تیتر", callback_data: "edit:title:" + id }],
    [{ text: "✏️ ویرایش خلاصه", callback_data: "edit:summary:" + id }],
    [{ text: "✏️ ویرایش متن کامل", callback_data: "edit:body:" + id }],
    [{ text: n.status === "draft" ? "✅ انتشار" : "📝 برگرداندن به پیشنویس", callback_data: "toggle:" + id }],
    [{ text: n.featured ? "⭐ حذف از اسلایدر" : "⭐ افزودن به اسلایدر", callback_data: "feat:" + id }],
  ];
  if (n.source_url) kb.push([{ text: "🔗 صفحه‌ی منبع (برای کپی متن)", url: n.source_url }]);
  if (n.source_url) kb.push([{ text: "📥 گرفتن متن کامل از منبع", callback_data: "fulltext:" + id }]);
  if (site) kb.push([{ text: "🌐 مشاهده در سایت", url: site + "/news/" + id }]);
  kb.push([{ text: "🗑 حذف خبر", callback_data: "del:" + id }]);
  kb.push([{ text: "🔙 بازگشت به فهرست", callback_data: "back:list" }, { text: "📄 بدون متن", callback_data: "needlist" }]);
  await sendMessage(env, chatId,
    `📰 ${n.title}\n\n` +
    `دسته: ${n.category}\n` +
    `وضعیت: ${n.status === "draft" ? "پیشنویس" : "منتشرشده"}\n` +
    `ویژه (اسلایدر): ${n.featured ? "بله" : "خیر"}\n` +
    `بازدید: ${Number(n.views || 0).toLocaleString("fa-IR")}\n` +
    `متن کامل: ${Number(n.blen || 0) ? Number(n.blen).toLocaleString("fa-IR") + " نویسه" : "خالی"}` +
    (thin ? "\n\n⚠️ متن کامل ندارد. با «🔗 صفحه‌ی منبع» متن را کپی کن و با «✏️ ویرایش متن کامل» همینجا بچسبان." : "") +
    "\n\nچه کاری انجام دهم؟",
    { inline_keyboard: kb });
}

// ─────────────── منابع RSS در ربات تلگرام ───────────────
// فهرست منابع با دکمه‌ی هر منبع؛ همه‌ی کارها (اجرا، فعال/غیرفعال، ارسال به کانال، حذف) از تلگرام
async function sendRssMenu(env, chatId) {
  await ensureFeedsSchema(env);
  const r = await env.DB.prepare(
    "SELECT id,name,url,enabled,auto_publish,to_channel,fetch_full,last_run,last_status FROM feeds ORDER BY created_at DESC LIMIT 8"
  ).all();
  const feeds = r.results || [];
  if (!feeds.length) {
    await sendMessage(env, chatId, "هنوز منبعی اضافه نشده است.", {
      inline_keyboard: [[{ text: "➕ افزودن منبع", callback_data: "frss:add" }], [{ text: "🔙 منوی اصلی", callback_data: "bot:menu" }]]
    });
    return;
  }
  const lines = feeds.map((f, i) =>
    `${i + 1}) ${f.enabled ? "🟢" : "⏸"} ${f.name}` +
    `${f.auto_publish ? " · انتشار خودکار" : ""}${f.to_channel ? " · 📣 کانال" : ""}${f.fetch_full ? " · 📄 متن کامل" : ""}`
  );
  const kb = feeds.map(f => [{
    text: `${f.enabled ? "🟢" : "⏸"} ${f.name.length > 26 ? f.name.slice(0, 25) + "…" : f.name}`,
    callback_data: "frss:open:" + f.id
  }]);
  kb.push([{ text: "➕ افزودن منبع", callback_data: "frss:add" }]);
  kb.push([{ text: "📄 خبرهای بدون متن کامل", callback_data: "needlist" }]);
  kb.push([{ text: "🔙 منوی اصلی", callback_data: "bot:menu" }]);
  await sendMessage(env, chatId,
    "📡 منابع خودکار (RSS)\n\n" + lines.join("\n") + "\n\nروی هر منبع بزن تا اجرا یا تنظیمش کنی.",
    { inline_keyboard: kb });
}

// منوی یک منبع
async function sendFeedMenu(env, chatId, id) {
  await ensureFeedsSchema(env);
  const f = await env.DB.prepare("SELECT * FROM feeds WHERE id=?").bind(id).first();
  if (!f) { await sendMessage(env, chatId, "منبع پیدا نشد."); return; }
  const when = f.last_run ? fmtDate(f.last_run) : "هنوز اجرا نشده";
  await sendMessage(env, chatId,
    `📡 ${f.name}\n\n` +

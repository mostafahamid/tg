// ------------------------------ دریافت خودکار خبر از RSS ------------------------------
// تیتر، خلاصه و متن (اگر فید content:encoded داشته باشد) از خود فید خوانده میشود.
// متن کامل خبر خودکار استخراج نمیشود؛ ادمین از صفحه‌ی منبع کپی میکند (بخش «متن کامل خبر»).
// نام و لینک منبع در سایت نمایش داده نمیشود.
function xmlDecode(s) {
  return String(s || "")
    .replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g, "$1")
    .replace(/&#(\d+);/g, (_, n) => { try { return String.fromCodePoint(+n); } catch { return ""; } })
    .replace(/&#x([0-9a-f]+);/gi, (_, n) => { try { return String.fromCodePoint(parseInt(n, 16)); } catch { return ""; } })
    .replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&quot;/g, '"').replace(/&apos;/g, "'").replace(/ /g, " ").replace(/&amp;/g, "&");
}
function stripHtml(h) {
  return String(h || "").replace(/<(script|style)[\s\S]*?<\/\1>/gi, "").replace(/<\s*\/\s*(p|div|h[1-6]|blockquote|ul|ol|table|figure)\s*>/gi, "\n\n").replace(/<\s*(br|\/li)\s*\/?>/gi, "\n").replace(/<[^>]+>/g, "");
}
function feedText(raw) {
  return xmlDecode(stripHtml(xmlDecode(raw))).replace(/[ \t\u00a0]+/g, " ").replace(/\n\s*\n+/g, "\n\n").trim();
}
function xmlTag(block, name) {
  const m = block.match(new RegExp("<" + name + "(?:\\s[^>]*)?>([\\s\\S]*?)</" + name + ">", "i"));
  return m ? m[1] : "";
}
function xmlAttr(block, tag, attr) {
  const m = block.match(new RegExp("<" + tag + "\\s[^>]*?" + attr + "\\s*=\\s*[\"']([^\"']+)[\"']", "i"));
  return m ? xmlDecode(m[1]) : "";
}
function parseFeed(xml) {
  const head = xml.slice(0, 3000);
  const isAtom = /<feed[\s>]/i.test(head) && !/<rss[\s>]/i.test(head);
  const blocks = xml.match(isAtom ? /<entry[\s>][\s\S]*?<\/entry>/gi : /<item[\s>][\s\S]*?<\/item>/gi) || [];
  return blocks.slice(0, 30).map(b => {
    const title = feedText(xmlTag(b, "title"));
    let link = isAtom ? xmlAttr(b, "link", "href") : feedText(xmlTag(b, "link"));
    if (!link) link = feedText(xmlTag(b, "guid"));
    const shortRaw = xmlTag(b, "description") || xmlTag(b, "summary");
    const fullRaw = xmlTag(b, "content:encoded") || xmlTag(b, "content");
    const descRaw = shortRaw || fullRaw;
    const desc = feedText(descRaw);
    const full = fullRaw ? feedText(fullRaw) : "";
    const dateRaw = feedText(xmlTag(b, "pubDate") || xmlTag(b, "published") || xmlTag(b, "updated") || xmlTag(b, "dc:date"));
    const encType = xmlAttr(b, "enclosure", "type");
    let image = ((!encType || /^image\//i.test(encType)) ? xmlAttr(b, "enclosure", "url") : "") || xmlAttr(b, "media:thumbnail", "url") || xmlAttr(b, "media:content", "url");
    if (!image) { const mi = xmlDecode(descRaw + " " + fullRaw).match(/<img[^>]+src=["']([^"']+)["']/i); if (mi) image = mi[1]; }
    try { if (image) image = new URL(image, link).toString(); } catch { image = ""; }
    let d = new Date(dateRaw);
    if (isNaN(d) || d.getTime() > Date.now()) d = new Date();
    return { title, link, desc, full, image, date: d.toISOString() };
  }).filter(x => x.title && x.link && artIsArticleLink(x.link));
}
// آیا متن خبر همان خلاصه است؟ (برای خبرهای قدیمیِ RSS که خلاصه در متن هم کپی شده بود)
// مقایسه بدون توجه به فاصلهها و نیمفاصله انجام میشود.
function bodyIsSummary(body, summary) {
  const norm = t => String(t || "").replace(/[\s\u200c\u200e\u200f]+/g, " ").trim();
  const b = norm(body), s = norm(summary);
  if (!b || !s) return false;
  if (b === s) return true;
  const head = s.slice(0, Math.min(60, s.length)).trim();
  return head.length >= 30 && b.startsWith(head) && b.length <= s.length + 200;
}

// آیا این لینک، صفحه‌ی یک خبر است؟ (نه تصویر، فایل، تگ یا صفحه‌ی اصلی)
function artIsArticleLink(u) {
  let p;
  try { p = new URL(String(u || "")); } catch (e) { return false; }
  if (!/^https?:$/.test(p.protocol)) return false;
  if (/\.(jpe?g|png|gif|webp|svg|bmp|ico|mp4|mp3|m4a|wav|zip|rar|pdf|apk|woff2?|ttf)$/i.test(p.pathname)) return false;
  if (/\/(rss|feed|feeds|tag|tags|author|about|contact|search|archive|photo|gallery)(\/|$)/i.test(p.pathname)) return false;
  return p.pathname.replace(/\/+$/, "").length > 1 || !!p.search;
}

// =====================================================================
// متن کامل خبر — روش دستی (بدون استخراج خودکار)
// =====================================================================
// استخراج خودکار حذف شد: سایتهای منبع، درخواستِ Worker را با صفحه‌ی
// «در حال انتقال» (کد ۲۰۰) یا ۴۰۳ میبندند، پس نتیجهاش یا خلاصه‌ی فید بود
// یا صفحه‌ی محافظ. الان:
//   • تیتر، خلاصه و (اگر خود فید داشته باشد) متن خبر از فید RSS ذخیره میشود،
//   • در ویرایش خبر دکمه‌ی «باز کردن صفحه‌ی منبع» هست؛ صفحه‌ی خبر در تب تازه
//     باز میشود (از مسیر /admin/source/<id> که مستقیم به منبع ریدایرکت میکند)،
//   • ادمین متن را از صفحه کپی میکند و با دکمه‌ی «📋 چسباندن متن»
//     (یا Ctrl+V معمولی) در ویرایشگر میگذارد.
const ART_MAX_TEXT = 30000;     // سقف متن ذخیرهشده‌ی خبر
const THIN_BODY = 700;          // متنی کوتاهتر از این = «متن کامل ندارد»

// =====================================================================
// گرفتن متن کامل خبر از صفحه‌ی منبع — فقط برای منابع تعیینشده (feeds.fetch_full)
// =====================================================================
// چرا «سالم»: قبل از هر درخواست دامنه با دامنه‌ی فید همان منبع مقایسه میشود،
// آدرسهای IP/خصوصی/local مسدوداند، ریدایرکتها دستی و پرشبهپرش اعتبارسنجی
// میشوند (جلوی SSRF)، تایماوت و سقف حجم و بررسی Content-Type داریم، صفحههای
// «در حال انتقال / چک مرورگر / ۴۰۳ / کپچا» تشخیص داده میشوند، متن فقط از
// پاراگرافها و تیترهای ناحیه‌ی مقاله استخراج میشود و آخرکار از نظر طول،
// فارسیبودن و «همان خلاصه نبودن» اعتبارسنجی میشود. اگر هر مرحلهای شکست خورد،
// متن خالی میماند تا روش دستی (کپی از صفحه‌ی منبع) سر جایش باشد.
// نکته‌ی حقوقی: فقط منابعی را روشن کن که شرایط استفاده و حقوق نشرشان اجازه میدهد.
const FULL_MAX_BYTES = 900000;
const FULL_MIN_CHARS = THIN_BODY;   // کمتر از این «متن کامل» محسوب نمیشود
const FULL_MAX_PER_RUN = 5;         // حداکثر صفحهای که در هر اجرای فید خوانده میشود
const FULL_UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36";

function hostBase(h) {
  h = String(h || "").toLowerCase().replace(/\.$/, "").replace(/^www\./, "");
  const p = h.split(".");
  if (p.length <= 2) return h;
  const tld = p[p.length - 1], sld = p[p.length - 2];
  if (tld.length === 2 && ["co", "ac", "org", "net", "gov", "edu", "com", "sch", "id"].includes(sld)) return p.slice(-3).join(".");
  return p.slice(-2).join(".");
}
function blockedHost(h) {
  h = String(h || "").toLowerCase();
  if (!h || h === "localhost") return true;
  if (/\.(local|internal|test|invalid|example)$/.test(h)) return true;
  if (/^(\d{1,3}\.){3}\d{1,3}$/.test(h) || h.includes(":")) return true; // IP و IPv6
  if (/^(localhost|127\.|0\.|10\.|192\.168\.|169\.254\.|172\.(1[6-9]|2\d|3[01])\.)/.test(h)) return true;
  return false;
}
function fullHostOk(u, feedUrl) {
  if (u.protocol !== "https:" && u.protocol !== "http:") return false;
  const h = u.hostname.toLowerCase().replace(/\.$/, "");
  if (blockedHost(h)) return false;
  let b; try { b = new URL(feedUrl); } catch (e) { return false; }
  if (blockedHost(b.hostname)) return false;
  const base = hostBase(b.hostname);
  if (!base) return false;
  const a = hostBase(h);
  return a === base || h === base || h.endsWith("." + base);
}
// منبع فعالی که دامنهاش با لینک خبر همخوان است (برای درخواست دستی «گرفتن متن»)
async function fullFeedFor(env, sourceUrl) {
  let u; try { u = new URL(String(sourceUrl || "")); } catch (e) { return ""; }
  let rows = [];
  try { rows = (await env.DB.prepare("SELECT url FROM feeds WHERE enabled=1 LIMIT 20").all()).results || []; } catch (e) { }
  for (const f of rows) { try { if (fullHostOk(u, f.url)) return f.url; } catch (e) { } }
  return "";
}
function looksLikeChallenge(html) {
  const h = String(html || "");
  if (h.length < 900) return true;
  const title = (h.match(/<title[^>]*>([\s\S]*?)<\/title>/i) || [, ""])[1];
  const bad = /در\s*حال\s*انتقال|در\s*حال\s*بررسی|در\s*حال\s*بارگذاری|لطف(?:اً|a)\s*(?:صبر|کمی صبر)|چند\s*لحظه|Checking your browser|Just a moment|Please wait|Verifying you are human|Enable JavaScript|Attention Required|Access Denied|403 Forbidden|captcha|cf-chl|challenge-platform/i;
  if (bad.test(title)) return true;
  if (h.length < 7000 && bad.test(h)) return true;
  if (!/<(p|div|article|section|h[1-6])\b/i.test(h)) return true;
  return false;
}
async function safeFetchHtml(rawUrl, feedUrl) {
  let url = String(rawUrl || "");
  for (let hop = 0; hop < 4; hop++) {
    let u; try { u = new URL(url); } catch (e) { return { err: "آدرس خبر نامعتبر" }; }
    if (!fullHostOk(u, feedUrl)) return { err: "دامنه‌ی خبر با منبع همخوان نیست" };
    let r;
    try {
      r = await fetch(u.toString(), {
        headers: { "User-Agent": FULL_UA, "Accept": "text/html,application/xhtml+xml;q=0.9,*/*;q=0.4", "Accept-Language": "fa,en;q=0.8" },
        redirect: "manual",
        signal: AbortSignal.timeout(10000)
      });
    } catch (e) { return { err: "اتصال ناموفق / تایماوت" }; }
    if (r.status >= 300 && r.status < 400) {
      const loc = r.headers.get("Location");
      if (!loc) return { err: "ریدایرکت بدون مقصد" };
      try { url = new URL(loc, u).toString(); } catch (e) { return { err: "ریدایرکت نامعتبر" }; }
      continue;
    }
    if (!r.ok) return { err: "پاسخ " + r.status };
    const ct = String(r.headers.get("Content-Type") || "").toLowerCase();
    if (ct && !/text\/html|application\/xhtml\+xml/.test(ct)) return { err: "صفحه HTML نیست" };
    if (Number(r.headers.get("Content-Length") || 0) > FULL_MAX_BYTES) return { err: "حجم صفحه زیاد" };
    let html;
    try { html = await r.text(); } catch (e) { return { err: "خواندن صفحه ناموفق" }; }
    if (html.length > FULL_MAX_BYTES) html = html.slice(0, FULL_MAX_BYTES);
    if (looksLikeChallenge(html)) return { err: "صفحه‌ی محافظ / در حال انتقال" };
    return { html };
  }
  return { err: "ریدایرکتهای زیاد" };
}
function fullClean(s) {
  return xmlDecode(String(s || ""))
    .replace(/<br\s*\/?>/gi, "\n")
    .replace(/<[^>]+>/g, "")
    .replace(/\u00a0/g, " ")
    .replace(/[ \t]+/g, " ")
    .split("\n").map(x => x.trim()).filter(Boolean).join("\n")
    .trim();
}
const FULL_SKIP_RE = /^(?:بیشتر\s*بخوانید|ادامه\s*(?:مطلب|خبر|متن)|منبع\s*:|کد\s*خبر|ارسال\s*نظر|نظر(?:ات|ها)|برچسب\s*ها|اشتراک|کپی\s*شد|تبلیغات|آخرین\s*اخبار|خبر(?:ها|های)\s*مرتبط|مطالب\s*مرتبط|پربازدید(?:ترین|ها)?|لینک\s*کوتاه|تماس\s*با\s*ما|درباره\s*ما|صفحه\s*اصلی|همه\s*حقوق|©)/i;
function fullParagraphs(region) {
  const out = [];
  const re = /<(p|h2|h3|h4|blockquote|li)\b[^>]*>([\s\S]*?)<\/\1>/gi;
  let m;
  while ((m = re.exec(region))) {
    const tag = m[1].toLowerCase();
    let txt = fullClean(m[2]);
    if (!txt) continue;
    if (tag === "h2" || tag === "h3" || tag === "h4") txt = "## " + txt;
    else if (tag === "blockquote") txt = "> " + txt;
    else if (tag === "li") txt = "- " + txt;
    out.push(txt);
  }
  return out;
}
function normalizeFullText(text) {
  const seen = new Set();
  const keep = [];
  for (const raw of String(text || "").split(/\n{2,}/)) {
    const p = String(raw).trim();
    if (!p) continue;
    const core = p.replace(/^(?:## |> |- )\s*/, "").trim();
    const isHead = /^## /.test(p);
    if (core.length < 25 && !isHead) continue;
    if (core.length < 110 && FULL_SKIP_RE.test(core)) continue;
    if (core.length < 130 && /https?:\/\/\S+/.test(core)) continue;
    if (core.length < 80 && !/[\u0600-\u06FF]/.test(core)) continue;
    // فقط تکرار دقیق حذف میشود (پاراگرافهای مشابه ولی متفاوت نگه داشته میشوند)
    const key = core;
    if (seen.has(key)) continue;
    seen.add(key);
    keep.push(p);
  }
  const out = keep.join("\n\n").trim();
  const fa = (out.match(/[\u0600-\u06FF]/g) || []).length;
  if (!out || fa < out.length * 0.22) return "";
  return out.slice(0, ART_MAX_TEXT);
}
function extractArticleText(html) {
  const h = String(html || "");
  // ۱) JSON-LD articleBody (تمیزترین حالت)
  const jl = h.match(/"articleBody"\s*:\s*"((?:\\.|[^"\\])*)"/i);
  if (jl && jl[1]) {
    let s = jl[1];
    try { s = JSON.parse('"' + jl[1] + '"'); } catch (e) { }
    const t = normalizeFullText(fullClean(s));
    if (t.length >= FULL_MIN_CHARS) return t;
  }
  // ۲) ناحیه‌ی مقاله: <article>، وگرنه div/section رایج متن خبر
  const clean = h
    .replace(/<!--[\s\S]*?-->/g, "")
    .replace(/<(script|style|noscript|iframe|svg|nav|header|footer|form|aside|select|option|button|template)\b[^>]*>[\s\S]*?<\/\1>/gi, "")
    .replace(/<(script|style|noscript|iframe|svg|nav|header|footer|form|aside|select|option|button|template)\b[^>]*\/?>/gi, "");
  let region = clean;
  const arts = [...clean.matchAll(/<article\b[^>]*>([\s\S]*?)<\/article>/gi)].map(x => x[1]);
  if (arts.length) region = arts.sort((a, b) => b.length - a.length)[0];
  else {
    const cm = clean.match(/<(?:div|section)\b[^>]*(?:itemprop=["']articleBody["']|class=["'][^"']*(?:article[-_ ]?(?:body|content|text)|news[-_ ]?(?:body|text|content)|post[-_ ]?content|entry[-_ ]?content|story[-_ ]?body|detail[-_ ]?(?:body|text)|matn|body[-_ ]?text)[^"']*["'])[^>]*>([\s\S]*?)<\/(?:div|section)>/i);
    if (cm && cm[1]) region = cm[1];
  }
  let paras = fullParagraphs(region);
  if (paras.join("").length < FULL_MIN_CHARS && region !== clean) paras = fullParagraphs(clean);
  return normalizeFullText(paras.join("\n\n"));
}
// خروجی: { body } یا { err }. هیچوقت خلاصه را بهعنوان متن کامل برنمیگرداند.
async function fetchFullArticle(articleUrl, feedUrl, summary) {
  if (!artIsArticleLink(articleUrl)) return { err: "لینک خبر معتبر نیست" };
  const page = await safeFetchHtml(articleUrl, feedUrl);
  if (!page.html) return { err: page.err || "دریافت ناموفق" };
  const body = extractArticleText(page.html);
  const sum = String(summary || "").trim();
  if (!body || body.length < FULL_MIN_CHARS) return { err: "متن کافی در صفحه پیدا نشد" };
  if (sum && body.length < sum.length + 150) return { err: "متن همان خلاصه است" };
  if (bodyIsSummary(body, sum)) return { err: "متن همان خلاصه است" };
  return { body };
}

// دریافت عکس خبر RSS. در صورت شکست، { err } برمیگرداند تا دلیلش در وضعیت منبع نمایش داده شود.
async function fetchFeedImage(url, referer) {
  let u; try { u = new URL(url); } catch { return { err: "آدرس عکس نامعتبر" }; }
  if (u.protocol !== "https:" && u.protocol !== "http:") return { err: "آدرس عکس نامعتبر" };
  const headers = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36",
    "Accept": "image/webp,image/jpeg,image/png,image/*;q=0.8,*/*;q=0.5",
    "Accept-Language": "fa,en;q=0.8"
  };
  if (referer) headers["Referer"] = referer;
  // اول با کوچکسازی کلودفلر (اگر روی دامنه فعال باشد)، بعد عکس اصلی
  const attempts = [{ cf: { image: { width: 1200, quality: 80, format: "webp", fit: "scale-down" } } }, {}];
  let lastErr = "";
  for (const extra of attempts) {
    try {
      const r = await fetch(u.toString(), { headers, redirect: "follow", signal: AbortSignal.timeout(8000), ...extra });
      if (!r.ok) { lastErr = "پاسخ " + r.status; continue; }
      if (Number(r.headers.get("Content-Length") || 0) > 4 * MAX_IMAGE_BYTES) { lastErr = "حجم زیاد"; continue; }
      const buf = await r.arrayBuffer();
      if (buf.byteLength > MAX_IMAGE_BYTES) { lastErr = "حجم بیش از ۱ مگابایت"; continue; }
      const t = sniffImage(buf);
      if (!t) { lastErr = "فرمت پشتیبانینشده"; continue; }
      return { buf, t };
    } catch (e) { lastErr = "اتصال ناموفق"; }
  }
  return { err: lastErr || "نامشخص" };
}
async function runFeed(env, f) {
  await ensureFeedsSchema(env); // ستون «ارسال به کانال» باید وجود داشته باشد
  const started = nowIso();
  await env.DB.prepare("UPDATE feeds SET last_run=? WHERE id=?").bind(started, f.id).run();
  let status = "", deferred = 0, added = 0, thinCount = 0;
  try {
    const r = await fetch(f.url, {
      headers: { "User-Agent": "Mozilla/5.0 (compatible; KhuzKhabarBot/1.0)", "Accept": "application/rss+xml, application/atom+xml, application/xml, text/xml, */*" },
      redirect: "follow",
      signal: AbortSignal.timeout(15000)
    });
    if (!r.ok) throw new Error("پاسخ سایت منبع: " + r.status);
    let xml = await r.text();
    if (xml.length > 1500000) xml = xml.slice(0, 1500000);
    const items = parseFeed(xml).filter(x => x.title.length >= 5 && x.title.length <= 180 && /^https?:\/\//i.test(x.link));
    if (!items.length) throw new Error("خبری در این فید پیدا نشد (لینک RSS را بررسی کن)");
    const links = items.map(x => x.link);
    const ex = await env.DB.prepare(`SELECT source_url FROM news WHERE source_url IN (${links.map(() => "?").join(",")})`).bind(...links).all();
    // لینک خبرهای RSS که قبلاً حذف شدهاند دوباره وارد نمیشوند
    let skipped = [];
    try {
      const sk = await env.DB.prepare(`SELECT url FROM feed_skip WHERE url IN (${links.map(() => "?").join(",")})`).bind(...links).all();
      skipped = (sk.results || []).map(x => x.url);
    } catch (e) { }
    const have = new Set([...(ex.results || []).map(x => x.source_url), ...skipped]);
    const max = Math.max(1, Math.min(10, Number(f.max_items) || 5));
    const fresh = items.filter(x => !have.has(x.link)).slice(0, max);
    let cats = tagList(f.categories).filter(x => CATEGORIES.includes(x));
    if (!cats.length) cats = ["استانی"];
    const st = f.auto_publish ? "published" : "draft";
    const wantImages = !!f.import_images;
    const wantFull = !!f.fetch_full;

    const stmts = [];
    let imgTry = 0, imgOk = 0, imgNone = 0, imgErr = "";
    let shortCount = 0, fullTry = 0, fullOk = 0, fullErr = "";

    // متن کامل فقط وقتی از فید برداشته میشود که فید واقعاً «متن کامل» داشته باشد
    // (content:encoded). خلاصه هیچوقت داخل متن نمیرود؛ خلاصه فقط جای خودش است.
    const bodyFromFeed = x => {
      const full = String(x.full || "").trim();
      const desc = String(x.desc || "").trim();
      if (!full) return "";
      // فیدی که همان خلاصه را دوباره در content:encoded تکرار میکند، متن کامل ندارد
      if (full.length < desc.length + 120) return "";
      if (full.length < 200) return "";
      const paras = full.split(/\n{2,}/).map(p => p.trim()).filter(Boolean).join("\n\n");
      return paras.slice(0, ART_MAX_TEXT);
    };

    // ساختن رکوردها: تیتر و خلاصه از فید؛ متن کامل فقط اگر فید جدا داشته باشد
    const made = []; // خبرهای تازه برای ارسال به کانال
    for (const x of fresh) {
      let body = bodyFromFeed(x);
      if (body.length > ART_MAX_TEXT) body = body.slice(0, ART_MAX_TEXT);

      const flat = x.desc.replace(/\s+/g, " ").trim();
      let summary = flat;
      if (flat.length > 280) { const cut = flat.slice(0, 280); const sp = cut.lastIndexOf(" "); summary = (sp > 180 ? cut.slice(0, sp) : cut) + "…"; }

      // متن کامل فقط برای منابعی که صراحتاً روشن شدهاند، از صفحه‌ی همان منبع گرفته میشود.
      // اگر صفحه محافظ / ۴۰۳ / «در حال انتقال» باشد یا متن معتبری پیدا نشود،
      // متن خالی میماند تا روش دستی (کپی از صفحه‌ی منبع) همچنان در دسترس باشد.
      if (body.length < THIN_BODY && wantFull && fullTry < FULL_MAX_PER_RUN) {
        fullTry++;
        try {
          const got = await fetchFullArticle(x.link, f.url, summary);
          if (got && got.body) { body = got.body; fullOk++; }
          else if (got && got.err) fullErr = got.err;
        } catch (e) { fullErr = "خطای نامشخص"; console.error("full text failed", x.link, e); }
      }

      if (body.length < THIN_BODY) shortCount++;

      const imgUrl = x.image || "";
      let image_key = "";
      if (wantImages && imgUrl) {
        imgTry++;
        try {
          const im = await fetchFeedImage(imgUrl, x.link);
          if (im && im.buf) { image_key = `${crypto.randomUUID()}.${im.t.ext}`; await putImage(env, image_key, im.buf, im.t.mime); imgOk++; }
          else if (im && im.err) imgErr = im.err;
        } catch (e) { image_key = ""; imgErr = "ذخیره‌ی عکس ناموفق"; }
      } else if (wantImages && !imgUrl) { imgNone++; }

      // خلاصه فقط در فیلد summary میماند. اگر فید متن کامل نداشت، متن خالی میماند
      // تا متن اصلی را خودت از صفحه‌ی منبع بچسبانی.
      // تنها استثنا: منبعی که روی «انتشار خودکار» است، چون خبر بدون متن منتشر نمیشود.
      if (!body && f.auto_publish) body = summary || x.title;
      const now = nowIso();
      // نویسنده و نام منبع خالی ذخیره میشوند؛ source_url فقط برای جلوگیری از ورود دوباره‌ی همان خبر نگه داشته میشود
      const nid = newId();
      stmts.push(env.DB.prepare(
        "INSERT INTO news (id,title,summary,body,category,categories,image_key,image_position,body_images,status,author,featured,views,created_at,updated_at,published_at,thumb,tags,source_url,source_name) VALUES (?,?,?,?,?,?,?, 'after_title','[]',?,'',0,0,?,?,?,'','',?,'')"
      ).bind(nid, x.title, summary, body, cats[0], "," + cats.join(",") + ",", image_key, st, now, now, x.date, x.link));
      made.push({ id: nid, title: x.title, summary, image_key });
    }
    if (stmts.length) await env.DB.batch(stmts);

    // ارسال به کانال تلگرام: فقط وقتی منبع «انتشار خودکار» و «ارسال به کانال» هر دو روشن باشند
    let posted = 0;
    if (f.auto_publish && f.to_channel && made.length) {
      const site = (env.SITE_URL || "").replace(/\/+$/, "");
      for (const it of made.slice(0, 3)) {
        try { await postToChannel(env, it, site); posted++; }
        catch (e) { console.error("feed channel post failed", e); }
      }
    }

    const n = fresh.length;
    added = n; thinCount = shortCount;
    if (n) {
      status = `${n} خبر جدید (${f.auto_publish ? "منتشر شد" : "پیشنویس"})`;
      if (shortCount) status += ` — ${shortCount} خبر متن کامل ندارد؛ از دکمه‌ی «صفحه‌ی منبع» در ویرایش خبر، متن را کپی و بچسبان`;
      if (wantImages) {
        status += ` — عکس: ${imgOk} از ${n}` + (imgNone ? `، ${imgNone} خبر بدون عکس` : "") + (imgErr && imgOk < imgTry ? `، دلیل: ${imgErr}` : "");
      }
      if (wantFull) {
        status += ` — متن کامل: ${fullOk} از ${Math.min(n, FULL_MAX_PER_RUN)}` +
          (fullErr && fullOk < fullTry ? `، دلیل: ${fullErr}` : "");
      }
      if (posted) status += ` — ${posted} خبر به کانال تلگرام رفت`;
    } else {
      status = "خبر جدیدی نبود";
    }
  } catch (e) {
    console.error("feed failed", f.url, e);
    status = "خطا: " + String(e && e.message || e).slice(0, 150);
  }
  try { await env.DB.prepare("UPDATE feeds SET last_status=? WHERE id=?").bind(status, f.id).run(); } catch (e) { }
  return { status, more: deferred > 0, n: added, thin: thinCount };
}
// هر بار فقط قدیمیترین منبعِ اجراشده پردازش میشود تا روی پلن رایگان فشار نیاید
async function runDueFeed(env) {
  try {
    const f = await env.DB.prepare("SELECT * FROM feeds WHERE enabled=1 ORDER BY last_run ASC LIMIT 1").first();
    if (!f) return;
    const r = await runFeed(env, f);
    // اگر خبر تازهای آمده، به مدیر در تلگرام خبر بده
    if (r && r.n > 0 && env.ADMIN_TELEGRAM_ID) await notifyFeedResult(env, env.ADMIN_TELEGRAM_ID, f, r);
  } catch (e) { console.error("scheduled feed failed", e); }
}

// ------------------------------ API پنل مدیریت ------------------------------
async function handleAdmin(request, env, url, ctx) {
  const path = url.pathname.replace(/\/+$/, "") || "/";
  const method = request.method;

  if (path === "/admin" && method === "GET") {
    return htmlResponse(ADMIN_HTML.replace("__CATS__", JSON.stringify(CATEGORIES)), 200, {
      "Cache-Control": "no-store", "X-Robots-Tag": "noindex, nofollow",
      "Content-Security-Policy": "default-src 'none'; img-src 'self' data: blob:; style-src 'unsafe-inline'; script-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    });
  }
  // ---- هدایت مستقیم به صفحه‌ی منبع خبر (دکمه‌ی «باز کردن صفحه‌ی منبع») ----
  // این آدرس را در تب تازه باز کن؛ بلافاصله به خودِ خبر در سایت منبع میرود
  // تا متن کامل را از آنجا کپی کنی. نیاز به ورود مدیر دارد.
  if (path.startsWith("/admin/source/") && method === "GET") {
    const id = decodeURIComponent(path.slice("/admin/source/".length));
    if (!(await isAdmin(request, env))) return Response.redirect(url.origin + "/admin", 302);
    let target = "";
    try {
      const row = await env.DB.prepare("SELECT source_url FROM news WHERE id=?").bind(id).first();
      target = row && String(row.source_url || "");
    } catch (e) { }
    if (!target || !/^https?:\/\//i.test(target)) {
      return htmlResponse('<!doctype html><html lang="fa" dir="rtl"><meta charset="utf-8"><title>منبعی ندارد</title><body style="font-family:Tahoma,sans-serif;padding:40px;text-align:center;line-height:2"><p>این خبر صفحه‌ی منبع ندارد (خبر دستی است).</p><p><a href="/admin">بازگشت به پنل</a></p></body></html>', 404);
    }
    return new Response(null, {
      status: 302,
      headers: { Location: target, "Cache-Control": "no-store", "Referrer-Policy": "no-referrer" }
    });
  }

  if (!path.startsWith("/admin/api/")) return new Response("Not found", { status: 404 });
  const route = path.slice("/admin/api".length);

  if (method !== "GET" && !sameOrigin(request, url)) return json({ error: "درخواست نامعتبر است." }, 403);

  if (route === "/login" && method === "POST") return adminLogin(request, env);
  if (route === "/me") return json({ authenticated: await isAdmin(request, env) });
  if (route === "/logout" && method === "POST") {
    return json({ ok: true }, 200, { "Set-Cookie": "kk_session=; HttpOnly; Secure; SameSite=Strict; Path=/; Max-Age=0" });
  }
  if (!(await isAdmin(request, env))) return json({ error: "برای ادامه وارد شوید." }, 401);

  if (route === "/stats" && method === "GET") return adminStats(env);

  if (route === "/gallery" && method === "GET") {
    const r = await env.DB.prepare("SELECT id,title,image_key,created_at FROM gallery ORDER BY created_at DESC LIMIT 50").all();
    return json({ items: r.results || [] });
  }
  if (route === "/gallery" && method === "POST") {
    let b; try { b = await request.json(); } catch { return json({ error: "درخواست نامعتبر است." }, 400); }
    const title = String(b.title || "").trim().slice(0, 100);
    const key = String(b.image_key || "");
    if (!title || !key || !KEY_RE.test(key) || !(await imageExists(env, key))) return json({ error: "اطلاعات گالری نامعتبر است." }, 400);
    await env.DB.prepare("INSERT INTO gallery (id,title,image_key,created_at) VALUES (?,?,?,?)").bind(newId(), title, key, nowIso()).run();
    return json({ ok: true });
  }
  const galMatch = route.match(/^\/gallery\/([a-zA-Z0-9-]+)$/);
  if (galMatch && method === "DELETE") {
    const id = galMatch[1];
    const g = await env.DB.prepare("SELECT image_key FROM gallery WHERE id=?").bind(id).first();
    if (g) { await env.DB.prepare("DELETE FROM gallery WHERE id=?").bind(id).run(); await cleanupImage(env, g.image_key); }
    return json({ ok: true });
  }

  // ---- ویدیوها (با پوستر ذخیرهشده) ----
  if (route === "/videos" && method === "GET") {
    const r = await env.DB.prepare("SELECT id,title,provider,video_id,poster_key,created_at FROM videos ORDER BY created_at DESC LIMIT 100").all();
    return json({ items: r.results || [] });
  }
  if (route === "/videos" && method === "POST") {
    let b; try { b = await request.json(); } catch { return json({ error: "درخواست نامعتبر است." }, 400); }
    const title = String(b.title || "").trim().slice(0, 150);
    const pv = parseVideoUrl(b.url);
    if (title.length < 3) return json({ error: "عنوان ویدیو حداقل ۳ نویسه باشد." }, 400);
    if (!pv) return json({ error: "لینک معتبر آپارات یا یوتیوب وارد کن." }, 400);
    let poster_key = String(b.poster_key || "");
    if (poster_key && (!KEY_RE.test(poster_key) || !(await imageExists(env, poster_key)))) poster_key = "";
    if (!poster_key) {
      try { poster_key = await storeRemoteThumb(env, pv.provider, pv.video_id); }
      catch (e) { console.error("poster fetch failed", e); }
    }
    await env.DB.prepare("INSERT INTO videos (id,title,provider,video_id,poster_key,created_at) VALUES (?,?,?,?,?,?)")
      .bind(newId(), title, pv.provider, pv.video_id, poster_key || "", nowIso()).run();
    return json({ ok: true, poster: !!poster_key });
  }
  const vidMatch = route.match(/^\/videos\/([a-zA-Z0-9-]+)$/);
  if (vidMatch && method === "PATCH") {
    let b; try { b = await request.json(); } catch { return json({ error: "درخواست نامعتبر است." }, 400); }
    const v = await env.DB.prepare("SELECT provider,video_id,poster_key FROM videos WHERE id=?").bind(vidMatch[1]).first();
    if (!v) return json({ error: "ویدیو پیدا نشد." }, 404);
    let nk = "";
    if (b.refetch) {
      try { nk = await storeRemoteThumb(env, v.provider, v.video_id); } catch (e) { console.error("refetch failed", e); }
      if (!nk) return json({ error: "گرفتن خودکار پوستر ممکن نشد؛ دستی عکس آپلود کن." }, 502);
    } else {
      nk = String(b.poster_key || "");
      if (!nk || !KEY_RE.test(nk) || !(await imageExists(env, nk))) return json({ error: "عکس پوستر نامعتبر است." }, 400);
    }
    await env.DB.prepare("UPDATE videos SET poster_key=? WHERE id=?").bind(nk, vidMatch[1]).run();
    if (v.poster_key && v.poster_key !== nk) await cleanupImage(env, v.poster_key);
    return json({ ok: true });
  }
  if (vidMatch && method === "DELETE") {
    const v = await env.DB.prepare("SELECT poster_key FROM videos WHERE id=?").bind(vidMatch[1]).first();
    await env.DB.prepare("DELETE FROM videos WHERE id=?").bind(vidMatch[1]).run();
    if (v?.poster_key) await cleanupImage(env, v.poster_key);
    return json({ ok: true });
  }

  // ---- ساخت عکس برای خبرهای ویدیویی قدیمی (چند خبر در هر درخواست) ----
  if (route === "/backfill-thumbs" && method === "POST") {
    let b; try { b = await request.json(); } catch { b = {}; }
    const after = String(b.after || "");
    const r = await env.DB.prepare(
      "SELECT id,body FROM news WHERE (thumb='' OR thumb IS NULL) AND (image_key='' OR image_key IS NULL) AND (body LIKE '%aparat.com%' OR body LIKE '%youtu%') AND id>? ORDER BY id LIMIT 3"
    ).bind(after).all();
    const rows = r.results || [];
    let found = 0;
    for (const x of rows) {
      const th = await computeThumb(env, x.body, null);
      if (th) { await env.DB.prepare("UPDATE news SET thumb=? WHERE id=?").bind(th, x.id).run(); found++; }
    }
    return json({ done: rows.length, found, left: rows.length === 3, last: rows.length ? rows[rows.length - 1].id : after });
  }

  // ---- نشانی ریدایرکت مستقیم به صفحه‌ی منبع (برای دکمه‌ی «صفحه‌ی منبع») ----
  if (route === "/source-url" && method === "GET") {
    const id = String(url.searchParams.get("id") || "");
    const row = await env.DB.prepare("SELECT source_url FROM news WHERE id=?").bind(id).first().catch(() => null);
    const target = row && String(row.source_url || "");
    if (!target || !/^https?:\/\//i.test(target)) return json({ error: "این خبر صفحه‌ی منبع ندارد." }, 404);
    return json({ url: target });
  }

  // ---- پاک کردن فهرست خبرهای RSS حذفشده (تا دوباره قابل دریافت باشند) ----
  if (route === "/feed-skip/clear" && method === "POST") {
    let n = 0;
    try { const r = await env.DB.prepare("DELETE FROM feed_skip").run(); n = Number(r.meta?.changes || 0); } catch (e) { }
    return json({ ok: true, cleared: n });
  }

  // ---- منابع خودکار (RSS) ----
  if (route === "/feeds" && method === "GET") {
    await ensureFeedsSchema(env);
    const r = await env.DB.prepare("SELECT id,name,url,categories,auto_publish,import_images,max_items,enabled,last_run,last_status,to_channel,fetch_full FROM feeds ORDER BY created_at DESC LIMIT 50").all();
    return json({ items: r.results || [] });
  }
  if (route === "/feeds" && method === "POST") {
    let b; try { b = await request.json(); } catch { return json({ error: "درخواست نامعتبر است." }, 400); }
    let fu; try { fu = new URL(String(b.url || "").trim()); } catch { fu = null; }
    if (!fu || (fu.protocol !== "https:" && fu.protocol !== "http:")) return json({ error: "لینک RSS معتبر نیست." }, 400);
    // نام منبع اختیاری است؛ اگر خالی باشد از آدرس سایت ساخته میشود (در سایت نمایش داده نمیشود)
    const name = (String(b.name || "").trim() || fu.hostname.replace(/^www\./, "")).slice(0, 60);
    const cl = [...new Set((Array.isArray(b.categories) ? b.categories : []).map(String).filter(x => CATEGORIES.includes(x)))].slice(0, 6);
    if (!cl.length) return json({ error: "حداقل یک دستهبندی انتخاب کن." }, 400);
    await ensureFeedsSchema(env);
    const cnt = await env.DB.prepare("SELECT COUNT(*) AS n FROM feeds").first();
    if ((cnt?.n || 0) >= 20) return json({ error: "حداکثر ۲۰ منبع." }, 400);
    await env.DB.prepare("INSERT INTO feeds (id,name,url,categories,auto_publish,import_images,max_items,enabled,last_run,last_status,created_at,to_channel,fetch_full) VALUES (?,?,?,?,?,?,?,1,'','',?,?,?)")
      .bind(newId(), name, fu.toString(), "," + cl.join(",") + ",", b.auto_publish ? 1 : 0, b.import_images ? 1 : 0, Math.max(1, Math.min(10, Number(b.max_items) || 5)), nowIso(), b.to_channel ? 1 : 0, b.fetch_full ? 1 : 0).run();
    return json({ ok: true });
  }
  const fdMatch = route.match(/^\/feeds\/([a-zA-Z0-9-]+)(\/run)?$/);
  if (fdMatch) {
    const f = await env.DB.prepare("SELECT * FROM feeds WHERE id=?").bind(fdMatch[1]).first();
    if (!f) return json({ error: "منبع پیدا نشد." }, 404);
    if (fdMatch[2] && method === "POST") {
      const r = await runFeed(env, f);
      return json({ ok: true, status: r.status, more: !!r.more, n: r.n || 0, thin: r.thin || 0 });
    }
    if (method === "PATCH") {
      let b; try { b = await request.json(); } catch { return json({ error: "درخواست نامعتبر است." }, 400); }
      if ("enabled" in b) await env.DB.prepare("UPDATE feeds SET enabled=? WHERE id=?").bind(b.enabled ? 1 : 0, f.id).run();
      if ("auto_publish" in b) await env.DB.prepare("UPDATE feeds SET auto_publish=? WHERE id=?").bind(b.auto_publish ? 1 : 0, f.id).run();
      if ("to_channel" in b) {
        await ensureFeedsSchema(env);
        await env.DB.prepare("UPDATE feeds SET to_channel=? WHERE id=?").bind(b.to_channel ? 1 : 0, f.id).run();
      }
      if ("fetch_full" in b) {
        await ensureFeedsSchema(env);
        await env.DB.prepare("UPDATE feeds SET fetch_full=? WHERE id=?").bind(b.fetch_full ? 1 : 0, f.id).run();
      }
      return json({ ok: true });
    }
    if (method === "DELETE") {
      await env.DB.prepare("DELETE FROM feeds WHERE id=?").bind(f.id).run();
      return json({ ok: true });
    }
  }

  // ---- نوار خبر فوری ----
  if (route === "/urgent" && method === "POST") {
    let b; try { b = await request.json(); } catch { return json({ error: "درخواست نامعتبر است." }, 400); }
    const text = String(b.text || "").trim().slice(0, 200);
    const link = String(b.link || "").trim().slice(0, 300);
    if (link && !/^(https?:\/\/\S+|\/(?!\/)\S*)$/.test(link)) return json({ error: "لینک باید با https:// یا / شروع شود." }, 400);
    const on = b.on && text ? "1" : "0";
    await env.DB.batch([["urgent_text", text], ["urgent_link", link], ["urgent_on", on]].map(([k, v]) =>
      env.DB.prepare("INSERT INTO settings (key,value) VALUES (?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value").bind(k, v)));
    SETTINGS_MEM = { t: 0, v: null };
    ctx.waitUntil(purgeListCaches(url.origin));
    return json({ ok: true, on: on === "1" });
  }

  // ---- لینک پیشنمایش خصوصی برای خبر منتشرنشده ----
  const pvMatch = route.match(/^\/preview-link\/([a-zA-Z0-9-]+)$/);
  if (pvMatch && method === "POST") {
    if (!env.SESSION_SECRET) return json({ error: "SESSION_SECRET تنظیم نشده است." }, 500);
    const n = await env.DB.prepare("SELECT id FROM news WHERE id=?").bind(pvMatch[1]).first();
    if (!n) return json({ error: "خبر پیدا نشد." }, 404);
    const site = (env.SITE_URL || url.origin).replace(/\/+$/, "");
    return json({ url: `${site}/news/${n.id}?preview=${await previewToken(env, n.id)}` });
  }

  if (route === "/telegram/setup" && method === "POST") {
    if (!env.TELEGRAM_BOT_TOKEN || !env.TELEGRAM_WEBHOOK_SECRET) return json({ error: "متغیرهای TELEGRAM_BOT_TOKEN و TELEGRAM_WEBHOOK_SECRET تنظیم نشدهاند." }, 400);
    if (!/^[A-Za-z0-9_-]{1,256}$/.test(env.TELEGRAM_WEBHOOK_SECRET)) return json({ error: "TELEGRAM_WEBHOOK_SECRET نامعتبر است." }, 400);
    const site = (env.SITE_URL || url.origin).replace(/\/+$/, "");
    try {
      await telegramApi(env, "setWebhook", { url: site + "/telegram/webhook", secret_token: env.TELEGRAM_WEBHOOK_SECRET, allowed_updates: ["message", "callback_query"] });
      const info = await telegramApi(env, "getWebhookInfo", {});
      return json({ ok: true, url: info.result?.url || "", last_error: info.result?.last_error_message || "" });
    } catch (e) {
      console.error("setWebhook failed", e);
      return json({ error: "اتصال ناموفق بود. توکن ربات را بررسی کن." }, 502);
    }
  }

  if (route === "/upload" && method === "POST") {
    const len = Number(request.headers.get("Content-Length") || 0);
    if (len > MAX_IMAGE_BYTES + 1024) return json({ error: "حجم عکس بیشتر از ۱ مگابایت است." }, 413);
    const buf = await request.arrayBuffer();
    if (buf.byteLength > MAX_IMAGE_BYTES) return json({ error: "حجم عکس بیشتر از ۱ مگابایت است." }, 413);
    const t = sniffImage(buf);
    if (!t) return json({ error: "فقط عکس JPG، PNG یا WebP مجاز است." }, 415);
    const key = `${crypto.randomUUID()}.${t.ext}`;
    await putImage(env, key, buf, t.mime);
    return json({ key });
  }

  if (route === "/settings") {
    if (method === "GET") return json({ settings: await getSettings(env, true) });
    if (method === "PUT") {
      let b; try { b = await request.json(); } catch { return json({ error: "درخواست نامعتبر است." }, 400); }
      const stmts = [];
      const prevLogo = (await getSettings(env, true)).logo_key;
      for (const k of SETTING_KEYS) {
        const v = String(b[k] ?? "").trim().slice(0, k === "contact_text" ? 2000 : 200);
        if (k === "logo_key" && v && (!KEY_RE.test(v) || !(await imageExists(env, v)))) return json({ error: "لوگو نامعتبر است." }, 400);
        if (k === "contact_email" && v && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) return json({ error: "ایمیل نامعتبر است." }, 400);
        if ((k === "instagram" || k === "telegram") && v && !/^https:\/\/\S+$/.test(v)) return json({ error: "لینک باید با https:// شروع شود." }, 400);
        stmts.push(env.DB.prepare("INSERT INTO settings (key,value) VALUES (?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value").bind(k, v));
      }
      await env.DB.batch(stmts);
      SETTINGS_MEM = { t: 0, v: null };
      const newLogo = String(b.logo_key ?? "").trim();
      if (prevLogo && prevLogo !== newLogo) await cleanupImage(env, prevLogo);
      return json({ ok: true });
    }
  }

  if (route === "/news" && method === "GET") return adminList(env, url);
  if (route === "/news" && method === "POST") {
    let b; try { b = await request.json(); } catch { return json({ error: "درخواست نامعتبر است." }, 400); }
    const p = await parseNews(env, b);
    if (p.error) return json({ error: p.error }, 400);

    if (p.v.featured) {
      const cnt = await env.DB.prepare("SELECT COUNT(*) AS n FROM news WHERE featured=1").first();
      if ((cnt?.n || 0) >= 6) return json({ error: "حداکثر ۶ خبر ویژه." }, 400);
    }

    const v = p.v, id = newId(), now = nowIso();
    const pubAt = v.published_at || now;
    const thumb = v.image_key ? "" : await computeThumb(env, v.body, null);
    await env.DB.prepare(
      "INSERT INTO news (id,title,summary,body,category,image_key,image_position,body_images,status,author,featured,views,created_at,updated_at,published_at,thumb,tags,categories) VALUES (?,?,?,?,?,?,?,?,?,?,?,0,?,?,?,?,?,?)"
    ).bind(id, v.title, v.summary, v.body, v.category, v.image_key, v.image_position, v.body_images, v.status, v.author, v.featured, now, now, pubAt, thumb, v.tags, v.categories).run();
    // ارسال خودکار به کانال تلگرام (فقط وقتی همین الان منتشر میشود)
    if (b.notify && v.status === "published" && pubAt <= now) {
      ctx.waitUntil(postToChannel(env, { id, title: v.title, summary: v.summary, image_key: v.image_key, thumb }, url.origin));
    }
    return json({ id }, 201);
  }

  // ---- حذف گروهی پیشنویسها (فقط پیشنویس حذف میشود، نه خبر منتشرشده) ----
  // باید قبل از مسیر /news/:id بیاید، وگرنه «bulk-delete» بهعنوان id خبر تفسیر میشود.
  if (route === "/news/bulk-delete" && method === "POST") {
    let b; try { b = await request.json(); } catch { return json({ error: "درخواست نامعتبر است." }, 400); }
    let ids;
    if (b.rss_all) {
      const r = await env.DB.prepare("SELECT id FROM news WHERE status='draft' AND COALESCE(source_url,'')!='' LIMIT 50").all();
      ids = (r.results || []).map(x => x.id);
    } else {
      ids = [...new Set((Array.isArray(b.ids) ? b.ids : []).map(String).filter(x => /^[a-zA-Z0-9-]{1,40}$/.test(x)))].slice(0, 50);
    }
    if (!ids.length) return json({ ok: true, deleted: 0, left: false });
    const rows = (await env.DB.prepare(
      `SELECT id,image_key,thumb,body_images,source_url FROM news WHERE status='draft' AND id IN (${ids.map(() => "?").join(",")})`
    ).bind(...ids).all()).results || [];
    if (!rows.length) return json({ ok: true, deleted: 0, left: false });
    const okIds = rows.map(x => x.id);
    // ثبت لینک خبرهای RSS تا دوباره وارد نشوند
    const urls = rows.map(x => x.source_url).filter(Boolean);
    if (urls.length) {
      try { await env.DB.batch(urls.map(u => env.DB.prepare("INSERT OR IGNORE INTO feed_skip (url) VALUES (?)").bind(u))); }
      catch (e) { console.error("feed_skip insert failed", e); }
    }
    await env.DB.prepare(`DELETE FROM news WHERE status='draft' AND id IN (${okIds.map(() => "?").join(",")})`).bind(...okIds).run();
    const keys = [];
    for (const x of rows) {
      if (x.image_key) keys.push(x.image_key);
      const tk = thumbKey(x.thumb); if (tk) keys.push(tk);
      try { for (const bi of JSON.parse(x.body_images || "[]")) if (bi && bi.image_key) keys.push(bi.image_key); } catch (e) { }
    }
    await cleanupImages(env, keys);
    return json({ ok: true, deleted: okIds.length, left: !!b.rss_all && ids.length >= 50 });
  }

  // ---- گرفتن متن کامل خبر از صفحه‌ی منبع (فقط منابع تعیینشده) ----
  // { id } → همان خبر؛ { all:true } → تا ۵ خبر RSS ناقص (ابزار تعمیر)
  if (route === "/news/fetch-full" && method === "POST") {
    let b; try { b = await request.json(); } catch { return json({ error: "درخواست نامعتبر است." }, 400); }
    let rows = [];
    if (b.all) {
      try {
        rows = (await env.DB.prepare(
          "SELECT id,body,summary,source_url FROM news WHERE COALESCE(source_url,'')!='' AND LENGTH(COALESCE(body,''))<? ORDER BY created_at DESC LIMIT 5"
        ).bind(THIN_BODY).all()).results || [];
      } catch (e) { }
    } else {
      const one = await env.DB.prepare("SELECT id,body,summary,source_url FROM news WHERE id=?").bind(String(b.id || "")).first();
      if (one) rows = [one];
    }
    if (!rows.length) return json({ ok: true, done: 0, ok: 0, errors: [], body: "", length: 0 });
    let done = 0, good = 0, lastBody = "", lastLen = 0;
    const errors = [];
    for (const n of rows) {
      done++;
      const cur = String(n.body || "");
      if (cur.length >= THIN_BODY && !bodyIsSummary(cur, n.summary)) continue;
      const feedUrl = await fullFeedFor(env, n.source_url);
      if (!feedUrl) { errors.push("منبع فعالی برای دامنه‌ی این خبر پیدا نشد"); continue; }
      let got;
      try { got = await fetchFullArticle(n.source_url, feedUrl, n.summary); }
      catch (e) { got = { err: "خطای نامشخص" }; }
      if (!got.body) { errors.push(got.err || "دریافت ناموفق"); continue; }
      await env.DB.prepare("UPDATE news SET body=?, updated_at=? WHERE id=?").bind(got.body, nowIso(), n.id).run();
      good++; lastBody = got.body; lastLen = got.body.length;
    }
    return json({ ok: true, done, ok: good, errors: errors.slice(0, 5), body: b.all ? "" : lastBody, length: lastLen });
  }

  const m = route.match(/^\/news\/([a-zA-Z0-9-]+)$/);
  if (m) {
    const id = m[1];
    if (method === "GET") {
      const n = await env.DB.prepare("SELECT * FROM news WHERE id=?").bind(id).first();
      if (!n) return json({ error: "خبر پیدا نشد." }, 404);
      // خبر RSS قدیمی که خلاصهاش داخل متن هم کپی شده بود: متن خالی برمیگردد تا
      // خلاصه فقط در جای خودش دیده شود (با اولین ذخیره، از دیتابیس هم پاک میشود)
      if (String(n.source_url || "") && bodyIsSummary(n.body, n.summary)) n.body = "";
      return json({ news: n });
    }
    const old = await env.DB.prepare("SELECT status,published_at,image_key,featured,body,thumb,source_url FROM news WHERE id=?").bind(id).first();
    if (!old) return json({ error: "خبر پیدا نشد." }, 404);
    let b; if (method !== "DELETE") { try { b = await request.json(); } catch { return json({ error: "درخواست نامعتبر است." }, 400); } }

    if (method === "PUT") {
      const p = await parseNews(env, b);
      if (p.error) return json({ error: p.error }, 400);
      // در خبرهای RSS اگر متن همان خلاصه باشد، ذخیره نمیشود (خلاصه فقط در جای خودش)
      if (String(old.source_url || "") && bodyIsSummary(p.v.body, p.v.summary)) p.v.body = "";

      if (p.v.featured && !old.featured) {
        const cnt = await env.DB.prepare("SELECT COUNT(*) AS n FROM news WHERE featured=1").first();
        if ((cnt?.n || 0) >= 6) return json({ error: "حداکثر ۶ خبر ویژه." }, 400);
      }

      const v = p.v, now = nowIso();
      const pa = v.published_at || (v.status === "published" && old.status !== "published" ? now : old.published_at);
      const thumb = v.image_key ? "" : await computeThumb(env, v.body, old);
      await env.DB.prepare(
        "UPDATE news SET title=?,summary=?,body=?,category=?,image_key=?,image_position=?,body_images=?,status=?,author=?,featured=?,published_at=?,updated_at=?,thumb=?,tags=?,categories=? WHERE id=?"
      ).bind(v.title, v.summary, v.body, v.category, v.image_key, v.image_position, v.body_images, v.status, v.author, v.featured, pa, now, thumb, v.tags, v.categories, id).run();
      if (old.image_key && old.image_key !== v.image_key) await cleanupImage(env, old.image_key);
      if (old.thumb && old.thumb !== thumb) await cleanupImage(env, thumbKey(old.thumb));
      if (b.notify && v.status === "published" && pa <= now) {
        ctx.waitUntil(postToChannel(env, { id, title: v.title, summary: v.summary, image_key: v.image_key, thumb }, url.origin));
      }
      return json({ id });
    }
    if (method === "PATCH") {
      const now = nowIso();
      if ("status" in b) {
        const st = b.status === "draft" ? "draft" : "published";
        await env.DB.prepare("UPDATE news SET status=?, published_at=CASE WHEN ?='published' AND status!='published' THEN ? ELSE published_at END, updated_at=? WHERE id=?")
          .bind(st, st, now, now, id).run();
      }
      if ("featured" in b) {
        const newFeat = b.featured ? 1 : 0;
        if (newFeat && !old.featured) {
          const cnt = await env.DB.prepare("SELECT COUNT(*) AS n FROM news WHERE featured=1").first();
          if ((cnt?.n || 0) >= 6) return json({ error: "حداکثر ۶ خبر ویژه." }, 400);
        }
        await env.DB.prepare("UPDATE news SET featured=?, updated_at=? WHERE id=?").bind(newFeat, now, id).run();
      }
      return json({ ok: true });
    }
    if (method === "DELETE") {
      // خبر RSS حذفشده دوباره وارد نشود
      if (old.source_url) { try { await env.DB.prepare("INSERT OR IGNORE INTO feed_skip (url) VALUES (?)").bind(old.source_url).run(); } catch (e) { } }
      await env.DB.prepare("DELETE FROM news WHERE id=?").bind(id).run();
      await cleanupImage(env, old.image_key);
      if (old.thumb) await cleanupImage(env, thumbKey(old.thumb));
      return json({ ok: true });
    }
  }
  return json({ error: "مسیر پیدا نشد." }, 404);
}

async function adminLogin(request, env) {
  if (!env.ADMIN_USER || !env.ADMIN_PASSWORD || !env.SESSION_SECRET) {
    return json({ error: "متغیرهای ورود تنظیم نشدهاند." }, 500);
  }
  const ip = request.headers.get("CF-Connecting-IP") || "unknown";
  if (!(await loginAllowed(env, ip))) return json({ error: "تلاشهای ناموفق زیاد بود." }, 429);
  let b; try { b = await request.json(); } catch { return json({ error: "درخواست نامعتبر است." }, 400); }
  const okU = await safeEqual(b.username || "", env.ADMIN_USER);
  const okP = await safeEqual(b.password || "", env.ADMIN_PASSWORD);
  if (!(okU && okP)) { await loginFailed(env, ip); return json({ error: "نام کاربری یا رمز عبور اشتباه است." }, 401); }
  await env.DB.prepare("DELETE FROM login_attempts WHERE ip=?").bind(ip).run();
  const exp = Date.now() + SESSION_DAYS * 86400000;
  const token = exp + "." + await hmac(env.SESSION_SECRET, "kk|" + exp);
  return json({ ok: true }, 200, { "Set-Cookie": `kk_session=${token}; HttpOnly; Secure; SameSite=Strict; Path=/; Max-Age=${SESSION_DAYS * 86400}` });
}

async function parseNews(env, b) {
  const title = String(b.title || "").trim();
  const summary = String(b.summary || "").trim();
  const body = String(b.body || "").trim();
  let catList = Array.isArray(b.categories) ? b.categories : (b.category ? [b.category] : []);
  catList = [...new Set(catList.map(x => String(x)).filter(x => CATEGORIES.includes(x)))].slice(0, 6);
  const category = catList[0] || "";
  const categories = catList.length ? "," + catList.join(",") + "," : "";
  const image_key = String(b.image_key || "");
  const image_position = b.image_position === "bottom" ? "bottom" : "after_title";
  // فقط عکسهای میانی معتبر (کلید درست) ذخیره میشوند
  const bi = Array.isArray(b.body_images)
    ? b.body_images
        .filter(x => x && typeof x.image_key === "string" && KEY_RE.test(x.image_key))
        .slice(0, 20)
        .map(x => ({ image_key: x.image_key, caption: String(x.caption || "").trim().slice(0, 200) }))
    : [];
  const body_images = JSON.stringify(bi);

  if (title.length < 5 || title.length > 180) return { error: "تیتر باید بین ۵ تا ۱۸۰ نویسه باشد." };
  if (summary.length > 500) return { error: "خلاصه حداکثر ۵۰۰ نویسه باشد." };
  // پیشنویس میتواند متن نداشته باشد (خبر RSS که متنش را هنوز از منبع کپی نکردهای)
  if (body.length > 50000) return { error: "متن خبر حداکثر ۵۰٬۰۰۰ نویسه باشد." };
  if (b.status === "published" && body.length < 10) return { error: "برای انتشار، متن کامل خبر را بچسبان یا بنویس (حداقل ۱۰ نویسه)." };
  if (!CATEGORIES.includes(category)) return { error: "دستهبندی معتبر نیست." };
  if (image_key && (!KEY_RE.test(image_key) || !(await imageExists(env, image_key)))) return { error: "عکس شاخص معتبر نیست." };

  let published_at = "";
  if (b.published_at) {
    const d = new Date(b.published_at);
    if (isNaN(d)) return { error: "تاریخ انتشار معتبر نیست." };
    published_at = d.toISOString();
  }
  return { v: { title, summary, body, category, image_key, image_position, body_images, published_at, status: b.status === "draft" ? "draft" : "published", author: String(b.author || "").trim().slice(0, 60), featured: b.featured ? 1 : 0, tags: normTags(b.tags), categories } };
}

// لیست اخبار پنل مدیریت؛ با فیلتر منبع: source=manual (دستی) یا source=rss (خودکار)
async function adminList(env, url) {
  const page = Math.max(1, Math.min(10000, parseInt(url.searchParams.get("page")) || 1));
  const status = url.searchParams.get("status");
  const source = url.searchParams.get("source");
  const q = (url.searchParams.get("q") || "").trim().slice(0, 60);
  const where = [], binds = [];
  if (status === "published" || status === "draft") { where.push("status=?"); binds.push(status); }
  if (source === "rss") where.push("COALESCE(source_url,'')!=''");
  else if (source === "manual") where.push("COALESCE(source_url,'')=''");
  if (q) { where.push("title LIKE ? ESCAPE '\\'"); binds.push("%" + q.replace(/[\\%_]/g, m => "\\" + m) + "%"); }
  const w = where.length ? "WHERE " + where.join(" AND ") : "";
  const limit = 20;
  const [rows, cnt, tabs] = await env.DB.batch([
    env.DB.prepare(`SELECT id,title,category,status,featured,views,image_key,thumb,published_at,CASE WHEN COALESCE(source_url,'')!='' THEN 1 ELSE 0 END AS rss,LENGTH(COALESCE(body,'')) AS blen FROM news ${w} ORDER BY published_at DESC LIMIT ? OFFSET ?`).bind(...binds, limit, (page - 1) * limit),
    env.DB.prepare(`SELECT COUNT(*) AS n FROM news ${w}`).bind(...binds),
    env.DB.prepare("SELECT COALESCE(SUM(CASE WHEN COALESCE(source_url,'')!='' THEN 1 ELSE 0 END),0) AS rss, COALESCE(SUM(CASE WHEN COALESCE(source_url,'')='' THEN 1 ELSE 0 END),0) AS manual, COALESCE(SUM(CASE WHEN COALESCE(source_url,'')!='' AND status='draft' THEN 1 ELSE 0 END),0) AS rss_drafts, COALESCE(SUM(CASE WHEN COALESCE(source_url,'')!='' AND LENGTH(COALESCE(body,''))<? THEN 1 ELSE 0 END),0) AS thin FROM news").bind(THIN_BODY)
  ]);
  const total = cnt.results?.[0]?.n || 0;
  return json({ items: rows.results || [], total, page, pages: Math.max(1, Math.ceil(total / limit)), now: nowIso(), counts: tabs.results?.[0] || {} });
}

async function adminStats(env) {
  const now = nowIso();
  const [c, top, latest, sched] = await env.DB.batch([
    env.DB.prepare("SELECT status, COUNT(*) AS n, COALESCE(SUM(views),0) AS v FROM news GROUP BY status"),
    env.DB.prepare("SELECT id,title,views FROM news WHERE status='published' ORDER BY views DESC LIMIT 5"),
    env.DB.prepare("SELECT id,title,views FROM news ORDER BY created_at DESC LIMIT 5"),
    env.DB.prepare("SELECT COUNT(*) AS n FROM news WHERE status='published' AND published_at>?").bind(now)
  ]);
  const by = {}; for (const r of c.results || []) by[r.status] = r;
  const scheduled = sched.results?.[0]?.n || 0;
  return json({

function parseVideoUrl(raw) {
  let u; try { u = new URL(String(raw || "").trim()); } catch { return null; }
  if (u.protocol !== "https:" && u.protocol !== "http:") return null;
  const h = u.hostname.toLowerCase().replace(/^(www|m)\./, "");
  let id = "";
  if (h === "youtu.be") id = u.pathname.slice(1).split("/")[0];
  else if (h === "youtube.com" || h === "youtube-nocookie.com") {
    if (u.pathname === "/watch") id = u.searchParams.get("v") || "";
    else { const m = u.pathname.match(/^\/(?:embed|shorts|live|v)\/([A-Za-z0-9_-]{11})/); id = m ? m[1] : ""; }
  }
  if (id && /^[A-Za-z0-9_-]{11}$/.test(id)) return { provider: "youtube", video_id: id };
  if (h === "aparat.com") {
    const m = u.pathname.match(/^\/v\/([A-Za-z0-9]{3,20})/) || u.pathname.match(/\/videohash\/([A-Za-z0-9]{3,20})/);
    if (m) return { provider: "aparat", video_id: m[1] };
  }
  return null;
}
function videoEmbedUrl(v) {
  return v.provider === "youtube"
    ? `https://www.youtube-nocookie.com/embed/${encodeURIComponent(v.video_id)}`
    : `https://www.aparat.com/video/video/embed/videohash/${encodeURIComponent(v.video_id)}/vt/frame`;
}

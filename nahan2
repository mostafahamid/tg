    ? `<ol class="rss-list">${feedRows.map(n => `<li><a href="/news/${esc(n.id)}">${esc(n.title)}</a></li>`).join("")}</ol><a class="btn-rss" href="/rss/news">همه‌ی خبرهای منابع خبری</a>`
